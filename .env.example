# Базовый URL NestJS-бэкенда. Astro-сборка ходит сюда за каталогом врачей.
#
# Значение отсюда сильнее и переменной окружения, и vars в wrangler.jsonc:
# адаптер Cloudflare на старте сборки перекладывает .env прямо в process.env.
# Поэтому `pnpm build` этот файл не читает вовсе — витрина, которая поедет в
# прод, собирается на vars из wrangler.jsonc, и подставить туда локальный адрес
# из .env уже нельзя. Собрать на том, что лежит здесь, — `pnpm build:local`.
#
# На каком адресе собралась витрина, каждая сборка печатает строкой
# `[doctors] каталог берётся с …` — молча собраться не на том больше нельзя.
PUBLIC_API_URL=https://api.sdoctorom.health

# Ключ JS API Яндекс Карт — интерактивная карта места приёма на странице врача.
# Берётся в кабинете разработчика: https://yandex.ru/maps-api/console
# Ключ уезжает в браузер (иначе карту не нарисовать), поэтому ограничивайте его
# списком Referer, а не секретностью. Без ключа страница остаётся рабочей: адрес
# открывается в Яндекс Картах новой вкладкой.
PUBLIC_YANDEX_MAPS_KEY=
