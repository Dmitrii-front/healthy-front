# Базовый URL NestJS-бэкенда. Astro-сборка ходит сюда за каталогом врачей.
PUBLIC_API_URL=https://api.sdoctorom.health

# Ключ JS API Яндекс Карт — интерактивная карта места приёма на странице врача.
# Берётся в кабинете разработчика: https://yandex.ru/maps-api/console
# Ключ уезжает в браузер (иначе карту не нарисовать), поэтому ограничивайте его
# списком Referer, а не секретностью. Без ключа страница остаётся рабочей: адрес
# открывается в Яндекс Картах новой вкладкой.
PUBLIC_YANDEX_MAPS_KEY=
