{
  "name": "healthy-mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "astro check && tsc -b --noEmit",
    "verify": "pnpm fmt:check && pnpm lint && pnpm typecheck",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^13.5.0",
    "@astrojs/mdx": "^5.0.4",
    "@astrojs/react": "^5.0.4",
    "@astrojs/sitemap": "^3.7.2",
    "@hookform/resolvers": "latest",
    "@tanstack/react-query": "^5.100.8",
    "@tanstack/react-query-devtools": "^5.100.8",
    "@tanstack/react-router": "latest",
    "astro": "^6.3.1",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "valibot": "^1.4.0",
    "zod": "^4.4.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@tailwindcss/vite": "^4.2.0",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-plugin": "latest",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.8",
    "vite": "^7.3.3"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm exec oxlint --type-aware && pnpm exec tsc -b --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "oxfmt"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.2",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "simple-git-hooks",
      "workerd"
    ],
    "overrides": {
      "vite": "^7.3.3"
    }
  }
}
