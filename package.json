{
  "name": "healthy-mobile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc -b --noEmit",
    "preview": "vite preview",
    "lint": "oxlint --type-aware",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "typecheck": "tsc -b --noEmit",
    "verify": "pnpm fmt:check && pnpm lint && pnpm typecheck",
    "prepare": "simple-git-hooks"
  },
  "dependencies": {
    "@hookform/resolvers": "latest",
    "@tanstack/react-query": "^5.100.8",
    "@tanstack/react-query-devtools": "^5.100.8",
    "@tanstack/react-router": "latest",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.74.0",
    "zod": "^4.4.2",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.2.0",
    "@tanstack/react-router-devtools": "latest",
    "@tanstack/router-plugin": "latest",
    "@types/node": "^25.2.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "lint-staged": "^16.4.0",
    "oxfmt": "^0.46.0",
    "oxlint": "^1.62.0",
    "oxlint-tsgolint": "^0.22.1",
    "simple-git-hooks": "^2.13.1",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.8",
    "vite": "^8.0.10"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged && pnpm exec oxlint --type-aware && pnpm exec tsc -b --noEmit"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,json,css,md}": "oxfmt"
  },
  "engines": {
    "node": "24.x"
  },
  "packageManager": "pnpm@10.33.2"
}
