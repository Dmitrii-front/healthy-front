---
// Карточка одного места приёма: куда ехать слева, свободное время справа.
//
// Вынесена из doctor/[id].astro не ради размера файла, а ради липкой ленты дат.
// Sticky отпускает элемент на дне СВОЕГО контейнера, поэтому «лента липнет, пока
// листаешь места, и останавливается над последним» — это ровно «лента и все
// карточки, кроме последней, лежат в одном контейнере, а последняя снаружи».
// Двумя вызовами .map() из одного шаблона такое не собрать: обёртка обязана
// закрыться посреди перебора. Отсюда отдельный компонент.
//
// Разметка переехала дословно; сетка времени по-прежнему пустая — её наполняет
// островок на странице, он же читает data-атрибуты.

interface Props {
  place: {
    id: string;
    name: string;
    address: string | null;
    description: string | null;
    coordinates: { lat: number; lng: number } | null;
    mapUrl: string;
    opensInApp: boolean;
  };
}

const { place } = Astro.props;

// Видов приёма здесь больше нет — их приносит островок страницы (см.
// fetchBookingProfile в lib/booking.ts). Отсюда и пустые оболочки ниже:
// комбобокс со списком, который наполнит скрипт, и сетка времени. Разметка
// стоит на месте всегда, чтобы карточка не перестраивалась под ответом; всё,
// что зависит от количества услуг — readonly у поля, порог поиска, показ самой
// секции, — считает тот же островок.
//
// Само место при этом остаётся статикой: название и адрес — локальный SEO
// страницы, они уезжают в JSON-LD (worksFor) и в meta description, и в JS их
// не увидит ни Яндекс, ни скрейпер соцсети. Островок сверяет карточки со
// свежим списком мест только чтобы СНЯТЬ удалённое, но не рисует их.
---

<article
  data-el="place-block"
  data-place-id={place.id}
  class="grid grid-cols-1 gap-6 rounded-[24px] border border-[#edebe6] bg-white p-6 sm:p-7 md:grid-cols-[minmax(0,280px)_1fr] md:gap-8"
>
  {/* Слева — куда ехать и с каким видом приёма, справа — время.
      Вертикально «адрес → тип → сетка времени» растягивало каждую
      карточку на экран, а мест у врача до трёх. */}
  <div class="min-w-0">
    <h3 class="text-[16px] font-bold tracking-[-0.015em] text-[#0f1115]">{place.name}</h3>
    {/* Адрес и вход в карту — одна фраза, а не два объекта. Кнопка
        «На карте» стояла отдельным предметом в столбце, и связь «этот
        контрол про ЭТОТ адрес» пациент достраивал глазами; при трёх
        местах три одинаковые плашки на одной левой кромке складывались
        в ложную колонку навигации. Хвост висит на разной ширине у
        каждого места и такой колонки не образует.

        Прежний довод «описание объясняет тот же адрес, разрывать пару
        контролом нельзя» остаётся в силе, но неразрывная пара — это
        «адрес → как до него доехать». Описание отвечает уже на другой
        вопрос: не «доехать», а «дойти, когда приехал», — поэтому оно
        следующим шагом ниже, а не внутри пары.

        Нажимается вся строка, но покрашен и подчёркнут только хвост:
        слева данные, справа действие. Адрес по-прежнему не выглядит
        контролом, а промах пальцем по нему открывает ровно то, что
        обещано парой сантиметров правее — ни мёртвого тапа, ни
        неожиданного действия, ради чего правило «адрес — данные» и
        писалось.

        Пин стал бирюзовым и остался один: в строке он был данными, в
        кнопке — действием, одна иконка на два смысла в сорока пикселях
        по вертикали. Серый .hm-pin--static остался в шапке врача, где
        строки мест не нажимаются. */}
    <a
      href={place.mapUrl}
      target="_blank"
      rel="noopener noreferrer"
      data-action="hm-map-open"
      data-lat={place.coordinates ? String(place.coordinates.lat) : undefined}
      data-lng={place.coordinates ? String(place.coordinates.lng) : undefined}
      data-name={place.name}
      data-address={place.address}
      {/* data-bookable ставит островок: кнопку записи в шите карты можно
          показывать только тем местам, у которых виды приёма реально есть, а
          знает об этом теперь клиент. */}
      {...(place.opensInApp ? { "aria-haspopup": "dialog" } : {})}
      {/* Метка начинается ровно теми словами, что видны на экране: иначе
          голосовое управление «нажми показать на карте» не попадает в
          контрол (WCAG 2.5.3 Label in Name). Про новую вкладку
          предупреждаем здесь, а не подписью — см. mapsReady. */}
      aria-label={`${place.address || place.name}. Показать на карте${place.opensInApp ? "" : ", откроется в Яндекс Картах в новой вкладке"}`}
      class="hm-addr mt-1"
    >
      <span class="flex items-start gap-1.5 text-[14px] leading-[1.45] text-[#2a2d33]">
        <svg width="14" height="14" viewBox="0 0 24 24" aria-hidden="true" class="hm-pin mt-[3px] shrink-0">
          <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" />
        </svg>
        <span class="min-w-0">
          {place.address}
          {/* «На карте» называло слой. Здесь сказано, что произойдёт по
              нажатию. «Маршрут» и «Как добраться» брать нельзя: шит
              показывает точку, а маршрут не строит — лейбл переобещал бы. */}
          <span class="hm-addr-cue">
            <span class="hm-addr-cue-t">Показать на карте</span>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 5 7 7-7 7" />
            </svg>
          </span>
        </span>
      </span>
    </a>

    {/* Что врач написал о месте: этаж, кабинет, с какой стороны вход.
        Третий шаг после «доехать», отсюда и позиция под парой адреса.
        Превью карты сюда не вернётся: оно занимало 150px и отвечало на
        вопрос «где город», на который адрес уже ответил, а подсказку
        «куда идти, когда доехал» не заменяет ничем. Осталось снаружи
        ссылки: внутри неё скринридер потерял бы текст под aria-label. */}
    {place.description && (
      <p class="mt-2 text-[13px] leading-relaxed text-[#5f636a]">{place.description}</p>
    )}

    {/* Оболочка комбобокса. Скрыта до ответа и остаётся скрытой, если услуга у
        места одна: единственная услуга — не выбор, а факт, и показывать её
        вместе с подписью значит занимать блок сообщением «вариант один». Её
        id и длительность нужны запросу слотов, но живут в памяти островка.
        readonly и aria-autocomplete проставлены по-строгому: пока список пуст,
        печатать в поле нечего, а порог поиска островок включит сам. */}
    <div class="mt-4 border-t border-[#edebe6] pt-4" data-el="type-section" hidden>
      <div
        id={`type-label-${place.id}`}
        class="mb-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#8a8e96]"
      >
        Услуги
      </div>
      <div class="hm-combo" data-el="type-combo">
        <input
          type="text"
          class="hm-combo-input"
          data-el="type-input"
          role="combobox"
          aria-expanded="false"
          aria-controls={`type-listbox-${place.id}`}
          aria-labelledby={`type-label-${place.id}`}
          aria-autocomplete="none"
          autocomplete="off"
          spellcheck="false"
          readonly
          value=""
        />
        <div class="hm-combo-pop" data-el="type-pop" hidden>
          <ul class="hm-combo-list" id={`type-listbox-${place.id}`} data-el="type-list" role="listbox"></ul>
          <p class="hm-combo-empty" data-el="type-empty" hidden>Ничего не найдено</p>
        </div>
      </div>
    </div>
  </div>

  {/* Дату дублируем у каждой сетки намеренно: лента остаётся выше,
      и у третьей карточки на телефоне её уже не видно — время без
      дня читается вслепую. Не суффиксом eyebrow, а жирным ink-
      ярлыком в том же паттерне, что шапка ленты («ДАТА ЗАПИСИ»
      слева — жирный месяц справа): пациент должен быть однозначно
      уверен, на какой день записывается, в момент клика по слоту.
      Цвет ink, не тил — тил на этой странице язык действия.
      flex-wrap + whitespace-nowrap: не влезла — падает на свою
      строку целиком, а не ломается посреди даты.

      Есть ли у места запись вообще, выясняется теперь в рантайме, поэтому
      колонка рендерится всегда. Шапку «Свободное время» островок снимает у мест
      без услуг: подпись над сообщением «записи нет» обещала бы сетку, которой
      не будет. */}
  <div class="min-w-0">
    <div
      data-el="slot-head"
      class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1 border-b border-[#edebe6] pb-3"
    >
      <div class="text-[11px] font-bold uppercase tracking-[0.08em] text-[#8a8e96]">Свободное время</div>
      <div class="whitespace-nowrap text-[13px] font-bold text-[#0f1115]" data-el="slot-day-label"></div>
    </div>

    <div class="mt-4 grid grid-cols-[repeat(auto-fill,minmax(78px,1fr))] gap-2" data-el="slot-grid"></div>
    <p class="hm-empty-day mt-4" data-el="slot-status" hidden></p>
  </div>
</article>
