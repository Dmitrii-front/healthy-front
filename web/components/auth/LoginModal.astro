---
// Single auth modal mounted once per page. Carries login + register +
// forgot-password as panes within the same <dialog>. Multiple
// <LoginButton /> triggers (mobile + desktop header, etc.) share this
// instance.

interface Props {
  /** Where to redirect after a successful login/register. Defaults to SPA shell. */
  returnTo?: string;
}
const { returnTo = "/app/" } = Astro.props;
---

<dialog
  id="hm-login-modal"
  class="hm-dialog"
  aria-label="Вход в Healthy"
  data-locked="false"
  data-mode="login"
  data-pane="auth"
  data-return-to={returnTo}
>
  <div class="hm-modal-body">
    <!-- AUTH PANE (login / register) -->
    <div class="hm-pane" data-pane-el="auth">
      <div class="hm-modal-header">
        <h2 class="hm-modal-title" data-el="title">С возвращением</h2>
        <button type="button" class="hm-icon-btn" data-action="hm-login-close" aria-label="Закрыть">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M3 3L11 11M11 3L3 11" />
          </svg>
        </button>
      </div>
      <p class="hm-modal-subtitle" data-el="subtitle">
        Запишитесь к врачу за минуту.
      </p>

      <div class="hm-tabs" role="tablist">
        <span class="hm-tabs-thumb" aria-hidden="true"></span>
        <button type="button" class="hm-tab-btn" role="tab" aria-selected="true" data-mode="login">
          Войти
        </button>
        <button type="button" class="hm-tab-btn" role="tab" aria-selected="false" data-mode="register">
          Создать аккаунт
        </button>
      </div>

      <form data-el="form" novalidate>
        <label class="hm-label" for="hm-login-email">Email</label>
        <input
          id="hm-login-email"
          class="hm-input"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="you@email.com"
          required
        />
        <p class="hm-field-error" data-el="email-error" hidden></p>

        <label class="hm-label" for="hm-login-password">Пароль</label>
        <input
          id="hm-login-password"
          class="hm-input"
          type="password"
          autocomplete="current-password"
          placeholder="••••••••"
          required
        />
        <p class="hm-field-error" data-el="password-error" hidden></p>

        <div class="hm-password-meter" data-el="password-meter" hidden aria-hidden="true">
          <div class="hm-meter-bar">
            <span class="hm-meter-seg" data-rule="length"></span>
            <span class="hm-meter-seg" data-rule="upper"></span>
            <span class="hm-meter-seg" data-rule="digit"></span>
          </div>
          <ul class="hm-meter-rules">
            <li class="hm-meter-rule" data-rule="length">
              <svg class="hm-meter-icon hm-meter-icon--off" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <circle cx="6" cy="6" r="4.25" />
              </svg>
              <svg class="hm-meter-icon hm-meter-icon--on" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2.5 6.25L5 8.5L9.5 3.75" />
              </svg>
              <span>8+ символов</span>
            </li>
            <li class="hm-meter-rule" data-rule="upper">
              <svg class="hm-meter-icon hm-meter-icon--off" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <circle cx="6" cy="6" r="4.25" />
              </svg>
              <svg class="hm-meter-icon hm-meter-icon--on" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2.5 6.25L5 8.5L9.5 3.75" />
              </svg>
              <span>Заглавная</span>
            </li>
            <li class="hm-meter-rule" data-rule="digit">
              <svg class="hm-meter-icon hm-meter-icon--off" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
                <circle cx="6" cy="6" r="4.25" />
              </svg>
              <svg class="hm-meter-icon hm-meter-icon--on" width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M2.5 6.25L5 8.5L9.5 3.75" />
              </svg>
              <span>Цифра</span>
            </li>
          </ul>
        </div>

        <button type="button" class="hm-forgot" data-action="hm-forgot-open" data-el="forgot">
          Забыли пароль?
        </button>

        <label class="hm-agree" data-el="agree-row" hidden>
          <input type="checkbox" data-el="agree" />
          <span>
            Я принимаю
            <a href="#" target="_blank" rel="noopener">Условия использования</a>
            и
            <a href="#" target="_blank" rel="noopener">Политику конфиденциальности</a>,
            включая согласие на обработку персональных данных.
          </span>
        </label>

        <p class="hm-error" data-el="error" hidden></p>

        <button type="submit" class="hm-btn hm-btn-primary hm-btn-block-spacing" data-el="submit">
          Войти
        </button>
      </form>
    </div>

    <!-- FORGOT-PASSWORD PANE -->
    <div class="hm-pane" data-pane-el="forgot" hidden>
      <div class="hm-modal-header">
        <h2 class="hm-modal-title">Восстановление пароля</h2>
        <button type="button" class="hm-icon-btn" data-action="hm-login-close" aria-label="Закрыть">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M3 3L11 11M11 3L3 11" />
          </svg>
        </button>
      </div>
      <p class="hm-modal-subtitle">
        Введите email от аккаунта — пришлём ссылку, чтобы задать новый пароль.
      </p>

      <form data-el="forgot-form" novalidate>
        <label class="hm-label" for="hm-forgot-email">Email</label>
        <input
          id="hm-forgot-email"
          class="hm-input"
          type="email"
          inputmode="email"
          autocomplete="email"
          placeholder="you@email.com"
          required
        />
        <p class="hm-field-error" data-el="forgot-email-error" hidden></p>

        <button type="submit" class="hm-btn hm-btn-primary hm-btn-block-spacing" data-el="forgot-submit">
          Отправить ссылку
        </button>
        <button type="button" class="hm-btn hm-btn-ghost hm-btn-block-spacing" data-action="hm-forgot-back" style="margin-top: 10px;">
          Вернуться ко входу
        </button>
      </form>
    </div>

    <!-- AUTH SUCCESS PANE (login / register) -->
    <div class="hm-pane" data-pane-el="auth-success" hidden>
      <div class="hm-modal-header">
        <span class="hm-step-label">Готово</span>
        <button type="button" class="hm-icon-btn" data-action="hm-login-close" aria-label="Закрыть">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M3 3L11 11M11 3L3 11" />
          </svg>
        </button>
      </div>
      <div class="hm-success">
        <div class="hm-success-icon">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12.5L9.5 17L19 7.5" />
          </svg>
        </div>
        <h3 class="hm-success-title" data-el="success-title">С возвращением</h3>
        <p class="hm-success-text">Вы вошли в аккаунт. Открываем личный кабинет…</p>
        <a class="hm-btn hm-btn-primary hm-btn-block-spacing" data-el="success-link" href={returnTo}>
          В личный кабинет →
        </a>
      </div>
    </div>

    <!-- FORGOT SUCCESS PANE -->
    <div class="hm-pane" data-pane-el="forgot-success" hidden>
      <div class="hm-modal-header">
        <span class="hm-step-label">Готово</span>
        <button type="button" class="hm-icon-btn" data-action="hm-login-close" aria-label="Закрыть">
          <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
            <path d="M3 3L11 11M11 3L3 11" />
          </svg>
        </button>
      </div>
      <div class="hm-success">
        <div class="hm-success-icon hm-success-icon--brand">
          <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <rect x="3" y="5" width="18" height="14" rx="3" />
            <path d="M3.5 6.5L12 13L20.5 6.5" />
          </svg>
        </div>
        <h3 class="hm-success-title">Проверьте почту</h3>
        <p class="hm-success-text">
          Отправили ссылку на <strong data-el="sent-email">—</strong>.<br />
          Действительна 30 минут.
        </p>
        <button type="button" class="hm-btn hm-btn-primary hm-btn-block-spacing" data-action="hm-forgot-back">
          Вернуться ко входу
        </button>
        <button type="button" class="hm-forgot" data-el="forgot-reset" style="margin: 12px auto 0;">
          Использовать другой email
        </button>
      </div>
    </div>
  </div>
</dialog>

<script>
  import { openModal, closeModal, lockModal, bindModalDismiss } from "../../lib/modal";
  import {
    loginWithEmail,
    registerWithEmail,
    isAuthed,
    EmailSchema,
    PasswordSchema,
    LoginPasswordSchema,
  } from "../../lib/auth";
  import * as v from "valibot";

  const modal = document.getElementById("hm-login-modal") as HTMLDialogElement | null;
  if (modal) {
    type Mode = "login" | "register";
    type Pane = "auth" | "forgot" | "auth-success" | "forgot-success";

    const triggers = document.querySelectorAll<HTMLButtonElement>('[data-action="hm-login-open"]');
    const closeBtns = modal.querySelectorAll<HTMLButtonElement>('[data-action="hm-login-close"]');
    const forgotOpenBtns = modal.querySelectorAll<HTMLButtonElement>('[data-action="hm-forgot-open"]');
    const forgotBackBtns = modal.querySelectorAll<HTMLButtonElement>('[data-action="hm-forgot-back"]');
    const panes = modal.querySelectorAll<HTMLDivElement>("[data-pane-el]");
    const tabs = modal.querySelectorAll<HTMLButtonElement>('[role="tab"]');

    // Auth pane elements
    const form = modal.querySelector<HTMLFormElement>('[data-el="form"]');
    const title = modal.querySelector<HTMLHeadingElement>('[data-el="title"]');
    const subtitle = modal.querySelector<HTMLParagraphElement>('[data-el="subtitle"]');
    const forgotBtn = modal.querySelector<HTMLButtonElement>('[data-el="forgot"]');
    const agreeRow = modal.querySelector<HTMLLabelElement>('[data-el="agree-row"]');
    const agreeInput = modal.querySelector<HTMLInputElement>('[data-el="agree"]');
    const passwordMeter = modal.querySelector<HTMLDivElement>('[data-el="password-meter"]');
    const meterSegs = modal.querySelectorAll<HTMLSpanElement>(".hm-meter-seg[data-rule]");
    const meterRules = modal.querySelectorAll<HTMLLIElement>(".hm-meter-rule[data-rule]");
    const errorEl = modal.querySelector<HTMLParagraphElement>('[data-el="error"]');
    const emailErrorEl = modal.querySelector<HTMLParagraphElement>('[data-el="email-error"]');
    const passwordErrorEl = modal.querySelector<HTMLParagraphElement>('[data-el="password-error"]');
    const submitBtn = modal.querySelector<HTMLButtonElement>('[data-el="submit"]');
    const successTitle = modal.querySelector<HTMLHeadingElement>('[data-el="success-title"]');
    const emailInput = modal.querySelector<HTMLInputElement>("#hm-login-email");
    const passwordInput = modal.querySelector<HTMLInputElement>("#hm-login-password");

    // Forgot pane elements
    const forgotForm = modal.querySelector<HTMLFormElement>('[data-el="forgot-form"]');
    const forgotEmailInput = modal.querySelector<HTMLInputElement>("#hm-forgot-email");
    const forgotEmailErrorEl = modal.querySelector<HTMLParagraphElement>('[data-el="forgot-email-error"]');
    const forgotSubmitBtn = modal.querySelector<HTMLButtonElement>('[data-el="forgot-submit"]');
    const forgotResetBtn = modal.querySelector<HTMLButtonElement>('[data-el="forgot-reset"]');
    const sentEmailEl = modal.querySelector<HTMLElement>('[data-el="sent-email"]');

    const ALERT_ICON =
      '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 8v4M12 16h.01"/></svg>';

    bindModalDismiss(modal);

    /* ── triggers ─────────────────────────────────────────────────── */
    if (isAuthed()) {
      // Replace any login trigger with a direct "Личный кабинет →" anchor.
      triggers.forEach((t) => {
        const a = document.createElement("a");
        a.href = "/app/";
        a.className = "hm-trigger-anchor";
        a.textContent = "Личный кабинет →";
        t.replaceWith(a);
      });
    } else {
      triggers.forEach((t) => {
        t.addEventListener("click", () => {
          resetAll();
          openModal(modal);
        });
      });

      // External entry via ?auth=sign-in or ?auth=sign-up (used by the
      // SPA's AuthGateModal to bounce unauthenticated users to the landing
      // page with the right pane pre-opened). Optional ?return_to= sets
      // the post-success redirect target.
      const params = new URLSearchParams(location.search);
      const authParam = params.get("auth");
      const returnToParam = params.get("return_to");
      if (authParam === "sign-in" || authParam === "sign-up") {
        const mode: Mode = authParam === "sign-up" ? "register" : "login";
        modal.dataset.mode = mode;
        if (returnToParam) {
          modal.dataset.returnTo = returnToParam;
          const successLink = modal.querySelector<HTMLAnchorElement>(
            '[data-el="success-link"]',
          );
          if (successLink) successLink.href = returnToParam;
        }
        // Strip the params so refresh / back-nav doesn't keep re-opening the
        // modal after the user dismisses it.
        const cleanUrl = new URL(location.href);
        cleanUrl.searchParams.delete("auth");
        cleanUrl.searchParams.delete("return_to");
        history.replaceState(null, "", cleanUrl.toString());
        resetAll();
        openModal(modal);
      }
    }

    closeBtns.forEach((b) => b.addEventListener("click", () => closeModal(modal)));

    /* ── pane switching ───────────────────────────────────────────── */
    forgotOpenBtns.forEach((b) => {
      b.addEventListener("click", () => {
        // Seed forgot email from the auth email field, if any.
        const seed = emailInput?.value.trim();
        if (forgotEmailInput) forgotEmailInput.value = seed ?? "";
        clearFieldError(forgotEmailInput, forgotEmailErrorEl);
        setPane("forgot");
        forgotEmailInput?.focus();
      });
    });

    forgotBackBtns.forEach((b) => {
      b.addEventListener("click", () => {
        setPane("auth");
        emailInput?.focus();
      });
    });

    forgotResetBtn?.addEventListener("click", () => {
      if (forgotEmailInput) forgotEmailInput.value = "";
      clearFieldError(forgotEmailInput, forgotEmailErrorEl);
      setPane("forgot");
      forgotEmailInput?.focus();
    });

    /* ── auth pane: tabs + field reactions ────────────────────────── */
    tabs.forEach((tab) => {
      tab.addEventListener("click", () => setMode(tab.dataset.mode as Mode));
    });

    emailInput?.addEventListener("input", () => {
      clearFieldError(emailInput, emailErrorEl);
      hideError();
      updateSubmitGate();
    });
    passwordInput?.addEventListener("input", () => {
      clearFieldError(passwordInput, passwordErrorEl);
      hideError();
      updatePasswordMeter();
      updateSubmitGate();
    });
    agreeInput?.addEventListener("change", () => updateSubmitGate());

    forgotEmailInput?.addEventListener("input", () =>
      clearFieldError(forgotEmailInput, forgotEmailErrorEl),
    );

    /* ── auth submit ──────────────────────────────────────────────── */
    form?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const mode = (modal.dataset.mode ?? "login") as Mode;
      const email = emailInput?.value.trim() ?? "";
      const password = passwordInput?.value ?? "";

      hideError();
      clearFieldError(emailInput, emailErrorEl);
      clearFieldError(passwordInput, passwordErrorEl);

      const emailParse = v.safeParse(EmailSchema, email);
      if (!emailParse.success) {
        showFieldError(
          emailInput,
          emailErrorEl,
          emailParse.issues[0]?.message ?? "Некорректный email",
        );
        emailInput?.focus();
        return;
      }
      const passwordSchema = mode === "login" ? LoginPasswordSchema : PasswordSchema;
      const passwordParse = v.safeParse(passwordSchema, password);
      if (!passwordParse.success) {
        showFieldError(
          passwordInput,
          passwordErrorEl,
          passwordParse.issues[0]?.message ?? "Проверьте пароль",
        );
        passwordInput?.focus();
        return;
      }
      if (mode === "register" && !agreeInput?.checked) {
        showError("Необходимо согласие с условиями");
        return;
      }

      setAuthPending(true, mode);
      try {
        if (mode === "login") {
          await loginWithEmail(email, password);
        } else {
          await registerWithEmail(email, password);
        }
        if (successTitle) {
          successTitle.textContent = mode === "login" ? "С возвращением" : "Аккаунт создан";
        }
        setPane("auth-success");
        lockModal(modal, false);
      } catch (e) {
        showError(e instanceof Error ? e.message : "Не удалось войти");
        setAuthPending(false, mode);
      }
    });

    /* ── forgot submit (stub until backend ships /auth/forgot-password) ── */
    forgotForm?.addEventListener("submit", async (event) => {
      event.preventDefault();
      const email = forgotEmailInput?.value.trim() ?? "";
      clearFieldError(forgotEmailInput, forgotEmailErrorEl);

      const parsed = v.safeParse(EmailSchema, email);
      if (!parsed.success) {
        showFieldError(
          forgotEmailInput,
          forgotEmailErrorEl,
          parsed.issues[0]?.message ?? "Некорректный email",
        );
        forgotEmailInput?.focus();
        return;
      }

      setForgotPending(true);
      try {
        await new Promise((r) => setTimeout(r, 280));
        if (sentEmailEl) sentEmailEl.textContent = email;
        setPane("forgot-success");
      } finally {
        setForgotPending(false);
      }
    });

    /* ── helpers ──────────────────────────────────────────────────── */

    function setPane(pane: Pane): void {
      modal.dataset.pane = pane;
      panes.forEach((p) => {
        p.hidden = p.dataset.paneEl !== pane;
      });
    }

    function setMode(mode: Mode | undefined): void {
      if (mode !== "login" && mode !== "register") return;
      modal.dataset.mode = mode;
      tabs.forEach((tab) => {
        tab.setAttribute("aria-selected", String(tab.dataset.mode === mode));
      });
      hideError();
      clearFieldError(emailInput, emailErrorEl);
      clearFieldError(passwordInput, passwordErrorEl);

      if (mode === "login") {
        if (title) title.textContent = "С возвращением";
        if (subtitle) subtitle.textContent = "Запишитесь к врачу за минуту.";
        if (passwordInput) {
          passwordInput.autocomplete = "current-password";
          passwordInput.placeholder = "••••••••";
        }
        if (submitBtn) submitBtn.textContent = "Войти";
        if (forgotBtn) forgotBtn.hidden = false;
        if (agreeRow) agreeRow.hidden = true;
        if (passwordMeter) passwordMeter.hidden = true;
      } else {
        if (title) title.textContent = "Создать аккаунт";
        if (subtitle) subtitle.textContent = "Запишитесь к врачу за минуту.";
        if (passwordInput) {
          passwordInput.autocomplete = "new-password";
          passwordInput.placeholder = "••••••••";
        }
        if (submitBtn) submitBtn.textContent = "Создать аккаунт";
        if (forgotBtn) forgotBtn.hidden = true;
        if (agreeRow) agreeRow.hidden = false;
        if (passwordMeter) passwordMeter.hidden = false;
        updatePasswordMeter();
      }

      updateSubmitGate();
    }

    function updateSubmitGate(): void {
      if (!submitBtn) return;
      const mode = (modal.dataset.mode ?? "login") as Mode;
      if (mode === "login") {
        submitBtn.disabled = false;
        return;
      }
      // Register mode: silently re-validate so the CTA only activates when
      // email + password meet the rules AND the user has agreed. We don't
      // surface error UI here — that still fires on submit.
      const email = emailInput?.value.trim() ?? "";
      const password = passwordInput?.value ?? "";
      const emailOk = v.safeParse(EmailSchema, email).success;
      const passwordOk = v.safeParse(PasswordSchema, password).success;
      submitBtn.disabled = !(emailOk && passwordOk && agreeInput?.checked);
    }

    function updatePasswordMeter(): void {
      const value = passwordInput?.value ?? "";
      const rules: Record<string, boolean> = {
        length: value.length >= 8,
        upper: /[A-ZА-Я]/.test(value),
        digit: /[0-9]/.test(value),
      };
      meterSegs.forEach((seg) => {
        const key = seg.dataset.rule;
        if (key) seg.dataset.met = String(Boolean(rules[key]));
      });
      meterRules.forEach((rule) => {
        const key = rule.dataset.rule;
        if (key) rule.dataset.met = String(Boolean(rules[key]));
      });
    }

    function setAuthPending(pending: boolean, mode: Mode): void {
      if (submitBtn) {
        submitBtn.disabled = pending;
        submitBtn.textContent = pending
          ? mode === "login"
            ? "Входим…"
            : "Создаём…"
          : mode === "login"
            ? "Войти"
            : "Создать аккаунт";
      }
      if (emailInput) emailInput.disabled = pending;
      if (passwordInput) passwordInput.disabled = pending;
      if (agreeInput) agreeInput.disabled = pending;
      lockModal(modal, pending);
      if (!pending) updateSubmitGate();
    }

    function setForgotPending(pending: boolean): void {
      if (forgotSubmitBtn) {
        forgotSubmitBtn.disabled = pending;
        forgotSubmitBtn.textContent = pending ? "Отправляем…" : "Отправить ссылку";
      }
      if (forgotEmailInput) forgotEmailInput.disabled = pending;
      lockModal(modal, pending);
    }

    function showError(message: string): void {
      if (!errorEl) return;
      errorEl.textContent = message;
      errorEl.hidden = false;
    }
    function hideError(): void {
      if (!errorEl) return;
      errorEl.textContent = "";
      errorEl.hidden = true;
    }

    function showFieldError(
      input: HTMLInputElement | null,
      target: HTMLParagraphElement | null,
      message: string,
    ): void {
      if (input) input.setAttribute("aria-invalid", "true");
      if (target) {
        target.innerHTML = `${ALERT_ICON}<span>${message}</span>`;
        target.hidden = false;
      }
    }
    function clearFieldError(
      input: HTMLInputElement | null,
      target: HTMLParagraphElement | null,
    ): void {
      if (input) input.removeAttribute("aria-invalid");
      if (target) {
        target.textContent = "";
        target.hidden = true;
      }
    }

    function resetAll(): void {
      // Reset both forms back to a clean state and land on the auth pane.
      if (emailInput) emailInput.value = "";
      if (passwordInput) passwordInput.value = "";
      if (agreeInput) agreeInput.checked = false;
      if (forgotEmailInput) forgotEmailInput.value = "";
      hideError();
      clearFieldError(emailInput, emailErrorEl);
      clearFieldError(passwordInput, passwordErrorEl);
      clearFieldError(forgotEmailInput, forgotEmailErrorEl);
      updatePasswordMeter();
      setMode((modal.dataset.mode as Mode) ?? "login");
      setAuthPending(false, (modal.dataset.mode as Mode) ?? "login");
      setForgotPending(false);
      setPane("auth");
    }
  }
</script>
