---
// Подвал сайта. Про две версии и проп variant — см. комментарий в SiteHeader.astro.
//
// Ссылки на «#» оставлены как были: страниц «О нас», «Контакты», «Помощь» и
// «Политика» ещё нет. Их надо либо завести, либо убрать из подвала — заглушка
// в юридическом блоке медицинского сервиса хуже, чем её отсутствие.
import SiteLogo from "./SiteLogo.astro";
import "../../styles/site-chrome.css";

interface Props {
  variant: "mobile" | "desktop";
}

const { variant } = Astro.props;

// Подвал стоит на страницах, которые про каталог ничего не знают, поэтому
// количественных обещаний в строке быть не может: подтвердить их нечем.
const TAGLINE = "Сервис записи к врачу.";
---

{
  variant === "mobile" ? (
    <footer class="mw-footer">
      <SiteLogo />
      <div class="mw-footer-cols">
        <div class="mw-footer-col">
          <div class="mw-footer-title">Пациентам</div>
          <a href="/search">Найти врача</a>
        </div>
        <div class="mw-footer-col">
          <div class="mw-footer-title">Компания</div>
          <a href="#">О нас</a>
          <a href="#">Контакты</a>
        </div>
        <div class="mw-footer-col">
          <div class="mw-footer-title">Поддержка</div>
          <a href="#">Помощь</a>
          <a href="#">Политика</a>
        </div>
      </div>
      {/* Номера лицензии здесь нет намеренно: регистрационных данных по KG
          пока не существует, а выдуманные — хуже молчания. */}
      <div class="mw-footer-fine">
        <div>© 2026 Healthy. Сервис записи к врачам.</div>
        <div>Бишкек</div>
        {/* Оговорка про оферту стояла в прежнем инлайновом подвале index.astro и
            при переезде в компонент потерялась. Для сервиса записи к врачу это
            не украшение: страница называет цены и время приёма, и без неё
            перечисленное читается как публичное предложение заключить договор
            на этих условиях. */}
        <div>Информация на сайте не является публичной офертой.</div>
      </div>
    </footer>
  ) : (
    <footer class="dw-footer">
      <div class="dw-footer-inner">
        <div class="dw-footer-grid">
          <div class="dw-footer-brand">
            <SiteLogo />
            <p>{TAGLINE}</p>
          </div>
          <div class="dw-footer-col">
            <div class="dw-footer-title">Пациентам</div>
            <a href="/search">Найти врача</a>
          </div>
          <div class="dw-footer-col">
            <div class="dw-footer-title">Компания</div>
            <a href="#">О нас</a>
            <a href="#">Контакты</a>
          </div>
          <div class="dw-footer-col">
            <div class="dw-footer-title">Поддержка</div>
            <a href="#">Помощь</a>
            <a href="#">Политика</a>
          </div>
          <div class="dw-footer-col">
            <div class="dw-footer-title">Регионы</div>
            <a href="#">Бишкек</a>
          </div>
        </div>
        {/* См. комментарии про лицензию и оферту в мобильной версии выше.
            Оговорка про оферту стоит и здесь: на телефоне она была, на широком
            экране — нет, а юридическая строка, зависящая от ширины окна, это
            не «две версии вёрстки», а отсутствующая оговорка у половины
            посетителей. */}
        <div class="dw-footer-bottom">
          <span>© 2026 Healthy. Все права защищены.</span>
          <span>Информация на сайте не является публичной офертой.</span>
          <span>Бишкек</span>
        </div>
      </div>
    </footer>
  )
}
