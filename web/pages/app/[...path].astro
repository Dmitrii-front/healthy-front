---
import AppLayout from "../../layouts/AppLayout.astro";
import AppShell from "../../components/AppShell";

// Catch-all for the private zone: matches /app, /app/visits, /app/profile,
// /app/booking/d1, etc. The shell is byte-identical regardless of the path
// (the React router inside AppShell reads window.location and matches the
// TanStack route client-side), so we prerender exactly ONE static file at
// build time → dist/client/app/index.html.
//
// CF Pages then:
//   1. /_routes.json (auto-generated by @astrojs/cloudflare based on
//      prerender=true) excludes /app/* from the Worker — assets handler
//      serves files directly.
//   2. /public/_redirects rewrites every /app/* URL to /app/index.html
//      with status 200 (URL preserved, body from the static file). This
//      makes /app/visits, /app/booking/d1, etc. all serve the same shell
//      without invoking the Worker.
//
// Result: zero Worker invocations on /app/*, served from CF edge-CDN.
// Cache headers come from /public/_headers (also CF-Pages-native), not
// Astro.response — Astro can't set runtime headers on prerendered routes.
export const prerender = true;

// Catch-all routes need getStaticPaths(). Single entry returns the
// undefined-path case, which Astro outputs as `app/index.html`.
export function getStaticPaths() {
  return [{ params: { path: undefined } }];
}
---

<AppLayout title="Healthy">
  <div id="root">
    <AppShell client:only="react">
      <div slot="fallback" class="flex min-h-dvh items-center justify-center text-sm text-distant-graphite">
        Загрузка…
      </div>
    </AppShell>
  </div>
</AppLayout>
