---
import AppLayout from "../../layouts/AppLayout.astro";
import AppShell from "../../components/AppShell";

// Catch-all for the private zone: matches /app, /app/visits, /app/profile, /app/booking/d1, etc.
// Do not prerender — it's cheaper to SSR via the CF Worker which serves a single shared shell.
// The React router inside AppShell reads window.location itself and matches the TanStack route.
export const prerender = false;

// The shell is identical for every /app/* path and only changes between deploys.
// Setting Cache-Control lets the browser serve repeat navigations from disk cache
// (so the warm-up fetch() in BaseLayout actually pays off on the next click).
// s-maxage caches at the CF edge; max-age caches in the browser. SWR keeps things
// snappy if the entry expires while the user is mid-session.
Astro.response.headers.set(
  "Cache-Control",
  "public, max-age=300, s-maxage=86400, stale-while-revalidate=86400",
);
// Override Vary to drop "Origin". CF/Workers default Vary: Origin (for CORS)
// would split the cache between the warm-up fetch() (sends Origin) and the
// top-level navigation (does not), so the prefetched entry is never reused.
Astro.response.headers.set("Vary", "Accept-Encoding");
---

<AppLayout title="Healthy">
  <div id="root">
    <AppShell client:only="react">
      <div slot="fallback" class="flex min-h-dvh items-center justify-center text-sm text-distant-graphite">
        Загрузка…
      </div>
    </AppShell>
  </div>
</AppLayout>
