<script>
  import { fetchAvailableSlots } from "../../lib/booking";

  // Слоты НЕЛЬЗЯ вшить в статическую страницу: доступность меняется постоянно,
  // а страница прегенерится на сборке. Поэтому календарь — клиентский остров,
  // читающий конфиг из data-атрибутов (define:vars инлайнится и не умеет import).
  //
  // Состояний два, и они разного уровня: дата — общая на всю запись (createRail),
  // время — у каждого места своё (initPlace). Запросы к доступности всё равно
  // уходят по одному на место, параллельно, но выбирает пациент один день на
  // всех и сразу видит, где в этот день есть время. Место при этом не
  // выбирается отдельным шагом — им нельзя ошибиться.
  (() => {
    const section = document.getElementById("booking");
    if (!section) return;
    const doctorId = section.dataset.doctorId ?? "";
    const trigger = section.querySelector('[data-action="hm-book-open"]');
    const blocks = [...section.querySelectorAll('[data-el="place-block"]')];

    const MONTHS_NOM = ["Январь","Февраль","Март","Апрель","Май","Июнь","Июль","Август","Сентябрь","Октябрь","Ноябрь","Декабрь"];
    const MONTHS_GEN = ["янв","фев","мар","апр","мая","июн","июл","авг","сен","окт","ноя","дек"];
    // Полные формы — только для aria-label дней: «Пт, 25 июл» скринридер
    // прочитает как «июл», а сокращения в ленте у него контекста лишены.
    const MONTHS_GEN_FULL = ["января","февраля","марта","апреля","мая","июня","июля","августа","сентября","октября","ноября","декабря"];
    const DOW_SHORT = ["Вс","Пн","Вт","Ср","Чт","Пт","Сб"];
    const WINDOW_DAYS = 14;
    const motionOk = !window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    /** YYYY-MM-DD по ЛОКАЛЬНОЙ дате: toISOString() съехал бы на день в UTC+6. */
    const isoDate = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;

    const windowDates = () => {
      const out = [];
      const base = new Date();
      base.setHours(0, 0, 0, 0);
      for (let i = 0; i < WINDOW_DAYS; i += 1) {
        const d = new Date(base);
        d.setDate(base.getDate() + i);
        out.push(d);
      }
      return out;
    };

    /** Общая лента дат. Владеет выбранным днём и раздаёт его местам; сами места
        дату не выбирают. Точка на дне — объединение доступности всех мест,
        поэтому лента ждёт, пока отчитаются все блоки, и только потом ставит
        первый свободный день: иначе выбор скакал бы по мере ответов. */
    function createRail(root) {
      const dayTrack = root.querySelector('[data-el="day-track"]');
      const dayPrev = root.querySelector('[data-el="day-prev"]');
      const dayNext = root.querySelector('[data-el="day-next"]');
      const monthLabel = root.querySelector('[data-el="month-label"]');
      if (!dayTrack) return null;

      const dates = windowDates();
      /** placeId → Set<YYYY-MM-DD>; null = место не ответило, это не «занято». */
      const byPlace = new Map();
      const listeners = [];
      let expected = 0;
      let activeDate = "";
      let syncFrame = 0;

      const known = () => [...byPlace.values()].filter((set) => set !== null);
      const freeAt = (iso) => known().filter((set) => set.has(iso)).length;
      const notify = () => listeners.forEach((fn) => fn());

      /** Выбранный день переставляем на месте, не перерисовывая ленту: перерисовка
          сбрасывала бы scrollLeft, и лента прыгала бы к началу на каждый тап. */
      function markActive() {
        dayTrack.querySelectorAll(".hm-day").forEach((el) => {
          el.setAttribute("aria-pressed", String(el.dataset.date === activeDate));
        });
      }

      /** Заголовок — по видимому куску ленты, а не по всему окну: две недели
          часто лежат в двух месяцах, и подписать их одним значило бы соврать
          про половину карточек. Считаем от того, что пациент видит сейчас. */
      function syncMonthLabel() {
        if (!monthLabel) return;
        const cards = [...dayTrack.children];
        const base = cards[0]?.offsetLeft ?? 0;
        const from = dayTrack.scrollLeft;
        const to = from + dayTrack.clientWidth;
        const shown = cards.filter((el) => {
          const left = el.offsetLeft - base;
          return left + el.offsetWidth > from + 1 && left < to - 1;
        });
        const lead = shown[0] ?? cards[0];
        const tail = shown[shown.length - 1] ?? lead;
        if (lead?.dataset.date === undefined || tail?.dataset.date === undefined) return;
        const a = new Date(`${lead.dataset.date}T00:00:00`);
        const b = new Date(`${tail.dataset.date}T00:00:00`);
        monthLabel.textContent =
          a.getMonth() === b.getMonth()
            ? `${MONTHS_NOM[a.getMonth()]} ${a.getFullYear()}`
            : `${MONTHS_NOM[a.getMonth()]} – ${MONTHS_NOM[b.getMonth()]} ${b.getFullYear()}`;
      }

      /** Стрелки: гасим на краях, убираем совсем, когда лента влезла целиком. */
      function syncNav() {
        const max = dayTrack.scrollWidth - dayTrack.clientWidth;
        const idle = max <= 1;
        if (dayPrev) {
          dayPrev.hidden = idle;
          dayPrev.disabled = dayTrack.scrollLeft <= 1;
        }
        if (dayNext) {
          dayNext.hidden = idle;
          dayNext.disabled = dayTrack.scrollLeft >= max - 1;
        }
      }

      /** Шаг стрелки — целое число карточек: замирать на половине дня незачем. */
      function pageStep() {
        const cards = dayTrack.children;
        const unit =
          cards.length > 1 ? cards[1].offsetLeft - cards[0].offsetLeft : (cards[0]?.offsetWidth ?? 70);
        return Math.max(Math.floor(dayTrack.clientWidth / unit), 1) * unit;
      }

      /** Выбранный день может лежать за краем — подводим ленту к нему. Плавно
          только когда день сменился по ходу дела: при первой отрисовке анимация
          поехала бы из ниоткуда. */
      function revealActive(smooth = false) {
        const el = dayTrack.querySelector('[aria-pressed="true"]');
        if (el === null) return;
        const base = dayTrack.firstElementChild?.offsetLeft ?? 0;
        const left = Math.max(0, el.offsetLeft - base - (dayTrack.clientWidth - el.offsetWidth) / 2);
        dayTrack.scrollTo({ left, behavior: smooth && motionOk ? "smooth" : "auto" });
      }

      function renderDays() {
        dayTrack.innerHTML = "";
        dates.forEach((d) => {
          const iso = isoDate(d);
          const free = freeAt(iso);

          const b = document.createElement("button");
          b.type = "button";
          b.className = "hm-day";
          b.disabled = free === 0;
          b.dataset.date = iso;
          b.setAttribute("aria-pressed", String(iso === activeDate));
          // Вне сетки месяца «25» само себя не объясняет — дату даём целиком.
          b.setAttribute("aria-label", `${DOW_SHORT[d.getDay()]}, ${d.getDate()} ${MONTHS_GEN_FULL[d.getMonth()]}`);

          const dow = document.createElement("span");
          dow.className = "hm-day-dow";
          dow.textContent = DOW_SHORT[d.getDay()];
          const num = document.createElement("span");
          num.className = "hm-day-num";
          num.textContent = String(d.getDate());
          // Точка есть всегда: без неё числа в занятых днях съезжали бы вниз.
          const dot = document.createElement("span");
          dot.className = "hm-day-dot";
          if (free === 0) dot.dataset.empty = "1";
          b.append(dow, num, dot);

          if (free > 0) b.addEventListener("click", () => select(iso));
          dayTrack.appendChild(b);
        });
        syncMonthLabel();
        syncNav();
      }

      /** reveal — для выбора не из самой ленты («Ближайшее — 31 июля» в карточке
          места): выбранный день может лежать за краем, и лента должна доехать
          до него, иначе слоты сменились, а в ленте не видно ничего. */
      function select(iso, reveal = false) {
        if (iso === activeDate) return;
        activeDate = iso;
        markActive();
        if (reveal) revealActive(true);
        notify();
      }

      /** Место отчитывается своей доступностью: set с датами или null, если
          запрос упал. Пока не отчитались все — день не выбираем. */
      function publish(placeId, availableDates) {
        byPlace.set(placeId, availableDates);
        const previous = activeDate;
        if (byPlace.size >= expected && (activeDate === "" || freeAt(activeDate) === 0)) {
          activeDate = dates.map(isoDate).find((iso) => freeAt(iso) > 0) ?? "";
        }
        renderDays();
        if (activeDate !== previous) {
          revealActive();
          notify();
        }
      }

      const scrollBehavior = motionOk ? "smooth" : "auto";
      dayPrev?.addEventListener("click", () => dayTrack.scrollBy({ left: -pageStep(), behavior: scrollBehavior }));
      dayNext?.addEventListener("click", () => dayTrack.scrollBy({ left: pageStep(), behavior: scrollBehavior }));
      // Прокрутка тач-свайпом идёт мимо стрелок, а заголовок месяца и края
      // ленты от неё зависят — досчитываем на кадре, не на каждом событии.
      dayTrack.addEventListener(
        "scroll",
        () => {
          if (syncFrame !== 0) return;
          syncFrame = requestAnimationFrame(() => {
            syncFrame = 0;
            syncMonthLabel();
            syncNav();
          });
        },
        { passive: true },
      );
      // От ширины ленты зависят и стрелки, и заголовок: в кадр влезает другое
      // число дней, а значит и другой набор месяцев.
      new ResizeObserver(() => {
        syncMonthLabel();
        syncNav();
      }).observe(dayTrack);

      // Прилипла лента или нет — по её собственному top относительно того
      // отступа, который задан в CSS: дублировать значение в JS нельзя, разъедутся.
      // Позицию проверяем тоже: на низких экранах sticky снят медиазапросом, и
      // тогда доехать до top — это просто проскроллить мимо, а не прилипнуть.
      let stuckFrame = 0;
      const syncStuck = () => {
        const style = getComputedStyle(root);
        const offset = Number.parseFloat(style.top);
        const stuck =
          style.position === "sticky" &&
          Number.isFinite(offset) &&
          root.getBoundingClientRect().top <= offset + 0.5;
        root.toggleAttribute("data-stuck", stuck);
      };
      const queueStuck = () => {
        if (stuckFrame !== 0) return;
        stuckFrame = requestAnimationFrame(() => {
          stuckFrame = 0;
          syncStuck();
        });
      };
      window.addEventListener("scroll", queueStuck, { passive: true });
      // Высота вьюпорта решает, липнет лента вообще или нет, а меняется она и
      // без скролла: поворот экрана, свернувшаяся адресная строка.
      window.addEventListener("resize", queueStuck, { passive: true });
      syncStuck();

      return {
        date: () => activeDate,
        subscribe: (fn) => listeners.push(fn),
        select,
        publish,
        /** Сколько мест ждём. Заодно рисует ленту заглушкой, чтобы вёрстка не
            дёргалась, когда придут ответы. */
        expect: (count) => {
          expected = count;
          renderDays();
        },
      };
    }

    /** Выбор вида приёма внутри одного места.
     *
     * Комбобокс, а не <select>: системный дропдаун не умеет искать, а типов у
     * места может быть больше десятка. Поле совмещает две роли — показывает
     * выбранное и принимает запрос, — поэтому отдельной строки поиска в списке
     * нет. Выбранное живёт в aria-selected на опции: одно состояние на разметку
     * и на скрипт, рассинхронизироваться нечему.
     *
     * Место с единственным типом рендерится строкой, без выбора: тогда наружу
     * отдаём её данные, а подписка ничего не делает — менять нечего. */
    function initTypePicker(root) {
      const input = root.querySelector('[data-el="type-input"]');
      const pop = root.querySelector('[data-el="type-pop"]');
      const empty = root.querySelector('[data-el="type-empty"]');

      // Комбобокса нет — значит услуга одна, и выбирать нечего: её данные лежат
      // в data-атрибутах карточки, потому что на странице она не показана.
      if (input === null || pop === null || empty === null) {
        return {
          count: 1,
          current: () => ({
            id: root.dataset.soleTypeId ?? "",
            name: root.dataset.soleTypeName ?? "",
            duration: root.dataset.soleDuration ?? "",
          }),
          subscribe: () => {},
        };
      }

      const options = [...pop.querySelectorAll('[role="option"]')];
      const listeners = [];
      const label = (option) => `${option.dataset.typeName} · ${option.dataset.duration} мин`;
      // «ё» на клавиатуре стоит отдельно от остальных букв, и её почти никто не
      // печатает: без этого запрос «прием» не находил бы «Первичный приём».
      const fold = (text) => text.toLowerCase().replaceAll("ё", "е");
      const visible = () => options.filter((option) => !option.hidden);
      let selected = options.find((option) => option.getAttribute("aria-selected") === "true") ?? options[0];
      let active = selected;

      function setActive(option) {
        active = option ?? null;
        options.forEach((item) => item.toggleAttribute("data-active", item === active));
        if (active === null) {
          input.removeAttribute("aria-activedescendant");
          return;
        }
        // Скринридер читает активную опцию по этой ссылке, а не по подсветке.
        input.setAttribute("aria-activedescendant", active.id);
        active.scrollIntoView({ block: "nearest" });
      }

      function filter(query) {
        const needle = fold(query.trim());
        options.forEach((option) => {
          // Пустой запрос показывает всё: в закрытом виде в поле лежит название
          // выбранного типа, и фильтровать список сам по себе он не должен.
          option.hidden = needle !== "" && !fold(option.dataset.typeName).includes(needle);
        });
        const shown = visible();
        empty.hidden = shown.length > 0;
        setActive(shown.includes(active) ? active : (shown[0] ?? null));
      }

      /** Показать список, не трогая поле. */
      function reveal() {
        if (!pop.hidden) return;
        pop.hidden = false;
        input.setAttribute("aria-expanded", "true");
      }

      /** Открытие как жест «выбираю заново»: поле чистим под запрос, список
          показываем целиком. Что выбрано сейчас, видно по галочке в списке, так
          что название в поле только мешало бы — его пришлось бы стирать руками.
          Повторный вызов при открытом списке ничего не чистит: набранный запрос
          на полпути терять нельзя.

          Поле без поиска (readonly, типов меньше TYPE_SEARCH_FROM) чистить
          нечем и незачем: печатать в него нельзя, и название выбранного —
          единственное, что оно показывает. */
      function open() {
        if (!pop.hidden) return;
        reveal();
        if (!input.readOnly) input.value = "";
        filter("");
        setActive(selected);
      }

      function close() {
        if (pop.hidden) return;
        pop.hidden = true;
        input.setAttribute("aria-expanded", "false");
        input.removeAttribute("aria-activedescendant");
        // Поле — ещё и показ выбранного, поэтому недобранный запрос («перв») в
        // нём остаться не может: возвращаем название целиком.
        input.value = label(selected);
        options.forEach((option) => {
          option.hidden = false;
        });
        empty.hidden = true;
      }

      function commit(option) {
        const changed = option !== selected;
        selected = option;
        options.forEach((item) => item.setAttribute("aria-selected", String(item === option)));
        close();
        if (changed) listeners.forEach((fn) => fn());
      }

      input.addEventListener("focus", open);
      // Состояние списка снимаем в pointerdown: он приходит раньше focus, а тот
      // список уже открыл — сравнивать в click было бы поздно, и первый же клик
      // закрывал бы только что открытое.
      let openBeforeClick = false;
      input.addEventListener("pointerdown", () => {
        openBeforeClick = !pop.hidden;
      });
      // Ещё и на click: клик по уже сфокусированному полю (а после выбора фокус
      // остаётся здесь) события focus не даёт, и список бы не открылся.
      input.addEventListener("click", () => {
        // Поле без поиска — обычный дропдаун, и повторный клик его закрывает.
        // С поиском так нельзя: клик по полю там ставит каретку в запрос, и
        // закрывать список на это — значит отменять начатый набор.
        if (input.readOnly && openBeforeClick) {
          close();
          return;
        }
        open();
      });
      input.addEventListener("input", () => {
        // Ввод при закрытом списке — это начало нового запроса. Поле в этот
        // момент показывает название выбранного (так остаётся после Escape), и
        // набранное дописалось к нему: оставляем только добавленный хвост. Если
        // правка была не дописыванием (Backspace), чистим поле совсем.
        //
        // Разбираемся здесь, а не в keydown: keydown не приходит при вставке,
        // подсказке Android-клавиатуры и вводе через IME, а input — всегда.
        if (pop.hidden) {
          const shown = label(selected);
          input.value = input.value.startsWith(shown) ? input.value.slice(shown.length) : "";
          reveal();
        }
        filter(input.value);
      });
      input.addEventListener("keydown", (event) => {
        if (event.key === "ArrowDown" || event.key === "ArrowUp") {
          event.preventDefault();
          if (pop.hidden) {
            open();
            return;
          }
          const shown = visible();
          if (shown.length === 0) return;
          const step = event.key === "ArrowDown" ? 1 : -1;
          const next = (shown.indexOf(active) + step + shown.length) % shown.length;
          setActive(shown[next]);
          return;
        }
        // Enter при закрытом списке не перехватываем: пусть уходит форме, если
        // поле однажды окажется внутри неё.
        if (event.key === "Enter" && !pop.hidden) {
          event.preventDefault();
          if (active !== null) commit(active);
          return;
        }
        if (event.key === "Escape" && !pop.hidden) {
          event.preventDefault();
          close();
          return;
        }
        // Поле без поиска раскрывается ещё и с Enter или пробела, как нативный
        // select. В поле с поиском пробел — это пробел в запросе, а Enter при
        // закрытом списке мы намеренно не перехватываем.
        if (input.readOnly && pop.hidden && (event.key === "Enter" || event.key === " ")) {
          event.preventDefault();
          open();
        }
      });

      // mousedown, а не click: между ними успевает пройти blur, тот закрывает
      // список — и click прилетает уже в пустоту. preventDefault оставляет фокус
      // в поле, чтобы после выбора работали стрелки.
      pop.addEventListener("mousedown", (event) => {
        const option = event.target.closest('[role="option"]');
        if (option === null) return;
        event.preventDefault();
        commit(option);
      });
      // Тап по опции на телефоне: pointer-события там не дают mousedown до click.
      pop.addEventListener("click", (event) => {
        const option = event.target.closest('[role="option"]');
        if (option !== null && !pop.hidden) commit(option);
      });

      input.addEventListener("blur", close);
      // Тап мимо поля фокус снимает не всегда (например, по неинтерактивному
      // фону), а список при этом обязан закрыться.
      document.addEventListener("pointerdown", (event) => {
        if (!pop.hidden && !root.contains(event.target)) close();
      });

      return {
        count: options.length,
        current: () => ({
          id: selected.dataset.typeId ?? "",
          name: selected.dataset.typeName ?? "",
          duration: selected.dataset.duration ?? "",
        }),
        subscribe: (fn) => listeners.push(fn),
      };
    }

    function initPlace(root, rail) {
      const slotGrid = root.querySelector('[data-el="slot-grid"]');
      const slotStatus = root.querySelector('[data-el="slot-status"]');
      const dayLabel = root.querySelector('[data-el="slot-day-label"]');
      // Место без активных видов приёма рендерится без слотов — вести нечего.
      if (!slotGrid) return null;

      const typePicker = initTypePicker(root);
      const placeId = root.dataset.placeId ?? "";
      /** date → { workPlaceId, workplaceName, times: string[] } */
      let byDate = new Map();
      // Запрос упал — пока не переспросим, «свободного времени нет» здесь врать
      // нельзя: пустой byDate у сбоя и у занятого расписания выглядит одинаково.
      let failed = false;

      function setStatus(text) {
        if (!slotStatus) return;
        if (text === null) {
          slotStatus.hidden = true;
          slotStatus.textContent = "";
        } else {
          slotStatus.hidden = false;
          slotStatus.innerHTML = text;
        }
      }

      /** Клик по времени и есть запись: отдельной кнопки подтверждения нет,
          подтверждает шит, который сейчас откроется. Всё, что нужно для брони,
          уезжает туда через dataset: своего состояния у шита нет. work_place_id
          берём из ответа слотов, а не из блока — сервер тут авторитетнее вёрстки. */
      function book(time) {
        const active = rail.date();
        const day = byDate.get(active);
        if (!day || !trigger) return;
        const type = typePicker.current();
        trigger.dataset.appointmentTypeId = type.id;
        trigger.dataset.typeName = type.name;
        trigger.dataset.durationMin = type.duration;
        trigger.dataset.workPlaceId = day.workPlaceId;
        trigger.dataset.workplaceName = day.workplaceName;
        // Шапка шита обязана назвать то же место, что и запись под ней: у врача
        // мест несколько, и разойтись здесь — это приехать не в ту клинику.
        trigger.dataset.doctorClinic = day.workplaceName;
        trigger.dataset.slotDate = active;
        trigger.dataset.slotTime = time;
        // Выбора формата на странице нет — все записи офлайн.
        trigger.dataset.isOnline = "0";
        trigger.click();
      }

      /** Пусто — не тупик. Если у места время есть, но в другой день, зовём
          туда кнопкой: искать этот день по ленте вручную пациент не должен. */
      function renderEmpty(active) {
        if (byDate.size === 0) {
          const tail = typePicker.count > 1 ? "<br>Попробуйте другую услугу." : "";
          setStatus(`Здесь нет свободного времени в ближайшие две недели.${tail}`);
          return;
        }
        if (active === "") {
          setStatus(null);
          return;
        }
        const dates = [...byDate.keys()].sort();
        const near = dates.find((iso) => iso > active) ?? dates[0];
        const d = new Date(`${near}T00:00:00`);
        setStatus(
          `В этот день здесь записи нет. <button type="button" data-el="jump" class="hm-retry">Ближайшее — ${d.getDate()} ${MONTHS_GEN_FULL[d.getMonth()]}</button>`,
        );
        root.querySelector('[data-el="jump"]')?.addEventListener("click", () => rail.select(near, true));
      }

      /** Дату диктует общая лента — своего выбора дня у места нет. */
      function renderSlots() {
        const active = rail.date();
        const times = byDate.get(active)?.times ?? [];

        if (dayLabel) {
          if (active === "") {
            dayLabel.textContent = "";
          } else {
            const d = new Date(`${active}T00:00:00`);
            const human =
              active === isoDate(new Date())
                ? `сегодня, ${d.getDate()} ${MONTHS_GEN[d.getMonth()]}`
                : `${DOW_SHORT[d.getDay()]}, ${d.getDate()} ${MONTHS_GEN[d.getMonth()]}`;
            dayLabel.textContent = ` · ${human}`;
          }
        }
        slotGrid.innerHTML = "";
        // Смена даты в общей ленте перерисовывает все места, в том числе те, чей
        // запрос упал: сообщение об ошибке трогать нельзя, оно всё ещё в силе.
        if (failed) return;
        if (times.length === 0) {
          renderEmpty(active);
          return;
        }
        setStatus(null);

        times.forEach((time) => {
          const b = document.createElement("button");
          b.type = "button";
          b.className = "hm-slot";
          b.textContent = time;
          // Голое «09:30» с клавиатуры звучит как подпись, а не как запись —
          // и кнопки подтверждения, которая объясняла бы это, больше нет.
          b.setAttribute("aria-label", `Записаться на ${time}`);
          b.addEventListener("click", () => book(time));
          slotGrid.appendChild(b);
        });
      }

      async function load() {
        byDate = new Map();
        failed = false;
        slotGrid.innerHTML = "";
        if (dayLabel) dayLabel.textContent = "";
        setStatus("Смотрим свободное время…");

        const dates = windowDates();
        try {
          const availability = await fetchAvailableSlots(
            doctorId,
            typePicker.current().id,
            isoDate(dates[0]),
            isoDate(dates[dates.length - 1]),
          );
          availability.forEach((day) => {
            const times = day.slots.filter((s) => s.available).map((s) => s.start_time.slice(0, 5));
            if (times.length === 0) return;
            byDate.set(day.date, {
              workPlaceId: day.workplace.id,
              workplaceName: day.workplace.name,
              times,
            });
          });
        } catch {
          // Сеть, а не отсутствие слотов: показывать «всё занято» здесь было бы
          // ложью, и в ленту это место уходит как «неизвестно», а не как «пусто».
          failed = true;
          setStatus('Не удалось загрузить расписание. <button type="button" data-el="retry" class="hm-retry">Повторить</button>');
          root.querySelector('[data-el="retry"]')?.addEventListener("click", () => void load());
          rail.publish(placeId, null);
          return;
        }

        rail.publish(placeId, new Set(byDate.keys()));
        renderSlots();
      }

      rail.subscribe(renderSlots);
      // Смена вида приёма меняет длительность, а с ней и всю сетку времени:
      // доступность переспрашиваем целиком, а не пересчитываем на клиенте.
      typePicker.subscribe(() => void load());

      return { load };
    }

    const railEl = section.querySelector('[data-el="day-rail"]');
    const rail = railEl === null ? null : createRail(railEl);
    if (rail === null) return;
    // Сначала подписки, потом счёт, и только потом запросы: лента должна знать,
    // сколько мест ждать, раньше, чем придёт первый ответ.
    const places = blocks.map((block) => initPlace(block, rail)).filter((place) => place !== null);
    rail.expect(places.length);
    places.forEach((place) => void place.load());
  })();
</script>
