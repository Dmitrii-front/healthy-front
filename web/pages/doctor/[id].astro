---
import BaseLayout from "../../layouts/BaseLayout.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import BookingTrigger from "../../components/booking/BookingTrigger.astro";
import BookingModal from "../../components/booking/BookingModal.astro";
import { searchDoctors, getDoctorProfile, formatPriceKgs } from "@/entities/doctor";
import { SPECIALTIES } from "@/shared/config";
import { doctorSlug } from "../../lib/slug";

export async function getStaticPaths() {
  const catalog = await searchDoctors();
  const paths = await Promise.all(
    catalog.map(async (item) => {
      // Поиск не отдаёт ни мест работы, ни стажа, ни образования — за ними
      // приходится идти в полный профиль на каждого врача.
      const doctor = await getDoctorProfile(item.id);
      return doctor === null
        ? null
        : {
            params: { id: doctorSlug({ id: doctor.id, name: doctor.fullName }) },
            props: { doctor },
          };
    }),
  );
  // Профиль мог не открыться при живом поиске — такого врача пропускаем,
  // getDoctorProfile уже написал предупреждение в лог сборки.
  return paths.filter((path) => path !== null);
}

const { doctor } = Astro.props;

const specialty = SPECIALTIES.find((s) => s.doctorSpecialty === doctor.specialization);
const clinicName = doctor.workplaces[0]?.name ?? null;
// Врач часто принимает в нескольких местах, и первое из них ничем не выделено:
// в шапке перечисляем все, а не одно произвольное.
const workplaceNames = doctor.workplaces.map((place) => place.name);
// В meta description оставляем одно место: у строки бюджет ~155 символов,
// перечисление трёх клиник его съест и обрежет сниппет в выдаче.
const description = doctor.bio
  ? doctor.bio.slice(0, 155) + (doctor.bio.length > 155 ? "…" : "")
  : `${doctor.fullName} — ${doctor.specialization}${clinicName ? ` в клинике «${clinicName}»` : ""}. Запись онлайн.`;

// ── Display helpers ────────────────────────────────────────────────
// Названия месяцев и дней недели живут в клиентском скрипте: сетку календаря
// теперь рисует он, а не сборка.
function pluralYears(n: number): string {
  const m10 = n % 10;
  const m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return "год";
  if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return "года";
  return "лет";
}

const priceLabel = formatPriceKgs(doctor.priceFrom);

// "О враче" always renders. When the doctor has no written bio, compose a
// truthful intro from the fields we do have (no invented medical claims).
const bioText =
  doctor.bio ??
  [
    `${doctor.specialization}${doctor.subspecializations.length > 0 ? `, ${doctor.subspecializations.join(", ").toLowerCase()}` : ""}.`,
    doctor.yearsExperience !== null
      ? `Опыт работы — ${doctor.yearsExperience} ${pluralYears(doctor.yearsExperience)}.`
      : "",
    workplaceNames.length > 0
      ? `Принимает: ${workplaceNames.join(", ")}${doctor.city ? ` (${doctor.city})` : ""}.`
      : "",
  ]
    .filter(Boolean)
    .join(" ");

// Тизер описания в шапке. Режем по последнему пробелу до лимита, а не ровно по
// 250-му символу: иначе строка обрывается посередине слова. Хвостовую пунктуацию
// снимаем, чтобы не получить «…, …».
const BIO_PREVIEW_LIMIT = 250;
const bioTruncated = bioText.length > BIO_PREVIEW_LIMIT;
const bioPreview = bioTruncated
  ? `${bioText
      .slice(
        0,
        // Пробела может не быть вовсе (одно длинное слово) — тогда режем по лимиту.
        bioText.lastIndexOf(" ", BIO_PREVIEW_LIMIT) > 0
          ? bioText.lastIndexOf(" ", BIO_PREVIEW_LIMIT)
          : BIO_PREVIEW_LIMIT,
      )
      .replace(/[\s,;:.—-]+$/u, "")}…`
  : bioText;
// ── Места приёма ───────────────────────────────────────────────────
// Место — не шаг выбора: у каждого места свой календарь, и все они открыты
// сразу. Так видно, где есть время, без перебора, и нельзя записаться не в ту
// клинику. Вид приёма живёт внутри места, потому что appointment_type
// принадлежит work_place и задаёт длительность слота.
const typesByPlace = new Map<string, typeof doctor.appointmentTypes>();
for (const type of doctor.appointmentTypes) {
  const list = typesByPlace.get(type.workPlaceId);
  if (list === undefined) typesByPlace.set(type.workPlaceId, [type]);
  else list.push(type);
}

// Поиск в списке видов приёма включаем только когда их много. Поле с вводом на
// телефоне поднимает клавиатуру от одного тапа, и при двух-трёх вариантах она
// закрывает половину экрана ради выбора, который делается одним касанием. Ниже
// порога поле остаётся readonly и работает как обычный дропдаун: клавиатуры нет,
// стрелки и Enter — есть.
const TYPE_SEARCH_FROM = 6;

const placeBlocks = doctor.workplaces.map((place) => {
  const types = typesByPlace.get(place.id) ?? [];
  const address = place.address ?? "";
  return {
    ...place,
    types,
    // Единственную услугу на странице не показываем — выбирать нечего. Но её
    // id и длительность нужны запросу слотов, и они уезжают в data-атрибуты
    // карточки места.
    soleType: types.length === 1 ? (types[0] ?? null) : null,
    // Начальное значение поля выбора: до первого клика выбран первый тип, и
    // именно за его слотами уходит первый запрос.
    firstType: types[0] ?? null,
    searchable: types.length >= TYPE_SEARCH_FROM,
    // 2ГИС Кыргызстана, не Казахстана: клиники каталога — Бишкек и Ош, и на .kz
    // тот же запрос искал бы улицу в чужой стране. Город дописываем только если
    // его нет в адресе, иначе в запрос уезжает «…, Бишкек, Бишкек».
    mapUrl: `https://2gis.kg/search/${encodeURIComponent(
      [place.name, address, address.includes(doctor.city) ? "" : doctor.city]
        .filter(Boolean)
        .join(", "),
    )}`,
  };
});

// Ни одного места — врач не заполнил профиль. Места есть, а видов приёма ни в
// одном нет — не открыл онлайн-запись. Оба случая показываем текстом: пустая
// сетка календаря соврала бы, что всё занято.
const bookingOpen = placeBlocks.some((place) => place.types.length > 0);

// Выбора формата на странице нет: все записи уходят как офлайн (is_online:
// false). Бэкенд к тому же отдаёт словарь непоследовательно — "offline"/"online"
// в сидах и null у прод-врачей, — так что тумблер всё равно опирался бы на
// ненадёжное поле. consultation_formats остаётся в слое данных.

// ── SEO structured data (Physician + breadcrumbs) ──────────────────
const physicianJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Physician",
  name: doctor.fullName,
  medicalSpecialty: doctor.specialization,
  // Места работы попадают в разметку, только если врач их завёл: выдумывать
  // организацию ради заполненного поля нельзя — это structured data для поисковика.
  // Мест может быть несколько, и worksFor по схеме допускает массив: раньше
  // сюда уезжало только первое, и разметка противоречила видимой странице.
  ...(doctor.workplaces.length > 0
    ? {
        worksFor: doctor.workplaces.map((place) => ({
          "@type": "MedicalOrganization",
          name: place.name,
          address: place.address,
        })),
      }
    : {}),
  ...(doctor.education ? { alumniOf: doctor.education } : {}),
  ...(doctor.languages.length > 0 ? { knowsLanguage: doctor.languages } : {}),
  ...(doctor.rating !== null
    ? {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: doctor.rating,
          reviewCount: doctor.reviewsCount,
          bestRating: 5,
          worstRating: 1,
        },
      }
    : {}),
};

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: "https://sdoctorom.health/" },
    { "@type": "ListItem", position: 2, name: "Поиск", item: "https://sdoctorom.health/search" },
    ...(specialty
      ? [
          {
            "@type": "ListItem",
            position: 3,
            name: specialty.label,
            item: `https://sdoctorom.health/search?specialty=${encodeURIComponent(specialty.doctorSpecialty)}`,
          },
          { "@type": "ListItem", position: 4, name: doctor.fullName },
        ]
      : [{ "@type": "ListItem", position: 3, name: doctor.fullName }]),
  ],
};
---

<BaseLayout title={`${doctor.fullName} — ${doctor.specialization} | Healthy`} description={description}>
  <div class="min-h-dvh bg-[#faf8f5]">
    <main class="mx-auto max-w-[960px] px-4 pb-16 pt-5 sm:px-8">
      {/* Breadcrumbs */}
      <nav class="mb-5 text-[12.5px] text-[#8a8e96]">
        <a href="/" class="hover:text-[#2a2d33]">Главная</a>
        <span class="mx-1.5">›</span>
        {specialty ? (
          <>
            <a href={`/search?specialty=${encodeURIComponent(specialty.doctorSpecialty)}`} class="hover:text-[#2a2d33]">{specialty.label}</a>
            <span class="mx-1.5">›</span>
          </>
        ) : (
          <>
            <a href="/search" class="hover:text-[#2a2d33]">Поиск</a>
            <span class="mx-1.5">›</span>
          </>
        )}
        <span class="text-[#2a2d33]">{doctor.fullName}</span>
      </nav>

      <div class="flex flex-col gap-6">
        {/* ── Hero ─────────────────────────────────────────── */}
        <section class="grid grid-cols-1 gap-7 rounded-[24px] border border-[#edebe6] bg-white p-6 sm:grid-cols-[140px_1fr] sm:p-7">
          {doctor.avatarUrl ? (
            <img
              src={doctor.avatarUrl}
              alt={doctor.fullName}
              width="140"
              height="140"
              class="h-[140px] w-[140px] rounded-[20px] object-cover"
            />
          ) : (
            <span
              class="flex h-[140px] w-[140px] items-center justify-center rounded-[20px] text-[40px] font-semibold tracking-[0.01em] text-[#0f1115]"
              style={`background-color: ${doctor.avatarColor}`}
            >
              {doctor.initials}
            </span>
          )}

          <div class="flex min-w-0 flex-col gap-3">
            <div>
              <h1 class="text-[26px] font-bold leading-[1.1] tracking-[-0.02em] text-[#0f1115] text-pretty">
                {doctor.fullName}
              </h1>
              <p class="mt-1.5 text-[14px] font-medium text-[#2a2d33]">
                {doctor.specialization}{doctor.subspecializations.length > 0 ? `, ${doctor.subspecializations.join(", ").toLowerCase()}` : ""}
              </p>
            </div>

            <div class="mt-0.5 flex flex-col gap-1.5 text-[13px] text-[#2a2d33]">
              {/* Верификация без проверки статуса: в каталог попадают только
                  проверенные врачи, так что доступность врача и есть верификация. */}
              <span class="hm-chip inline-flex w-fit items-center gap-1.5 rounded-full">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="shrink-0">
                  <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3z" /><path d="M9 12l2 2 4-4" />
                </svg>
                Документы проверены
              </span>
              {/* Места в столбик: перечисление через запятую сливалось в абзац,
                  по которому не видно, сколько их вообще. Пин на каждой строке —
                  тот же, что у адресов ниже: без него это просто текст. */}
              {workplaceNames.map((name) => (
                <span class="flex items-start gap-1.5">
                  <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true" class="hm-pin mt-[3px] shrink-0">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" />
                    </svg>
                  <span>{name}</span>
                </span>
              ))}
            </div>

            {/* Цена, стаж и языки — здесь, а не в «О враче»: это то, по чему
                пациент отсеивает врача, и смотрит он на это сразу. Цена первой:
                по ней отказываются чаще всего, а стаж и языки уже уточняют
                выбор. Обёртку рендерим только при непустом содержимом, иначе
                останется голая линия.

                Стаж переехал сюда из мета-колонки над ней: там он был
                единственной строкой без иконки — между пилюлей верификации и
                местами с пинами — и проваливался. Здесь он однотипен цене:
                подпись капсом, значение числом. Колонки auto auto 1fr — цене и
                стажу хватает своей ширины, остаток забирают языки, которым его
                и не хватало. */}
            {(priceLabel || doctor.yearsExperience != null || doctor.languages.length > 0) && (
              <dl class="mt-1 grid grid-cols-1 gap-y-4 border-t border-[#edebe6] pt-4 sm:grid-cols-[auto_auto_1fr] sm:gap-x-9">
                {priceLabel && (
                  <div>
                    <dt class="text-[11px] font-bold uppercase tracking-[0.08em] text-[#8a8e96]">
                      Стоимость приёма
                    </dt>
                    <dd class="mt-1.5 text-[15px] text-[#2a2d33]">
                      от <span class="font-bold text-[#0f1115]">{priceLabel}</span>
                    </dd>
                  </div>
                )}

                {doctor.yearsExperience != null && (
                  <div>
                    <dt class="text-[11px] font-bold uppercase tracking-[0.08em] text-[#8a8e96]">
                      Стаж
                    </dt>
                    <dd class="mt-1.5 whitespace-nowrap text-[15px] text-[#2a2d33]">
                      <span class="hm-tenure-num">{doctor.yearsExperience}</span> {pluralYears(doctor.yearsExperience)}
                    </dd>
                  </div>
                )}

                {doctor.languages.length > 0 && (
                  <div>
                    <dt class="text-[11px] font-bold uppercase tracking-[0.08em] text-[#8a8e96]">
                      Языки приёма
                    </dt>
                    <dd class="mt-1.5 text-[14px] text-[#2a2d33]">{doctor.languages.join(", ")}</dd>
                  </div>
                )}
              </dl>
            )}

            {/* Тизер описания. «ещё» — обычная ссылка на #about: скроллит без
                JS, доступна с клавиатуры и работает до гидратации. Плавность
                даёт scroll-behavior в стилях страницы. */}
            <div class="mt-1 border-t border-[#edebe6] pt-4">
              <p class="text-[14px] leading-[1.7] text-[#2a2d33] text-pretty">
                {bioPreview}
                {bioTruncated && (
                  <a href="#about" class="hm-more-link">ещё</a>
                )}
              </p>
            </div>
          </div>
        </section>

        {/* ── Booking: одно место — один блок, все открыты сразу ─ */}
        <section
          id="booking"
          data-doctor-id={doctor.id}
          class="flex flex-col gap-4"
        >
          {/* Пустые состояния: карточек мест в этих случаях нет, а молчать
              нельзя — пациент должен понять, почему нет ни одного календаря. */}
          {placeBlocks.length === 0 && (
            <div class="rounded-[24px] border border-[#edebe6] bg-white p-6 sm:p-7">
              <p class="hm-empty-day">
                Врач пока не указал, где принимает.<br />
                Записаться онлайн не получится.
              </p>
            </div>
          )}
          {placeBlocks.length > 0 && !bookingOpen && (
            <div class="rounded-[24px] border border-[#edebe6] bg-white p-6 sm:p-7">
              <p class="hm-empty-day">
                Врач пока не открыл запись онлайн.<br />
                Свяжитесь с клиникой, чтобы договориться о приёме.
              </p>
            </div>
          )}

          {/* Дата — одна на всю запись. У мест расписание разное, но выбирает
              пациент день, а не место: три отдельные ленты заставляли делать
              один и тот же выбор трижды и сравнивать места по памяти. Точка на
              дне значит «свободно хотя бы где-то» — в каком именно месте,
              видно уже по карточкам ниже. */}
          {bookingOpen && (
            <div
              data-el="day-rail"
              class="hm-rail -mx-4 border-y border-[#edebe6] bg-white px-4 py-2.5 top-0 sm:mx-0 sm:rounded-[24px] sm:border sm:px-7 sm:py-5 sm:top-3"
            >
              <div class="mb-1.5 flex items-end justify-between gap-3 sm:mb-3">
                <div class="text-[11px] font-bold uppercase tracking-[0.08em] text-[#8a8e96]">Дата записи</div>
                <div class="flex shrink-0 items-center gap-2">
                  <div class="text-[12px] font-bold text-[#0f1115] capitalize sm:text-[13px]" data-el="month-label"></div>
                  {/* Стрелки — только на мышке: на тач-экране их заменяет свайп,
                      а 30px высоты они забирают у самой ленты. */}
                  <div class="hidden items-center gap-1 sm:flex">
                    <button type="button" data-el="day-prev" class="hm-day-nav" aria-label="Предыдущие дни" hidden>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 18l-6-6 6-6" /></svg>
                    </button>
                    <button type="button" data-el="day-next" class="hm-day-nav" aria-label="Следующие дни" hidden>
                      <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
                    </button>
                  </div>
                </div>
              </div>
              <div class="hm-day-track" data-el="day-track" role="group" aria-label="Дата записи"></div>
            </div>
          )}

          {placeBlocks.map((place) => (
            <article
              data-el="place-block"
              data-place-id={place.id}
              data-sole-type-id={place.soleType?.id}
              data-sole-type-name={place.soleType?.name}
              data-sole-duration={place.soleType ? String(place.soleType.durationMin) : undefined}
              class="grid grid-cols-1 gap-6 rounded-[24px] border border-[#edebe6] bg-white p-6 sm:p-7 md:grid-cols-[minmax(0,280px)_1fr] md:gap-8"
            >
              {/* Слева — куда ехать и с каким видом приёма, справа — время.
                  Вертикально «адрес → тип → сетка времени» растягивало каждую
                  карточку на экран, а мест у врача до трёх. */}
              <div class="min-w-0">
                <h3 class="text-[16px] font-bold tracking-[-0.015em] text-[#0f1115]">{place.name}</h3>
                {/* Ссылкой стал сам адрес: отдельная кнопка «На карте» повторяла
                    строчкой ниже то, что уже написано в адресе. Подчёркивание
                    только на ховере — цветом адрес не выделяем, он читается как
                    текст, а не как действие. Имя для скринридера дописываем:
                    в видимом тексте не сказано, что ссылка ведёт на карту. */}
                <a
                  href={place.mapUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label={`${place.address} — на карте`}
                  class="hm-address mt-0.5 flex w-fit items-start gap-1.5 py-1 text-[13px] text-[#2a2d33]"
                >
                  <svg width="13" height="13" viewBox="0 0 24 24" aria-hidden="true" class="hm-pin mt-[3px] shrink-0">
                    <path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7zm0 9.5a2.5 2.5 0 1 1 0-5 2.5 2.5 0 0 1 0 5z" />
                    </svg>
                  <span>{place.address}</span>
                </a>
                {place.description && (
                  <p class="mt-1.5 text-[13px] leading-relaxed text-[#8a8e96]">{place.description}</p>
                )}

                {/* Карта — только настоящая, отрендеренная бэкендом. Пин ставит сам
                    врач: не поставил — карты нет, декоративную подсовывать нельзя. */}
                {place.mapImageUrl && (
                  <img
                    src={place.mapImageUrl}
                    alt={`Расположение: ${place.name}`}
                    loading="lazy"
                    class="mt-4 h-[150px] w-full rounded-[14px] border border-[#edebe6] object-cover"
                  />
                )}

                {/* Единственная услуга — не выбор, а факт: показывать её вместе с
                    подписью значит занимать блок сообщением «вариант один». Её
                    название и длительность всё равно нужны для запроса слотов, но
                    живут в data-атрибутах карточки, а не в вёрстке. */}
                {place.types.length > 1 && (
                  <div class="mt-4 border-t border-[#edebe6] pt-4">
                    <div
                      id={`type-label-${place.id}`}
                      class="mb-2 text-[11px] font-bold uppercase tracking-[0.08em] text-[#8a8e96]"
                    >
                      Услуги
                    </div>
                    <div class="hm-combo" data-el="type-combo">
