---
import BaseLayout from "../../layouts/BaseLayout.astro";
import JsonLd from "../../components/seo/JsonLd.astro";
import BookingTrigger from "../../components/booking/BookingTrigger.astro";
import BookingModal from "../../components/booking/BookingModal.astro";
import { searchDoctors, getDoctorProfile, formatPriceKgs } from "@/entities/doctor";
import { SPECIALTIES } from "@/shared/config";
import { doctorSlug } from "../../lib/slug";

export async function getStaticPaths() {
  const catalog = await searchDoctors();
  const paths = await Promise.all(
    catalog.map(async (item) => {
      // Поиск не отдаёт ни мест работы, ни стажа, ни образования — за ними
      // приходится идти в полный профиль на каждого врача.
      const doctor = await getDoctorProfile(item.id);
      return doctor === null
        ? null
        : {
            params: { id: doctorSlug({ id: doctor.id, name: doctor.fullName }) },
            props: { doctor },
          };
    }),
  );
  // Профиль мог не открыться при живом поиске — такого врача пропускаем,
  // getDoctorProfile уже написал предупреждение в лог сборки.
  return paths.filter((path) => path !== null);
}

const { doctor } = Astro.props;

const specialty = SPECIALTIES.find((s) => s.doctorSpecialty === doctor.specialization);
const workplace = doctor.workplaces[0] ?? null;
const clinicName = workplace?.name ?? null;
const description = doctor.bio
  ? doctor.bio.slice(0, 155) + (doctor.bio.length > 155 ? "…" : "")
  : `${doctor.fullName} — ${doctor.specialization}${clinicName ? ` в клинике «${clinicName}»` : ""}. Запись онлайн.`;

// ── Display helpers ────────────────────────────────────────────────
// Названия месяцев и дней недели живут в клиентском скрипте: сетку календаря
// теперь рисует он, а не сборка.
function pluralYears(n: number): string {
  const m10 = n % 10;
  const m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return "год";
  if (m10 >= 2 && m10 <= 4 && (m100 < 10 || m100 >= 20)) return "года";
  return "лет";
}

const priceLabel = formatPriceKgs(doctor.priceFrom);

// "О враче" always renders. When the doctor has no written bio, compose a
// truthful intro from the fields we do have (no invented medical claims).
const bioText =
  doctor.bio ??
  [
    `${doctor.specialization}${doctor.subspecializations.length > 0 ? `, ${doctor.subspecializations.join(", ").toLowerCase()}` : ""}.`,
    doctor.yearsExperience !== null
      ? `Опыт работы — ${doctor.yearsExperience} ${pluralYears(doctor.yearsExperience)}.`
      : "",
    clinicName ? `Принимает в клинике ${clinicName}${doctor.city ? `, ${doctor.city}` : ""}.` : "",
  ]
    .filter(Boolean)
    .join(" ");
const mapQuery = encodeURIComponent(
  [clinicName, workplace?.address, doctor.city].filter(Boolean).join(", "),
);

// ── Виды приёма ────────────────────────────────────────────────────
// Место приёма не выбирается отдельно: бэкенд выводит его из вида приёма
// (available-slots берёт work_place_id из типа), поэтому чип сразу показывает
// и длительность, и клинику.
const workplaceNameById = new Map(doctor.workplaces.map((w) => [w.id, w.name]));
const typeOptions = doctor.appointmentTypes.map((type) => ({
  id: type.id,
  name: type.name,
  durationMin: type.durationMin,
  workPlaceId: type.workPlaceId,
  workplaceName: workplaceNameById.get(type.workPlaceId) ?? null,
}));

// Пустой список — не ошибка: врач просто не открыл запись. Календарь в этом
// случае не рендерим вовсе, чтобы не показывать вечно пустую сетку.
const bookingOpen = typeOptions.length > 0;

// Бэкенд отдаёт формат словарём "offline"/"online" (сиды) либо null (прод), а
// прежняя фронтовая схема ждала "in-person"/"online". Единственное, что можно
// проверить надёжно, — присутствие "online"; нет его, значит записи онлайн нет,
// и тумблер не показываем, а is_online уходит false.
const onlineAvailable = doctor.consultationFormats.includes("online");

// ── SEO structured data (Physician + breadcrumbs) ──────────────────
const physicianJsonLd: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Physician",
  name: doctor.fullName,
  medicalSpecialty: doctor.specialization,
  // Место работы попадает в разметку, только если врач его завёл: выдумывать
  // организацию ради заполненного поля нельзя — это structured data для поисковика.
  ...(workplace
    ? {
        worksFor: {
          "@type": "MedicalOrganization",
          name: workplace.name,
          address: workplace.address,
        },
      }
    : {}),
  ...(doctor.education ? { alumniOf: doctor.education } : {}),
  ...(doctor.languages.length > 0 ? { knowsLanguage: doctor.languages } : {}),
  ...(doctor.rating !== null
    ? {
        aggregateRating: {
          "@type": "AggregateRating",
          ratingValue: doctor.rating,
          reviewCount: doctor.reviewsCount,
          bestRating: 5,
          worstRating: 1,
        },
      }
    : {}),
};

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: "https://sdoctorom.health/" },
    { "@type": "ListItem", position: 2, name: "Поиск", item: "https://sdoctorom.health/search" },
    ...(specialty
      ? [
          {
            "@type": "ListItem",
            position: 3,
            name: specialty.label,
            item: `https://sdoctorom.health/search?specialty=${encodeURIComponent(specialty.doctorSpecialty)}`,
          },
          { "@type": "ListItem", position: 4, name: doctor.fullName },
        ]
      : [{ "@type": "ListItem", position: 3, name: doctor.fullName }]),
  ],
};
---

<BaseLayout title={`${doctor.fullName} — ${doctor.specialization} | Healthy`} description={description}>
  <div class="min-h-dvh bg-[#faf8f5]">
    <main class="mx-auto max-w-[960px] px-4 pb-16 pt-5 sm:px-8">
      {/* Breadcrumbs */}
      <nav class="mb-5 text-[12.5px] text-[#8a8e96]">
        <a href="/" class="hover:text-[#2a2d33]">Главная</a>
        <span class="mx-1.5">›</span>
        {specialty ? (
          <>
            <a href={`/search?specialty=${encodeURIComponent(specialty.doctorSpecialty)}`} class="hover:text-[#2a2d33]">{specialty.label}</a>
            <span class="mx-1.5">›</span>
          </>
        ) : (
          <>
            <a href="/search" class="hover:text-[#2a2d33]">Поиск</a>
            <span class="mx-1.5">›</span>
          </>
        )}
        <span class="text-[#2a2d33]">{doctor.fullName}</span>
      </nav>

      <div class="flex flex-col gap-6">
        {/* ── Hero ─────────────────────────────────────────── */}
        <section class="grid grid-cols-1 gap-7 rounded-[24px] border border-[#edebe6] bg-white p-6 sm:grid-cols-[140px_1fr] sm:p-7">
          {doctor.avatarUrl ? (
            <img
              src={doctor.avatarUrl}
              alt={doctor.fullName}
              width="140"
              height="140"
              class="h-[140px] w-[140px] rounded-[20px] object-cover"
            />
          ) : (
            <span
              class="flex h-[140px] w-[140px] items-center justify-center rounded-[20px] text-[40px] font-semibold tracking-[0.01em] text-[#0f1115]"
              style={`background-color: ${doctor.avatarColor}`}
            >
              {doctor.initials}
            </span>
          )}

          <div class="flex min-w-0 flex-col gap-3">
            <span class="inline-flex w-fit items-center gap-1.5 rounded-full bg-[#eef6f8] px-2.5 py-[5px] text-[12px] font-bold tracking-[0.02em] text-[#0e7c8c]">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6l-8-3z" /><path d="M9 12l2 2 4-4" />
              </svg>
              Документы проверены
            </span>

            <div>
              <h1 class="text-[26px] font-bold leading-[1.1] tracking-[-0.02em] text-[#0f1115] text-pretty">
                {doctor.fullName}
              </h1>
              <p class="mt-1.5 text-[14px] font-medium text-[#2a2d33]">
                {doctor.specialization}{doctor.subspecializations.length > 0 ? `, ${doctor.subspecializations.join(", ").toLowerCase()}` : ""}
              </p>
            </div>

            <div class="mt-0.5 flex flex-wrap items-center gap-x-5 gap-y-1.5 text-[13px] text-[#2a2d33]">
              {doctor.yearsExperience != null && (
                <span><strong class="font-semibold text-[#0f1115]">{doctor.yearsExperience}</strong> {pluralYears(doctor.yearsExperience)} стажа</span>
              )}
              {doctor.rating != null && (
                <span>
                  <strong class="font-semibold text-[#0f1115]">★ {doctor.rating.toFixed(1)}</strong>
                  {doctor.reviewsCount ? <span class="text-[#8a8e96]"> · {doctor.reviewsCount} отзывов</span> : null}
                </span>
              )}
              {clinicName && <span class="text-[#2a2d33]">{clinicName}</span>}
            </div>
          </div>
        </section>

        {/* ── Booking (inline) ─────────────────────────────── */}
        <section
          id="booking"
          data-doctor-id={doctor.id}
          data-online-available={onlineAvailable ? "1" : "0"}
          class="rounded-[24px] border border-[#edebe6] bg-white p-6 sm:p-7"
        >
          <div class="flex flex-wrap items-end justify-between gap-3">
            <div>
              <h2 class="text-[18px] font-bold tracking-[-0.015em] text-[#0f1115]">Записаться на приём</h2>
              {priceLabel && (
                <p class="mt-1 text-[13px] text-[#8a8e96]">
                  от <span class="font-bold text-[#0f1115]">{priceLabel}</span>
                </p>
              )}
              {doctor.scheduleNote && (
                <p class="mt-2 inline-flex items-center gap-1.5 text-[12px] text-[#2a2d33]">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#8a8e96" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect x="3" y="5" width="18" height="16" rx="2" /><path d="M3 9h18" /><path d="M8 3v4M16 3v4" />
                  </svg>
                  {doctor.scheduleNote}
                </p>
              )}
            </div>
            <div class="flex flex-wrap gap-x-3 gap-y-1 text-[12px] text-[#2a2d33]">
              <span class="inline-flex items-center gap-1.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#3a8e64" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
                Без предоплаты
              </span>
              <span class="inline-flex items-center gap-1.5">
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="#3a8e64" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5L20 7" /></svg>
                Бесплатная отмена за 2 часа
              </span>
            </div>
          </div>

          {!bookingOpen ? (
            <p class="hm-empty-day mt-6">
              Врач пока не открыл запись онлайн.<br />
              Свяжитесь с клиникой, чтобы договориться о приёме.
            </p>
          ) : (
            <>
              {/* Вид приёма: задаёт и длительность слота, и место приёма */}
              <div class="mt-6">
                <div class="mb-2.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#8a8e96]">
                  Вид приёма
                </div>
                <div class="flex flex-wrap gap-2" data-el="type-row" role="tablist">
                  {typeOptions.map((type, i) => (
                    <button
                      type="button"
                      role="tab"
                      data-type-id={type.id}
                      data-work-place-id={type.workPlaceId}
                      data-type-name={type.name}
                      data-duration={String(type.durationMin)}
                      data-workplace-name={type.workplaceName ?? ""}
                      aria-selected={i === 0 ? "true" : "false"}
                      class="hm-type-chip rounded-full border px-[14px] py-[9px] text-left text-[13px] font-semibold"
                    >
                      {type.name}
                      <span class="hm-type-chip-meta">
                        {type.durationMin} мин{type.workplaceName ? ` · ${type.workplaceName}` : ""}
                      </span>
                    </button>
                  ))}
                </div>
              </div>

              {onlineAvailable && (
                <div class="mt-5">
                  <div class="mb-2.5 text-[11px] font-bold uppercase tracking-[0.08em] text-[#8a8e96]">
                    Формат
                  </div>
                  <div class="flex gap-2" data-el="format-row" role="tablist">
                    <button type="button" role="tab" data-online="0" aria-selected="true"
                      class="hm-type-chip rounded-full border px-[14px] py-[9px] text-[13px] font-semibold">В клинике</button>
                    <button type="button" role="tab" data-online="1" aria-selected="false"
                      class="hm-type-chip rounded-full border px-[14px] py-[9px] text-[13px] font-semibold">Онлайн по видео</button>
                  </div>
                </div>
              )}

              <div class="mt-6 grid grid-cols-1 items-start gap-8 md:grid-cols-[minmax(0,360px)_1fr]">
                {/* Календарь: сетка рисуется на клиенте по реальной доступности */}
                <div>
                  <div class="mb-2.5 flex items-center justify-between">
                    <div class="text-[13px] font-bold text-[#0f1115] capitalize" data-el="month-label"></div>
                  </div>
                  <div class="mb-1 grid grid-cols-7 gap-0.5">
                    {["пн", "вт", "ср", "чт", "пт", "сб", "вс"].map((w, i) => (
                      <div class={`py-0.5 text-center text-[10px] font-bold uppercase tracking-[0.04em] ${i >= 5 ? "text-[#b5b8bd]" : "text-[#8a8e96]"}`}>{w}</div>
                    ))}
                  </div>
                  <div class="grid grid-cols-7 gap-1" data-el="day-grid"></div>
                </div>

                {/* Слоты */}
                <div class="min-w-0">
                  <div class="flex items-baseline justify-between border-b border-[#edebe6] pb-3">
                    <div>
                      <div class="text-[11px] font-bold uppercase tracking-[0.08em] text-[#8a8e96]">Свободное время</div>
                      <div class="mt-1 text-[18px] font-bold tracking-[-0.015em] text-[#0f1115]" data-el="slot-day-label"></div>
                    </div>
                    <div class="text-[12px] text-[#8a8e96]" data-el="slot-count"></div>
                  </div>

                  <div class="mt-4 grid grid-cols-[repeat(auto-fill,minmax(78px,1fr))] gap-2" data-el="slot-grid"></div>
                  <p class="hm-empty-day mt-4" data-el="slot-status" hidden></p>

                  <button type="button" data-el="cta" disabled class="hm-book-cta mt-5 inline-flex h-[52px] w-full items-center justify-center gap-2.5 rounded-[12px] text-[15px] font-bold">
                    Выберите время
                  </button>
                </div>
              </div>

              {/* Скрытый триггер: инлайн-CTA открывает через него общий шит */}
              <span class="sr-only">
                <BookingTrigger
                  doctorId={doctor.id}
                  doctorName={doctor.fullName}
                  doctorSpecialty={doctor.specialization}
                  doctorClinic={clinicName ?? ""}
                  label="Записаться"
                />
              </span>
            </>
          )}
        </section>

        {/* ── Where / map ──────────────────────────────────── */}
        {/* Врач мог не завести рабочее место — тогда «Где принимает» показывать нечем. */}
        {workplace && (
        <section class="grid grid-cols-1 overflow-hidden rounded-[24px] border border-[#edebe6] bg-white md:grid-cols-[1.2fr_1fr]">
          <div class="relative min-h-[260px] bg-[#eaf2f4]">
            <svg width="100%" height="100%" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice" class="absolute inset-0" aria-hidden="true">
              <defs>
                <pattern id="dgrid" width="6" height="6" patternUnits="userSpaceOnUse">
                  <path d="M 6 0 L 0 0 0 6" fill="none" stroke="rgba(14,124,140,0.08)" stroke-width="0.15" />
                </pattern>
                <radialGradient id="dmap" cx="50%" cy="50%" r="60%">
                  <stop offset="0%" stop-color="#d2e4e8" /><stop offset="100%" stop-color="#eaf2f4" />
                </radialGradient>
              </defs>
              <rect width="100" height="100" fill="url(#dmap)" />
              <rect width="100" height="100" fill="url(#dgrid)" />
              <path d="M0 50 Q 30 45 50 50 T 100 48" fill="none" stroke="rgba(255,255,255,0.9)" stroke-width="1.4" />
              <path d="M50 0 Q 48 30 50 50 T 52 100" fill="none" stroke="rgba(255,255,255,0.9)" stroke-width="1.4" />
              <ellipse cx="35" cy="35" rx="6" ry="4" fill="#cfe0cc" opacity="0.7" />
              <ellipse cx="70" cy="65" rx="8" ry="5" fill="#cfe0cc" opacity="0.7" />
            </svg>
            <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-full">
              <div class="flex items-center gap-2 whitespace-nowrap rounded-[14px] bg-[#0e7c8c] px-3.5 py-2.5 text-[12px] font-bold text-white shadow-[0_12px_28px_rgba(10,31,37,0.25)]">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 21h18" /><path d="M5 21V7l7-4 7 4v14" /></svg>
                {clinicName ?? ""}
              </div>
            </div>
            {doctor.city && (
              <div class="absolute left-4 top-4 inline-flex items-center gap-2 rounded-[10px] bg-white/95 px-3 py-2 text-[12px] font-semibold text-[#0f1115] backdrop-blur-sm">
                <span class="h-2.5 w-2.5 rounded-full bg-[#e8b96a]"></span>
                {doctor.city}
              </div>
            )}
          </div>

          <div class="flex flex-col gap-3.5 p-7">
            <h2 class="text-[18px] font-bold tracking-[-0.015em] text-[#0f1115]">Где принимает</h2>
            <div class="text-[16px] font-bold text-[#0f1115]">{clinicName ?? ""}</div>
            <div class="text-[13px] leading-relaxed text-[#2a2d33]">
              {workplace?.address && <>{workplace.address}<br /></>}
              {workplace?.description && <>{workplace.description}</>}
            </div>
            <a
              href={`https://2gis.kz/search/${mapQuery}`}
              target="_blank"
              rel="noopener noreferrer"
              class="mt-1 inline-flex h-[42px] w-fit items-center gap-2 rounded-full border border-[#e2e2df] px-[18px] text-[13px] font-semibold text-[#0f1115] transition-colors hover:border-[#b5b8bd]"
            >
              Построить маршрут
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 18l6-6-6-6" /></svg>
            </a>
          </div>
        </section>
        )}

        {/* ── О враче ──────────────────────────────────────── */}
        <section class="flex flex-col gap-4 rounded-[24px] border border-[#edebe6] bg-white p-6 sm:p-7">
          <h2 class="text-[18px] font-bold tracking-[-0.015em] text-[#0f1115]">О враче</h2>
          <p class="text-[14px] leading-[1.7] text-[#2a2d33] text-pretty">{bioText}</p>

          {doctor.languages.length > 0 && (
            <div class="flex flex-wrap gap-x-5 gap-y-2 pt-1 text-[13px] text-[#2a2d33]">
              <span class="inline-flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#8a8e96" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M2 12h20" /><path d="M12 2a14 14 0 0 1 0 20" /><path d="M12 2a14 14 0 0 0 0 20" /></svg>
                {doctor.languages.join(", ")}
              </span>
            </div>
          )}
        </section>

        {/* ── Образование ──────────────────────────────────── */}
        {doctor.education && (
          <section class="flex flex-col gap-5 rounded-[24px] border border-[#edebe6] bg-white p-6 sm:p-7">
            <h2 class="text-[18px] font-bold tracking-[-0.015em] text-[#0f1115]">Образование</h2>
            <p class="text-[14px] leading-[1.7] text-[#2a2d33] text-pretty">{doctor.education}</p>
          </section>
        )}
      </div>
    </main>
  </div>

  <JsonLd data={physicianJsonLd} />
  <JsonLd data={breadcrumbs} />
  <BookingModal />
</BaseLayout>

<style is:global>
  .hm-cal-day { color: #0f1115; cursor: pointer; transition: background-color 0.12s; }
  .hm-cal-day:hover:not([aria-pressed="true"]):not(:disabled) { background-color: #edebe6; }
  .hm-cal-day[aria-pressed="true"] { background-color: #0e7c8c; color: #fff; }
  .hm-cal-day[aria-pressed="true"] .hm-cal-dot { display: none; }
  .hm-cal-day:disabled { color: #b5b8bd; cursor: not-allowed; }
  .hm-slot { height: 46px; border: 1px solid #e2e2df; border-radius: 10px; background: #fff; color: #0f1115; font-weight: 600; font-size: 14px; cursor: pointer; transition: all 0.12s; }
  .hm-slot:hover { border-color: #0e7c8c; }
  .hm-slot[aria-pressed="true"] { background: #0e7c8c; border-color: #0e7c8c; color: #fff; }
  .hm-book-cta { background: #edebe6; color: #8a8e96; cursor: not-allowed; transition: all 0.15s; }
  .hm-book-cta[data-ready="1"] { background: #0e7c8c; color: #fff; cursor: pointer; box-shadow: 0 6px 18px rgba(14,124,140,0.25); }
  .hm-empty-day { padding: 24px 16px; border-radius: 12px; background: #faf8f5; font-size: 14px; color: #8a8e96; text-align: center; line-height: 1.5; }
  .hm-type-chip { display: flex; flex-direction: column; gap: 2px; border-color: #e2e2df; background: #fff; color: #0f1115; cursor: pointer; transition: border-color 0.12s, background-color 0.12s; }
  .hm-type-chip:hover { border-color: #b5b8bd; }
  .hm-type-chip[aria-selected="true"] { background: #0e7c8c; border-color: #0e7c8c; color: #fff; }
  .hm-type-chip-meta { font-size: 11px; font-weight: 600; color: #8a8e96; }
  .hm-type-chip[aria-selected="true"] .hm-type-chip-meta { color: rgba(255,255,255,0.75); }
  .hm-retry { margin-top: 8px; display: inline-block; border-bottom: 1px solid currentColor; color: #0e7c8c; font-weight: 600; cursor: pointer; background: none; border-width: 0 0 1px; padding: 0; }
</style>

<script>
  import { fetchAvailableSlots } from "../../lib/booking";

  // Слоты НЕЛЬЗЯ вшить в статическую страницу: доступность меняется постоянно,
  // а страница прегенерится на сборке. Поэтому календарь — клиентский остров,
  // читающий конфиг из data-атрибутов (define:vars инлайнится и не умеет import).
  (() => {
    const section = document.getElementById("booking");
    const doctorId = section?.dataset.doctorId ?? "";
    const dayGrid = section?.querySelector('[data-el="day-grid"]');
    const slotGrid = section?.querySelector('[data-el="slot-grid"]');
    const slotStatus = section?.querySelector('[data-el="slot-status"]');
    const monthLabel = section?.querySelector('[data-el="month-label"]');
    const dayLabel = section?.querySelector('[data-el="slot-day-label"]');
    const countEl = section?.querySelector('[data-el="slot-count"]');
    const cta = section?.querySelector('[data-el="cta"]');
    const typeChips = [...(section?.querySelectorAll("[data-type-id]") ?? [])];
    const formatChips = [...(section?.querySelectorAll("[data-online]") ?? [])];
    const trigger = section?.querySelector('[data-action="hm-book-open"]');
    if (!section || !dayGrid || !slotGrid || !cta || typeChips.length === 0) return;

    const MONTHS_NOM = ["Январь","Февраль","Март","Апрель","Май","Июнь","Июль","Август","Сентябрь","Октябрь","Ноябрь","Декабрь"];
    const MONTHS_GEN = ["янв","фев","мар","апр","мая","июн","июл","авг","сен","окт","ноя","дек"];
    const DOW_SHORT = ["Вс","Пн","Вт","Ср","Чт","Пт","Сб"];
    const WINDOW_DAYS = 14;

    /** YYYY-MM-DD по ЛОКАЛЬНОЙ дате: toISOString() съехал бы на день в UTC+6. */
    const isoDate = (d) => `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}-${String(d.getDate()).padStart(2, "0")}`;

    let activeType = typeChips[0];
    let isOnline = false;
    /** date → { workPlaceId, workplaceName, times: string[] } */
    let byDate = new Map();
    let activeDate = "";
    let pickedTime = "";

    const windowDates = () => {
      const out = [];
      const base = new Date();
      base.setHours(0, 0, 0, 0);
      for (let i = 0; i < WINDOW_DAYS; i += 1) {
        const d = new Date(base);
        d.setDate(base.getDate() + i);
        out.push(d);
      }
      return out;
    };

    function setStatus(text) {
      if (!slotStatus) return;
      if (text === null) {
        slotStatus.hidden = true;
        slotStatus.textContent = "";
      } else {
        slotStatus.hidden = false;
        slotStatus.innerHTML = text;
      }
    }

    function setCta() {
      if (pickedTime !== "") {
        cta.dataset.ready = "1";
        cta.disabled = false;
        cta.textContent = `Записаться на ${pickedTime}`;
      } else {
        delete cta.dataset.ready;
        cta.disabled = true;
        cta.textContent = "Выберите время";
      }
    }

    function renderCalendar() {
      const dates = windowDates();
      const first = dates[0];
      const last = dates[dates.length - 1];
      if (monthLabel) {
        monthLabel.textContent =
          first.getMonth() === last.getMonth()
            ? `${MONTHS_NOM[first.getMonth()]} ${first.getFullYear()}`
            : `${MONTHS_NOM[first.getMonth()]} – ${MONTHS_NOM[last.getMonth()]} ${last.getFullYear()}`;
      }

      dayGrid.innerHTML = "";
      // Пн = 0: getDay() отдаёт Вс = 0, поэтому сдвигаем.
      const pad = (first.getDay() + 6) % 7;
      for (let i = 0; i < pad; i += 1) dayGrid.appendChild(document.createElement("div"));

      dates.forEach((d) => {
        const iso = isoDate(d);
        const has = (byDate.get(iso)?.times.length ?? 0) > 0;
        const b = document.createElement("button");
        b.type = "button";
        b.className = "hm-cal-day relative grid aspect-square place-items-center rounded-[10px] text-[13px] font-semibold";
        b.textContent = String(d.getDate());
        b.disabled = !has;
        b.dataset.date = iso;
        b.setAttribute("aria-pressed", String(iso === activeDate));
        if (has) {
          const dot = document.createElement("span");
          dot.className = "hm-cal-dot absolute bottom-[5px] h-1 w-1 rounded-full bg-[#0e7c8c]";
          b.appendChild(dot);
          b.addEventListener("click", () => {
            activeDate = iso;
            pickedTime = "";
            renderCalendar();
            renderSlots();
          });
        }
        dayGrid.appendChild(b);
      });
    }

    function renderSlots() {
      const day = byDate.get(activeDate);
      const times = day?.times ?? [];
      const d = activeDate === "" ? null : new Date(`${activeDate}T00:00:00`);
      const today = isoDate(new Date());
      if (dayLabel && d) {
        dayLabel.textContent =
          activeDate === today
            ? `Сегодня, ${d.getDate()} ${MONTHS_GEN[d.getMonth()]}`
            : `${DOW_SHORT[d.getDay()]}, ${d.getDate()} ${MONTHS_GEN[d.getMonth()]}`;
      }
      if (countEl) countEl.textContent = times.length > 0 ? `${times.length} слотов` : "";

      slotGrid.innerHTML = "";
      setCta();
      if (times.length === 0) return;

      times.forEach((time) => {
        const b = document.createElement("button");
        b.type = "button";
        b.className = "hm-slot";
        b.textContent = time;
        b.setAttribute("aria-pressed", "false");
        b.addEventListener("click", () => {
          pickedTime = time;
          slotGrid.querySelectorAll(".hm-slot").forEach((el) => el.setAttribute("aria-pressed", String(el === b)));
          setCta();
        });
        slotGrid.appendChild(b);
      });
    }

    async function loadSlots() {
      const typeId = activeType.dataset.typeId ?? "";
      byDate = new Map();
      activeDate = "";
      pickedTime = "";
      dayGrid.innerHTML = "";
      slotGrid.innerHTML = "";
      if (dayLabel) dayLabel.textContent = "";
      if (countEl) countEl.textContent = "";
      setCta();
      setStatus("Смотрим свободное время…");

      const dates = windowDates();
      try {
        const availability = await fetchAvailableSlots(
          doctorId,
          typeId,
          isoDate(dates[0]),
          isoDate(dates[dates.length - 1]),
        );
        availability.forEach((day) => {
          const times = day.slots.filter((s) => s.available).map((s) => s.start_time.slice(0, 5));
          if (times.length === 0) return;
          byDate.set(day.date, {
            workPlaceId: day.workplace.id,
            workplaceName: day.workplace.name,
            times,
          });
        });
      } catch {
        // Сеть, а не отсутствие слотов: показывать «всё занято» здесь было бы ложью.
        setStatus('Не удалось загрузить расписание. <button type="button" data-el="retry" class="hm-retry">Повторить</button>');
        section.querySelector('[data-el="retry"]')?.addEventListener("click", () => void loadSlots());
        return;
      }

      const firstFree = [...byDate.keys()].sort()[0];
      if (firstFree === undefined) {
        renderCalendar();
        setStatus("Свободного времени в ближайшие две недели нет.<br>Попробуйте другой вид приёма.");
        return;
      }
      activeDate = firstFree;
      setStatus(null);
      renderCalendar();
      renderSlots();
    }

    typeChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        if (chip === activeType) return;
        activeType = chip;
        typeChips.forEach((el) => el.setAttribute("aria-selected", String(el === chip)));
        void loadSlots();
      });
    });

    formatChips.forEach((chip) => {
      chip.addEventListener("click", () => {
        isOnline = chip.dataset.online === "1";
        formatChips.forEach((el) => el.setAttribute("aria-selected", String(el === chip)));
      });
    });

    cta.addEventListener("click", () => {
      const day = byDate.get(activeDate);
      if (pickedTime === "" || !day || !trigger) return;
      // Всё, что нужно для брони, уезжает в шит через dataset: своего состояния
      // у шита нет, он только подтверждает.
      trigger.dataset.appointmentTypeId = activeType.dataset.typeId ?? "";
      trigger.dataset.typeName = activeType.dataset.typeName ?? "";
      trigger.dataset.durationMin = activeType.dataset.duration ?? "";
      trigger.dataset.workPlaceId = day.workPlaceId;
      trigger.dataset.workplaceName = day.workplaceName;
      trigger.dataset.slotDate = activeDate;
      trigger.dataset.slotTime = pickedTime;
      trigger.dataset.isOnline = isOnline ? "1" : "0";
      trigger.click();
    });

    void loadSlots();
  })();
</script>
