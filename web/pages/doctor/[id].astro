                        type="text"
                        class="hm-combo-input"
                        data-el="type-input"
                        role="combobox"
                        aria-expanded="false"
                        aria-controls={`type-listbox-${place.id}`}
                        aria-labelledby={`type-label-${place.id}`}
                        aria-autocomplete={place.searchable ? "list" : "none"}
                        autocomplete="off"
                        spellcheck="false"
                        readonly={!place.searchable}
                        placeholder={place.searchable ? "Введите название" : undefined}
                        value={place.firstType ? `${place.firstType.name} · ${place.firstType.durationMin} мин` : ""}
                      />
                      <div class="hm-combo-pop" data-el="type-pop" hidden>
                        <ul class="hm-combo-list" id={`type-listbox-${place.id}`} role="listbox">
                          {place.types.map((type, index) => (
                            <li
                              class="hm-combo-opt"
                              id={`type-opt-${place.id}-${index}`}
