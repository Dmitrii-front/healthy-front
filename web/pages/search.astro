---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import { SPECIALTIES } from "@/entities/specialty";

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: "https://sdoctorom.health/" },
    { "@type": "ListItem", position: 2, name: "Поиск врача", item: "https://sdoctorom.health/search" },
  ],
};
---

<BaseLayout
  title="Найти врача в Бишкеке и Алматы — Healthy"
  description="Поиск врачей по специальности и клинике. Кардиологи, терапевты, педиатры, дерматологи и другие специалисты."
>
  <main class="mx-auto max-w-screen-md px-4 pb-24 pt-8">
    <nav class="mb-4 text-[12.5px] text-distant-graphite">
      <a href="/" class="hover:text-soft-graphite">Главная</a> ·
      <span>Поиск врача</span>
    </nav>

    <header>
      <h1 class="text-[28px] font-medium leading-[1.1] tracking-[-0.022em] text-graphite">
        Найти врача
      </h1>
      <p class="mt-3 max-w-lg text-[15px] leading-relaxed text-soft-graphite">
        Выберите специальность чтобы посмотреть врачей и записаться. Все приёмы — в проверенных
        клиниках Бишкека и Алматы.
      </p>
    </header>

    <section class="mt-8">
      <h2 class="mb-3 text-[16px] font-medium tracking-tight text-graphite">По специальности</h2>
      <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3">
        {SPECIALTIES.map((s) => (
          <li>
            <a
              href={`/specialty/${s.key}`}
              class="flex h-[72px] flex-col justify-between rounded-[16px] border border-hairline-strong bg-card-white p-3 text-graphite transition-colors hover:border-soft-graphite"
            >
              <span class="text-[14px] font-medium leading-[1.15]">{s.label}</span>
              <span class="text-[12px] text-distant-graphite">{s.count} врачей</span>
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section class="mt-10 rounded-[20px] border border-hairline-strong bg-card-white p-6">
      <h2 class="text-[18px] font-medium tracking-tight text-graphite">Расширенный поиск</h2>
      <p class="mt-2 text-[14px] text-soft-graphite">
        Фильтрация по имени, клинике и стажу — внутри приложения.
      </p>
      <a
        href="/app/search"
        class="mt-4 inline-flex h-11 items-center rounded-pill bg-clinic-coral px-6 text-sm font-medium text-card-white hover:bg-brick-coral"
      >
        Открыть поиск в приложении
      </a>
    </section>
  </main>

  <JsonLd data={breadcrumbs} />
</BaseLayout>
