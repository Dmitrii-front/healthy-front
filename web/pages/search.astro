      {/* Фильтра «Город» здесь больше нет: город остался один, а переключатель
          с единственным вариантом выбора не даёт. Параметр city при этом
          продолжает читаться из адреса — старые проиндексированные ссылки не
          должны падать, — но применение фильтров его вычищает. */}
      <div class="filter-divider"></div>
      <div class="filter-group">
        <div class="filter-group-label">Рейтинг</div>
        <div class="filter-group-list">
          <label class="filter-radio"><input type="radio" name="dw-rating" value="" checked /><span>Любой</span></label>
          <label class="filter-radio"><input type="radio" name="dw-rating" value="4.5" /><span>от 4,5</span></label>
          <label class="filter-radio"><input type="radio" name="dw-rating" value="4.8" /><span>от 4,8</span></label>
          <label class="filter-radio"><input type="radio" name="dw-rating" value="5.0" /><span>только 5,0</span></label>
        </div>
      </div>
      <div class="filter-divider"></div>
      <div class="filter-group">
        <div class="filter-group-label">Стаж</div>
        <div class="filter-group-list">
          <label class="filter-radio"><input type="radio" name="dw-exp" value="" checked /><span>Любой</span></label>
          <label class="filter-radio"><input type="radio" name="dw-exp" value="3" /><span>3 года и более</span></label>
          <label class="filter-radio"><input type="radio" name="dw-exp" value="5" /><span>5 лет и более</span></label>
          <label class="filter-radio"><input type="radio" name="dw-exp" value="10" /><span>10 лет и более</span></label>
          <label class="filter-radio"><input type="radio" name="dw-exp" value="20" /><span>20 лет и более</span></label>
        </div>
      </div>
      <div class="filter-divider"></div>
      <div class="filter-group">
        <div class="filter-group-label">Дополнительно</div>
        <div class="filter-group-list">
          <label class="filter-check">
