---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import LoginModal from "../components/auth/LoginModal.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import { SPECIALTIES } from "@/shared/config";
import {
  buildLanguageOptions,
  buildSpecialtyOptions,
  loadDoctorCatalog,
  specialtyKeyOf,
  toSearchIndexItem,
  toSearchIndexWire,
} from "@/entities/doctor";
import { doctorProfileSlug } from "../lib/slug";
import { serializeForJsonIsland } from "../lib/search/serialize";

// Строка идёт и в мета-описание, и в подзаголовок над формой, поэтому обещает
// ровно то, что страница делает: по клинике поиск сознательно не ходит, а
// свободное время выдача больше не показывает — оно на странице врача.
const description =
  "Поиск врачей по имени и специальности. Стаж, языки приёма и цена видны до записи.";

const catalog = await loadDoctorCatalog();

// В островок уезжает запись без подписей: специальность и языки клиент соберёт
// из словарей ниже, которые всё равно едут на страницу.
const doctorItems = catalog.map((doctor) =>
  toSearchIndexWire(toSearchIndexItem(doctor, doctorProfileSlug(doctor))),
);
const specialtyOptions = buildSpecialtyOptions(catalog);
const languageOptions = buildLanguageOptions(catalog);

// Нижний слой — специальности плиток главной: они ведут на ключи, которых в
// каталоге может не быть, и без него чип и заголовок теряют слово, по которому
// пользователь пришёл, а пустая выдача выглядит необъяснимой. Слово берём из
// doctorSpecialty, а не из подписи плитки: подпись каталога всё равно
// перекрывает нижний слой, и на «Окулисте» заголовок иначе скакал бы между
// плиточным и каталожным словом в зависимости от наличия врачей.
const specialtyLabels: Record<string, string> = {
  ...Object.fromEntries(
    SPECIALTIES.map((s) => [specialtyKeyOf(s.doctorSpecialty), s.doctorSpecialty]),
  ),
  ...Object.fromEntries(specialtyOptions.map((option) => [option.key, option.label])),
};

const languageLabels: Record<string, string> = Object.fromEntries(
  languageOptions.map((option) => [option.key, option.label]),
);

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "Главная", item: "https://sdoctorom.health/" },
    { "@type": "ListItem", position: 2, name: "Поиск врача", item: "https://sdoctorom.health/search" },
  ],
};
---

<BaseLayout title="Найти врача — Healthy" description={description}>
  {/* Одно адаптивное дерево, как на странице врача.
      Обе версии обвязки стоят подряд, лишнюю прячет site-chrome.css. Разница
      между размерами экрана выражена только стилями: разметка, шаблон карточки
      и скрипт — в единственном экземпляре. */}
  <div class="hm-site hm-page min-h-dvh bg-[#faf8f5]">
    <SiteHeader variant="mobile" />
    <SiteHeader variant="desktop" />

    <main class="mx-auto max-w-[960px] px-4 pb-10 pt-5 sm:px-8">
      <nav class="hm-crumbs">
        <a href="/">Главная</a>
        <span class="hm-crumb-sep">›</span>
        <a href="/search">Найти врача</a>
        <span class="hm-crumb-sep">›</span>
        <span class="hm-crumb-current" data-crumb-current>Все врачи</span>
      </nav>

      <header class="hm-intro">
        <span class="hm-intro-eyebrow">Каталог</span>
        <h1 class="hm-intro-title" id="search-h1">Найти врача</h1>
        <p class="hm-intro-desc">{description}</p>
      </header>

      {/* Обычная GET-форма: без JS уходит перезагрузкой страницы, с JS обработчик
          перехватывает отправку и перерисовывает выдачу на месте. */}
      <form id="search-form" action="/search" method="get" role="search" class="hm-pill">
        <label class="hm-pill-field">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="hm-pill-icon">
            <path d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/>
          </svg>
          <span class="hm-pill-body">
            <span class="hm-pill-label">Специальность</span>
            <select id="search-specialty" name="specialty" class="hm-pill-control">
              <option value="">Все специальности</option>
              {specialtyOptions.map((option) => (
                <option value={option.key}>{option.label} ({option.count})</option>
              ))}
            </select>
          </span>
        </label>

        <label class="hm-pill-field hm-pill-field-div">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="hm-pill-icon">
            <path d="M12 3a9 9 0 1 0 0 18 9 9 0 0 0 0-18z"/>
            <path d="M3 12h18"/>
            <path d="M12 3c2.5 2.7 2.5 15.3 0 18-2.5-2.7-2.5-15.3 0-18z"/>
          </svg>
          <span class="hm-pill-body">
            <span class="hm-pill-label">Язык приёма</span>
            <select id="search-lang" name="lang" class="hm-pill-control" aria-label="Язык приёма">
              <option value="">Любой язык</option>
              {languageOptions.map((option) => (
                <option value={option.key}>{option.label}</option>
              ))}
            </select>
          </span>
        </label>

        <label class="hm-pill-field hm-pill-field-div">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" class="hm-pill-icon">
            <path d="M11 4a7 7 0 1 1 0 14 7 7 0 0 1 0-14z"/>
            <path d="m21 21-4.3-4.3"/>
          </svg>
          <span class="hm-pill-body">
            <span class="hm-pill-label">По имени</span>
            <input id="search-q" name="q" type="search" placeholder="Имя или специальность" autocomplete="off" class="hm-pill-control" />
          </span>
        </label>

        <button type="submit" class="hm-pill-submit">
          Найти
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14"/><path d="m13 5 7 7-7 7"/>
          </svg>
        </button>
      </form>

      <section class="hm-chip-bar">
        <div class="hm-chip-list" id="chip-list"></div>
        <button type="button" class="hm-chip-reset" id="chip-reset" hidden>Сбросить</button>
      </section>

      <section class="hm-results">
        {/* aria-live: выдача перерисовывается целиком, и без объявления счётчика
            смена числа совпадений для скринридера проходит беззвучно. */}
        <p class="hm-results-bar" id="result-meta" aria-live="polite" hidden>
          <span class="hm-results-count" id="result-count">—</span>
          <span class="hm-results-noun" id="result-noun">врачей</span>
        </p>

        {/* Виден до первого прохода скрипта: страница собирается на сборке, и без
            скелета читатель успевает увидеть голую обвязку. */}
        <ul class="hm-card-list" id="loading-state" aria-hidden="true">
          <li class="hm-card hm-card-skel"><span class="hm-card-skel-photo"></span><span class="hm-card-skel-info"><span class="hm-skel-line"></span><span class="hm-skel-line"></span><span class="hm-skel-line"></span><span class="hm-skel-line"></span></span></li>
          <li class="hm-card hm-card-skel"><span class="hm-card-skel-photo"></span><span class="hm-card-skel-info"><span class="hm-skel-line"></span><span class="hm-skel-line"></span><span class="hm-skel-line"></span><span class="hm-skel-line"></span></span></li>
          <li class="hm-card hm-card-skel"><span class="hm-card-skel-photo"></span><span class="hm-card-skel-info"><span class="hm-skel-line"></span><span class="hm-skel-line"></span><span class="hm-skel-line"></span><span class="hm-skel-line"></span></span></li>
        </ul>

        <ul class="hm-card-list" id="doctor-list" hidden></ul>

        <div class="hm-empty" id="empty-state" hidden>
          <p class="hm-empty-title">Пока никого не нашли.</p>
          <p class="hm-empty-desc">
            Попробуйте сбросить запрос или посмотрите{" "}
            <a href="/search">все специальности</a>.
          </p>
        </div>

        <div class="hm-empty" id="error-state" hidden>
          <p class="hm-empty-title">Не удалось загрузить.</p>
          <p class="hm-empty-desc">Проверьте соединение и попробуйте ещё раз.</p>
          <button type="button" class="hm-empty-retry" id="retry-btn">Повторить</button>
        </div>
      </section>
    </main>

    <SiteFooter variant="mobile" />
    <SiteFooter variant="desktop" />
  </div>

  {/* Единственный шаблон карточки на оба размера экрана. Комментарии внутри
      <template> запрещены: компилятор Astro умеет утечь ими в живой DOM. */}
  <template id="card-template">
    <li>
      <a class="hm-card hm-card-link" data-link>
        <span class="hm-card-photo" data-avatar aria-hidden="true"></span>
        <div class="hm-card-info">
          <p class="hm-card-eyebrow" data-eyebrow></p>
          <h3 class="hm-card-name" data-name></h3>
          <p class="hm-card-spec" data-spec></p>
          <div class="hm-card-facts">
            <span class="hm-card-chips">
              <span class="hm-card-chip" data-exp-chip hidden><span data-exp></span></span>
              <span class="hm-card-chip" data-price-chip hidden><span data-price></span></span>
            </span>
            <span class="hm-card-section" data-subspecs-section hidden>
              <span class="hm-card-section-label">Направления</span>
              <span class="hm-card-section-value" data-subspecs></span>
            </span>
            <span class="hm-card-section" data-langs-section hidden>
              <span class="hm-card-section-label">Языки приёма</span>
              <span class="hm-card-section-value" data-langs></span>
            </span>
          </div>
          <p class="hm-card-clinic" data-clinic></p>
        </div>
      </a>
    </li>
  </template>

  <LoginModal />

  {/* Данные каталога. Отдельный островок, потому что define:vars механически
      отменяет бандлинг: Astro снимает по нему флаг hoist, и скрипт остаётся
      неминифицированным исходником прямо в HTML. */}
  <script
    type="application/json"
    id="search-data"
    is:inline
    set:html={serializeForJsonIsland({ specialtyLabels, languageLabels, doctorItems })}
  />

  <script>
    import { formatExperienceLabel, formatPriceKgs, fromSearchIndexWire } from "@/entities/doctor";
    import type { SearchIndexItem, SearchIndexWire } from "@/entities/doctor";
    import { filterDoctors } from "../lib/search/filter";
    import { pluralizeDoctors } from "../lib/search/format";
    import type { SearchState } from "../lib/search/state";
    import { activeChips, buildSearchQuery, readSearchState } from "../lib/search/state";

    (() => {
      // Островок описан теми же типами, которыми построен: перепечатанная
      // копия разъехалась бы молча — JSON.parse отдаёт any, и промах полей
      // дошёл бы до прода пустой карточкой. В HTML лежит SearchIndexWire (без
      // подписей), карточка работает с полной записью.
      type DoctorItem = SearchIndexItem;
      type UiState = "loading" | "results" | "empty" | "error";

      // Данные приезжают островком <script type="application/json"> — см.
      // разметку выше. Раньше их вносил define:vars, но он несовместим с
      // бандлингом.
      const dataEl = document.getElementById("search-data");
      const payload: {
        specialtyLabels?: Record<string, string>;
        languageLabels?: Record<string, string>;
        doctorItems?: SearchIndexWire[];
      } = dataEl && dataEl.textContent ? JSON.parse(dataEl.textContent) : {};
      const specialtyLabels = payload.specialtyLabels || {};
      const languageLabels = payload.languageLabels || {};
      const doctorItems = payload.doctorItems || [];

      const listNode = document.getElementById("doctor-list");
      const loadingNode = document.getElementById("loading-state");
      const emptyNode = document.getElementById("empty-state");
      const errorNode = document.getElementById("error-state");
      const resultMetaNode = document.getElementById("result-meta");
      const countNode = document.getElementById("result-count");
      const nounNode = document.getElementById("result-noun");
      const h1Node = document.getElementById("search-h1");
      const formNode = document.getElementById("search-form");
      const qInputNode = document.querySelector<HTMLInputElement>("#search-q");
      const specSelectNode = document.querySelector<HTMLSelectElement>("#search-specialty");
      const langSelectNode = document.querySelector<HTMLSelectElement>("#search-lang");
      const templateNode = document.querySelector<HTMLTemplateElement>("#card-template");

      const crumbCurrent = document.querySelector("[data-crumb-current]");
      const chipList = document.getElementById("chip-list");
      const chipReset = document.getElementById("chip-reset");
      const retryBtn = document.getElementById("retry-btn");

      if (
        !listNode ||
        !templateNode ||
        !loadingNode ||
        !emptyNode ||
        !errorNode ||
        !resultMetaNode ||
        !countNode ||
        !nounNode ||
        !h1Node ||
        !formNode ||
        !qInputNode ||
        !specSelectNode ||
        !langSelectNode
      ) {
        return;
      }

      // Сужение до non-null не доходит до тел function-объявлений: они
      // всплывают выше проверки. Поэтому ниже работаем со вторыми именами.
      const list = listNode;
      const loading = loadingNode;
      const empty = emptyNode;
      const errorEl = errorNode;
      const resultMeta = resultMetaNode;
      const countEl = countNode;
      const nounEl = nounNode;
      const h1 = h1Node;
      const form = formNode;
      const qInput = qInputNode;
      const specSelect = specSelectNode;
      const langSelect = langSelectNode;
      const template = templateNode;

      // Каталог целиком приезжает вместе со страницей — фильтрация идёт
      // синхронно по памяти, без сети и ожидания. Подписи возвращаются на
      // записи здесь, один раз на загрузку, а не на каждую отрисовку.
      const allItems: DoctorItem[] = (Array.isArray(doctorItems) ? doctorItems : []).map((wire) =>
        fromSearchIndexWire(wire, specialtyLabels, languageLabels),
      );

      // toLowerCase ради «Стаж менее года»: на числовых подписях он ничего не меняет.
      function experienceText(years: number | null): string | null {
        const label = formatExperienceLabel(years);
        return label === null ? null : "Стаж " + label.toLowerCase();
      }

      function priceText(priceFrom: number | null): string | null {
        const price = formatPriceKgs(priceFrom);
        return price === null ? null : "от " + price;
      }

      function clinicText(d: DoctorItem): string {
        const parts: string[] = [];
        if (d.workplaceName) parts.push(d.workplaceName);
        if (d.city) parts.push(d.city);
        if (d.workplacesTotal > 1) parts.push("ещё " + (d.workplacesTotal - 1));
        return parts.join(" · ");
      }

      // Опциональные блоки карточки лежат в шаблоне скрытыми: пустое поле
      // оставляет блок скрытым, непустое — открывает его и заполняет.
      function reveal(li: Element, section: string, value: string, text: string | null) {
        if (!text) return;
        const sectionEl = li.querySelector<HTMLElement>(section);
        if (sectionEl) sectionEl.hidden = false;
        const valueEl = li.querySelector(value);
        if (valueEl) valueEl.textContent = text;
      }

      function setUiState(s: UiState) {
        loading.hidden = s !== "loading";
        list.hidden = s !== "results";
        empty.hidden = s !== "empty";
        errorEl.hidden = s !== "error";
        resultMeta.hidden = s !== "results" && s !== "empty";
      }

      function renderMeta(state: SearchState) {
        qInput.value = state.q;
        specSelect.value = state.specialty;
        langSelect.value = state.lang;

        const specialtyLabel = state.specialty ? specialtyLabels[state.specialty] : undefined;
        let h1Text = "Найти врача";
        let crumbText = "Все врачи";
        if (specialtyLabel) {
          h1Text = specialtyLabel;
          crumbText = specialtyLabel;
        } else if (state.q) {
          h1Text = "Поиск: «" + state.q + "»";
          crumbText = "Поиск";
        }
        h1.textContent = h1Text;
        document.title = h1Text + " — Healthy";
        if (crumbCurrent) crumbCurrent.textContent = crumbText;

        renderChips(state);
      }

      function renderChips(state: SearchState) {
        if (!chipList || !chipReset) return;
        const pills = activeChips(state, specialtyLabels, languageLabels);
        chipList.replaceChildren();
        pills.forEach((p) => {
          const btn = document.createElement("button");
          btn.type = "button";
          btn.className = "hm-chip";
          btn.dataset.chipKey = p.key;
          btn.appendChild(document.createTextNode(p.label));
          const x = document.createElementNS("http://www.w3.org/2000/svg", "svg");
          x.setAttribute("width", "11");
          x.setAttribute("height", "11");
          x.setAttribute("viewBox", "0 0 24 24");
          x.setAttribute("fill", "none");
          x.setAttribute("stroke", "currentColor");
          x.setAttribute("stroke-width", "2.5");
          x.setAttribute("stroke-linecap", "round");
          x.innerHTML = '<path d="M18 6 6 18M6 6l12 12"/>';
          btn.appendChild(x);
          btn.addEventListener("click", () => removeFilter(p.key));
          chipList.appendChild(btn);
        });
        chipReset.hidden = pills.length === 0;
      }

      function removeFilter(key: keyof SearchState) {
        const state = readSearchState(location.search);
        state[key] = "";
        const qs = buildSearchQuery(state);
        history.pushState({}, "", qs ? "/search?" + qs : "/search");
        load();
      }

      function resetAllFilters() {
        history.pushState({}, "", "/search");
        load();
      }

      // importNode вместо cloneNode: результат тот же, но тип — DocumentFragment,
      // а не безликий Node, у которого нет querySelector.
      function renderCard(d: DoctorItem) {
        const frag = document.importNode(template.content, true);
        const li = frag.querySelector("li");
        if (!li) return frag;

        const link = li.querySelector<HTMLAnchorElement>("[data-link]");
        if (link) link.href = "/doctor/" + d.slug;

        const avatar = li.querySelector<HTMLElement>("[data-avatar]");
        if (avatar) {
          avatar.textContent = d.initials;
          avatar.style.backgroundColor = d.avatarColor;
        }

        // Специальность стоит в разметке дважды: надзаголовком над именем и
        // строкой под ним. Видна всегда ровно одна — какая, решает ширина
        // экрана в стилях. Заполняем обе, иначе на смене размера окна текст
        // пропадёт.
        const eyebrow = li.querySelector("[data-eyebrow]");
        if (eyebrow) eyebrow.textContent = d.specialty;
        const spec = li.querySelector("[data-spec]");
        if (spec) spec.textContent = d.specialty;

        const name = li.querySelector("[data-name]");
        if (name) name.textContent = d.fullName;

        reveal(li, "[data-exp-chip]", "[data-exp]", experienceText(d.yearsExperience));
        reveal(li, "[data-price-chip]", "[data-price]", priceText(d.priceFrom));
        reveal(li, "[data-subspecs-section]", "[data-subspecs]", d.subspecializations.join(" · "));
        reveal(li, "[data-langs-section]", "[data-langs]", d.languages.join(", "));

        const clinic = li.querySelector("[data-clinic]");
        if (clinic) clinic.textContent = clinicText(d);

        return frag;
      }

      function renderResults(items: DoctorItem[], total: number) {
        list.replaceChildren();
        for (const d of items) list.appendChild(renderCard(d));
        countEl.textContent = String(total);
        nounEl.textContent = pluralizeDoctors(total);
      }

      function load() {
        const state = readSearchState(location.search);
        renderMeta(state);
        const filtered = filterDoctors(allItems, state);
        if (filtered.length === 0) {
          countEl.textContent = "0";
          nounEl.textContent = pluralizeDoctors(0);
          setUiState("empty");
        } else {
          renderResults(filtered, filtered.length);
          setUiState("results");
        }
      }

      function submitState(state: SearchState) {
        const qs = buildSearchQuery(state);
        history.pushState({}, "", qs ? "/search?" + qs : "/search");
        load();
      }

      form.addEventListener("submit", (e) => {
        e.preventDefault();
        submitState({
          q: qInput.value.trim(),
          specialty: specSelect.value,
          lang: langSelect.value,
        });
      });

      chipReset?.addEventListener("click", resetAllFilters);
      retryBtn?.addEventListener("click", () => load());
      addEventListener("popstate", load);

      load();
    })();
  </script>

  <style is:global>
    :root {
      --teal: #0e7c8c;
      --teal-hover: #0a6573;
      --teal-soft: #dceef1;
      --teal-softer: #eef6f8;
      --teal-deep: #0a1f25;
      --n-bg: #faf8f5;
      --n-ink: #0f1115;
      --n-ink2: #2a2d33;
      --n-muted: #8a8e96;
      --n-muted2: #b5b8bd;
      --n-line: #e2e2df;
      --n-line-soft: #edebe6;

      /* Geometry ladder — each radius encodes a role, no free-form values.
         pill = anything fully-rounded; card = top-level container;
         control = button / select / menu surface; chip = small inline tag. */
      --r-pill: 999px;
      --r-card: 14px;
      --r-control: 10px;

      /* Elevation ladder — две ступени, больше не заводим.
         rest = поверхность в потоке; hover = подъём при наведении. */
      --e-rest: 0 1px 2px rgba(15, 17, 21, 0.04);
      --e-hover: 0 4px 16px rgba(14, 124, 140, 0.08);
    }

    /* ── Крошки ─────────────────────────────── */
    .hm-crumbs {
      font-size: 12.5px;
      color: var(--n-muted);
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 6px;
    }
    .hm-crumbs a { color: inherit; text-decoration: none; }
    .hm-crumbs a:hover { color: var(--n-ink2); }
    .hm-crumb-sep { color: var(--n-muted2); }
    .hm-crumb-current { color: var(--n-ink2); }

    /* ── Заголовок ──────────────────────────── */
    .hm-intro { padding: 14px 0 16px; }
    .hm-intro-eyebrow {
      display: block;
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--n-muted);
    }
    .hm-intro-title {
      margin-top: 6px;
      font-size: 28px;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.025em;
      color: var(--n-ink);
      text-wrap: balance;
    }
    .hm-intro-desc {
      margin-top: 8px;
      max-width: 34rem;
      font-size: 14px;
      line-height: 1.6;
      color: var(--n-ink2);
    }

    /* ── Форма ──────────────────────────────── */
    .hm-pill {
      display: grid;
      grid-template-columns: 1fr;
      gap: 4px;
      padding: 10px;
      background: #fff;
      border: 1px solid var(--n-line);
      border-radius: var(--r-card);
      box-shadow: var(--e-rest);
    }
    .hm-pill-field {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 8px 12px;
      border-radius: var(--r-control);
      min-width: 0;
    }
    .hm-pill-field:focus-within { background: var(--teal-softer); }
    .hm-pill-icon { color: var(--n-muted); flex-shrink: 0; }
    .hm-pill-body { display: flex; flex-direction: column; min-width: 0; flex: 1; }
    .hm-pill-label {
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--n-muted);
    }
    .hm-pill-control {
      font-size: 14px;
      font-weight: 600;
      color: var(--n-ink);
      margin-top: 1px;
      background: transparent;
      border: none;
      outline: none;
      font-family: inherit;
      width: 100%;
    }
    .hm-pill-control[type="search"]::placeholder {
      color: var(--n-muted2);
      font-weight: 500;
    }
    .hm-pill-submit {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
      height: 44px;
      padding: 0 22px;
      border: none;
      border-radius: var(--r-pill);
      background: var(--teal);
      color: #fff;
      font-family: inherit;
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: background 0.15s;
    }
    .hm-pill-submit:hover { background: var(--teal-hover); }

    /* ── Чипы активных фильтров ─────────────── */
    .hm-chip-bar {
      display: flex;
      align-items: center;
      flex-wrap: wrap;
      gap: 8px;
      padding: 14px 0 0;
    }
    .hm-chip-list { display: flex; flex-wrap: wrap; gap: 8px; }
    .hm-chip {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 7px 11px 7px 13px;
      border-radius: var(--r-pill);
      background: #fff;
      border: 1px solid var(--n-line-soft);
      color: var(--n-ink);
      font-family: inherit;
      font-weight: 600;
      font-size: 13px;
      white-space: nowrap;
      cursor: pointer;
      transition: border-color 0.15s, color 0.15s;
    }
    .hm-chip:hover { border-color: var(--teal); color: var(--teal); }
    .hm-chip-reset {
      background: none;
      border: none;
      padding: 4px;
      color: var(--n-muted);
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
      cursor: pointer;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .hm-chip-reset:hover { color: var(--n-ink); }

    /* ── Выдача ─────────────────────────────── */
    .hm-results { padding-top: 18px; }
    .hm-results-bar {
      display: flex;
      align-items: baseline;
      gap: 5px;
      padding-bottom: 12px;
      font-size: 12.5px;
      color: var(--n-muted);
    }
    .hm-results-count { font-weight: 700; color: var(--n-ink); }

    .hm-card-list { display: flex; flex-direction: column; gap: 10px; }

    .hm-card {
      display: flex;
      gap: 14px;
      padding: 14px;
      background: #fff;
      border: 1px solid var(--n-line-soft);
      border-radius: var(--r-card);
      box-shadow: var(--e-rest);
    }
    .hm-card-link { text-decoration: none; color: inherit; transition: border-color 0.15s, box-shadow 0.15s; }
    .hm-card-link:hover { border-color: var(--teal); box-shadow: var(--e-hover); }

    .hm-card-photo {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
      display: grid;
      place-items: center;
      border-radius: var(--r-pill);
      color: var(--teal-deep);
      font-size: 14px;
      font-weight: 700;
      letter-spacing: -0.02em;
    }

    .hm-card-info { display: flex; flex-direction: column; min-width: 0; flex: 1; }

    .hm-card-eyebrow {
      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--n-muted);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }
    .hm-card-name {
      margin-top: 3px;
      font-size: 15.5px;
      font-weight: 600;
      line-height: 1.25;
      letter-spacing: -0.01em;
      color: var(--n-ink);
    }
    /* Специальность под именем — десктопная подача; на телефоне её роль играет
       надзаголовок выше. */
    .hm-card-spec { display: none; }

    .hm-card-clinic {
      margin-top: 3px;
      font-size: 13px;
      color: var(--n-ink2);
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    /* Стаж, цена и направления на телефоне идут одной перетекающей строкой —
       без капсул и подписей, как обычный мета-текст. */
    .hm-card-facts {
      margin-top: 4px;
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 2px 12px;
      font-size: 12px;
      font-variant-numeric: tabular-nums;
      color: var(--n-muted);
    }
    /* display:contents — капсулы на телефоне встают в общий поток мета-строки,
       а на широком экране собираются в собственный ряд. Без него они либо
       ломают строку на телефоне, либо уходят в столбик на десктопе. */
    .hm-card-chips { display: contents; }
    .hm-card-section-label { display: none; }
    .hm-card-section[data-langs-section] { display: none; }

    /* ── Скелет ─────────────────────────────── */
    .hm-card-skel { align-items: stretch; }
    .hm-card-skel-photo {
      width: 48px;
      height: 48px;
      flex-shrink: 0;
      border-radius: var(--r-pill);
      background: var(--n-line-soft);
    }
    .hm-card-skel-info { display: flex; flex-direction: column; gap: 8px; flex: 1; padding: 4px 0; }
    .hm-skel-line { height: 10px; border-radius: 4px; background: var(--n-line-soft); }
    .hm-skel-line:nth-child(1) { width: 30%; }
    .hm-skel-line:nth-child(2) { width: 65%; }
    .hm-skel-line:nth-child(3) { width: 45%; }
    .hm-skel-line:nth-child(4) { width: 55%; }
    .hm-card-skel-photo,
    .hm-skel-line { animation: hm-pulse 1.4s ease-in-out infinite; }
    @keyframes hm-pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.45; }
    }
    @media (prefers-reduced-motion: reduce) {
      .hm-card-skel-photo,
      .hm-skel-line { animation: none; }
    }

    /* ── Пустые состояния ───────────────────── */
    .hm-empty {
      padding: 28px 20px;
      background: #fff;
      border: 1px dashed var(--n-line);
      border-radius: var(--r-card);
      text-align: center;
    }
    .hm-empty-title { font-size: 15px; font-weight: 600; color: var(--n-ink); }
    .hm-empty-desc { margin-top: 6px; font-size: 13px; color: var(--n-muted); }
    .hm-empty-desc a { color: var(--teal); text-decoration: underline; text-underline-offset: 2px; }
    .hm-empty-retry {
      margin-top: 14px;
      height: 36px;
      padding: 0 18px;
      border: 1px solid var(--n-line);
      border-radius: var(--r-pill);
      background: #fff;
      font-family: inherit;
      font-size: 13px;
      font-weight: 600;
      color: var(--n-ink);
      cursor: pointer;
    }
    .hm-empty-retry:hover { background: var(--teal); border-color: var(--teal); color: #fff; }

    /* ════════════════════════════════════════════════════════════ */
    /*  ≥768px — тот же DOM, другая подача                          */
    /* ════════════════════════════════════════════════════════════ */
    @media (min-width: 768px) {
      .hm-intro { padding: 22px 0 20px; }
      .hm-intro-title { font-size: 40px; letter-spacing: -0.035em; }
      .hm-intro-desc { font-size: 15px; }

      /* Дорожек ровно столько, сколько полей плюс кнопка: лишний ребёнок
         уезжает во вторую строку и разрывает форму-пилюлю. */
      .hm-pill {
        grid-template-columns: 1.3fr 1fr 1.3fr auto;
        gap: 4px;
        padding: 6px;
        border-radius: var(--r-pill);
        align-items: center;
      }
      .hm-pill-field { padding: 8px 14px; }
      .hm-pill-field-div { border-left: 1px solid var(--n-line-soft); }
      .hm-pill-submit { height: 48px; padding: 0 26px; }

      .hm-chip-bar { padding-top: 18px; }
      .hm-results { padding-top: 22px; }
      .hm-results-bar { font-size: 13px; padding-bottom: 14px; }

      .hm-card-list { gap: 14px; }
      .hm-card { gap: 20px; padding: 20px; }

      .hm-card-photo {
        width: 120px;
        height: 140px;
        border-radius: var(--r-card);
        font-size: 30px;
        /* Инициалы на десктопе лежат на фирменной подложке, а не на цвете
           врача: плитка крупная, и случайный цвет на ней читается как ошибка
           вёрстки. Цвет с карточки остаётся инлайновым фоном под градиентом. */
        background-image: linear-gradient(160deg, var(--teal-soft), var(--teal-softer));
      }

      .hm-card-eyebrow { display: none; }
      .hm-card-name { margin-top: 0; font-size: 19px; letter-spacing: -0.02em; }
      .hm-card-spec {
        display: block;
        margin-top: 4px;
        font-size: 13.5px;
        font-weight: 600;
        color: var(--n-ink2);
      }

      .hm-card-facts {
        margin-top: 12px;
        flex-direction: column;
        align-items: flex-start;
        gap: 7px;
        font-size: 13px;
        color: var(--n-ink2);
      }
      /* Капсулы стоят рядом, а подписанные разделы — каждый со своей строки. */
      .hm-card-chips { display: flex; flex-wrap: wrap; gap: 8px; }
      .hm-card-chip {
        padding: 5px 11px;
        border-radius: var(--r-pill);
        background: var(--teal-softer);
        color: var(--teal-hover);
        font-weight: 700;
        font-size: 12px;
      }
      .hm-card-section { display: flex; gap: 8px; align-items: baseline; }
      .hm-card-section-label {
        display: block;
        flex-shrink: 0;
        width: 118px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--n-muted);
      }
      .hm-card-section[data-langs-section] { display: flex; }

      .hm-card-clinic { margin-top: 12px; font-size: 13px; color: var(--n-muted); }

      .hm-card-skel-photo { width: 120px; height: 140px; border-radius: var(--r-card); }
      .hm-empty { padding: 44px 24px; }
    }
  </style>

  <JsonLd data={breadcrumbs} />
</BaseLayout>
