      </a>
    </li>
  </template>

  {/* ── FILTER DRAWER ─────────────────────────────── */}
  <div class="filter-drawer-backdrop" id="filter-drawer-backdrop" hidden></div>
  <aside class="filter-drawer" id="filter-drawer" hidden aria-label="Все фильтры">
    <div class="filter-drawer-head">
      <h3>Все фильтры</h3>
      <button type="button" class="filter-drawer-close" data-action="close-drawer" aria-label="Закрыть">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
          <path d="M18 6 6 18M6 6l12 12"/>
