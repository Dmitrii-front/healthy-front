---
import BaseLayout from "../layouts/BaseLayout.astro";

// Password reset landing — opens from the deeplink in the reset-password
// transactional email (healthy-mail/emails/reset-password). Pre-rendered:
// query string (?token=&lang=) is read client-side in the inline
// <script>, so static delivery is fine. See verify-email.astro for the
// PUBLIC_API_URL build-time caveat.
export const prerender = true;

const apiUrl = import.meta.env.PUBLIC_API_URL ?? "http://localhost:3000";
---

<BaseLayout title="Сброс пароля — Healthy" canonical={Astro.url.toString()}>
  <main class="hm-reset-shell">
    <section
      class="hm-reset-card"
      data-state="verifying"
      data-api-url={apiUrl}
    >
      <div class="hm-reset-brand" aria-hidden="true">
        <div class="hm-reset-mono">H</div>
        <span>Healthy</span>
      </div>

      <!-- VERIFYING (initial, while we ping the backend to confirm the
           token is still valid before showing the new-password form) -->
      <div class="hm-reset-pane hm-reset-pane--center" data-pane="verifying">
        <div class="hm-reset-icon hm-reset-icon--brand" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <rect x="4" y="11" width="16" height="10" rx="2" />
            <path d="M8 11V8a4 4 0 0 1 8 0v3" />
          </svg>
        </div>
        <h1 class="hm-reset-title">Проверяем ссылку</h1>
        <p class="hm-reset-subtitle">Это займёт несколько секунд</p>
      </div>

      <!-- FORM -->
      <div class="hm-reset-pane" data-pane="form" hidden>
        <h1 class="hm-reset-title">Новый пароль</h1>
        <p class="hm-reset-subtitle">Придумайте надёжный пароль для входа в аккаунт.</p>

        <form class="hm-reset-form" data-el="form" novalidate>
          <label class="hm-reset-field">
            <span class="hm-reset-label">Новый пароль</span>
            <div class="hm-reset-input-wrap" data-input-wrap>
              <svg class="hm-reset-input-icon" width="18" height="18" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true">
                <rect x="4" y="11" width="16" height="10" rx="2" />
                <path d="M8 11V8a4 4 0 0 1 8 0v3" />
              </svg>
              <input
                type="password"
                id="hm-reset-password"
                name="password"
                autocomplete="new-password"
                placeholder="••••••••"
                data-el="password"
                required
                minlength="8"
              />
              <button
                type="button"
                class="hm-reset-reveal"
                data-action="hm-reset-reveal"
                data-target="hm-reset-password"
                aria-label="Показать пароль"
                aria-pressed="false"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
              </button>
            </div>
            <p class="hm-reset-helper" data-el="password-helper">
              Минимум 8 символов, заглавная буква и цифра
            </p>
            <p class="hm-reset-error" data-el="password-error" hidden></p>
          </label>

          <label class="hm-reset-field">
            <span class="hm-reset-label">Повторите пароль</span>
            <div class="hm-reset-input-wrap" data-input-wrap>
              <svg class="hm-reset-input-icon" width="18" height="18" viewBox="0 0 24 24"
                fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"
                stroke-linejoin="round" aria-hidden="true">
                <rect x="4" y="11" width="16" height="10" rx="2" />
                <path d="M8 11V8a4 4 0 0 1 8 0v3" />
              </svg>
              <input
                type="password"
                id="hm-reset-confirm"
                name="confirmPassword"
                autocomplete="new-password"
                placeholder="••••••••"
                data-el="confirm"
                required
              />
              <button
                type="button"
                class="hm-reset-reveal"
                data-action="hm-reset-reveal"
                data-target="hm-reset-confirm"
                aria-label="Показать пароль"
                aria-pressed="false"
              >
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M1 12s4-7 11-7 11 7 11 7-4 7-11 7-11-7-11-7Z" />
                  <circle cx="12" cy="12" r="3" />
                </svg>
              </button>
            </div>
            <p class="hm-reset-error" data-el="confirm-error" hidden></p>
          </label>

          <p class="hm-reset-form-error" data-el="form-error" hidden></p>

          <button type="submit" class="hm-reset-cta hm-reset-cta--primary" data-el="submit">
            Сохранить пароль
          </button>
        </form>
      </div>

      <!-- SUCCESS -->
      <div class="hm-reset-pane hm-reset-pane--center" data-pane="success" hidden>
        <div class="hm-reset-icon hm-reset-icon--brand" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="m5 12 5 5 9-11" />
          </svg>
        </div>
        <h1 class="hm-reset-title">Пароль обновлён</h1>
        <p class="hm-reset-subtitle">Войдите с новым паролем.</p>
        <a class="hm-reset-cta hm-reset-cta--primary" href="/?auth=sign-in">Войти</a>
      </div>

      <!-- EXPIRED -->
      <div class="hm-reset-pane hm-reset-pane--center" data-pane="expired" hidden>
        <div class="hm-reset-icon hm-reset-icon--error" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8v4M12 16h.01" />
          </svg>
        </div>
        <h1 class="hm-reset-title">Ссылка устарела</h1>
        <p class="hm-reset-subtitle">
          Срок действия ссылки истёк. Запросите новое письмо для восстановления.
        </p>
        <a class="hm-reset-cta hm-reset-cta--primary" href="/?auth=sign-in">
          Вернуться ко входу
        </a>
      </div>

      <!-- ERROR (verify failed before the form was even shown — invalid
           token, network error, etc. Distinct from inline form errors.) -->
      <div class="hm-reset-pane hm-reset-pane--center" data-pane="error" hidden>
        <div class="hm-reset-icon hm-reset-icon--error" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8v4M12 16h.01" />
          </svg>
        </div>
        <h1 class="hm-reset-title">Не удалось проверить ссылку</h1>
        <p class="hm-reset-subtitle">
          Попробуйте позже или запросите новое письмо для восстановления.
        </p>
        <a class="hm-reset-cta hm-reset-cta--primary" href="/?auth=sign-in">
          Вернуться ко входу
        </a>
      </div>

      <!-- NO TOKEN -->
      <div class="hm-reset-pane hm-reset-pane--center" data-pane="no-token" hidden>
        <div class="hm-reset-icon hm-reset-icon--error" aria-hidden="true">
          <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor"
            stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="9" />
            <path d="M12 8v4M12 16h.01" />
          </svg>
        </div>
        <h1 class="hm-reset-title">Ссылка недействительна</h1>
        <p class="hm-reset-subtitle">
          Откройте письмо для восстановления пароля и нажмите ссылку ещё раз.
        </p>
        <a class="hm-reset-cta hm-reset-cta--primary" href="/?auth=sign-in">
          Запросить новое письмо
        </a>
      </div>
    </section>
  </main>
</BaseLayout>

<style is:global>
  .hm-reset-shell {
    min-height: 100dvh;
    display: grid;
    place-items: center;
    padding: 40px 24px;
    background: linear-gradient(180deg, #faf8f5 0%, #f1ecdf 100%);
  }
  .hm-reset-card {
    width: 100%;
    max-width: 440px;
    background: #ffffff;
    border-radius: 24px;
    border: 1px solid rgba(0, 0, 0, 0.05);
    padding: 36px 28px 32px;
    box-shadow:
      0 30px 80px rgba(0, 0, 0, 0.08),
      0 0 0 1px rgba(0, 0, 0, 0.03);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 22px;
  }
  @media (min-width: 768px) {
    .hm-reset-card {
      padding: 40px 36px 36px;
    }
  }
  .hm-reset-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 18px;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: #0f1115;
    align-self: center;
  }
  .hm-reset-mono {
    width: 32px;
    height: 32px;
    border-radius: 9px;
    background: #0e7c8c;
    color: #fff;
    display: grid;
    place-items: center;
    font-weight: 700;
    font-size: 15px;
  }
  .hm-reset-pane {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    width: 100%;
    text-align: center;
  }
  .hm-reset-pane[hidden] {
    display: none;
  }
  .hm-reset-pane[data-pane="form"] {
    text-align: left;
    align-items: stretch;
  }
  .hm-reset-pane--center {
    text-align: center;
    align-items: center;
  }
  .hm-reset-icon {
    width: 56px;
    height: 56px;
    border-radius: 16px;
    display: grid;
    place-items: center;
  }
  .hm-reset-icon--brand {
    color: #0e7c8c;
    background: color-mix(in oklab, #0e7c8c 12%, transparent);
  }
  .hm-reset-icon--error {
    color: #b04a3a;
    background: color-mix(in oklab, #b04a3a 12%, transparent);
  }
  .hm-reset-title {
    margin: 0;
    font-size: 24px;
    line-height: 1.15;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #0f1115;
  }
  .hm-reset-pane[data-pane="form"] .hm-reset-title {
    text-align: left;
  }
  .hm-reset-subtitle {
    margin: 0;
    font-size: 15px;
    line-height: 1.45;
    color: #5f636a;
  }
  .hm-reset-form {
    display: flex;
    flex-direction: column;
    gap: 18px;
    margin-top: 4px;
  }
  .hm-reset-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .hm-reset-label {
    font-size: 13px;
    font-weight: 500;
    color: #3a3f4a;
  }
  .hm-reset-input-wrap {
    display: flex;
    align-items: center;
    gap: 10px;
    height: 50px;
    padding: 0 14px;
    border-radius: 12px;
    border: 1px solid #e2e2df;
    background: #fff;
    transition:
      border-color 0.15s ease,
      box-shadow 0.15s ease;
  }
  .hm-reset-input-wrap:focus-within {
    border-color: #0e7c8c;
    box-shadow: 0 0 0 4px color-mix(in oklab, #0e7c8c 18%, transparent);
  }
  .hm-reset-input-wrap[data-invalid="true"] {
    border-color: #b04a3a;
  }
  .hm-reset-input-wrap[data-invalid="true"]:focus-within {
    box-shadow: 0 0 0 4px color-mix(in oklab, #b04a3a 18%, transparent);
  }
  .hm-reset-input-icon {
    color: #5f636a;
    flex-shrink: 0;
  }
  .hm-reset-input-wrap input {
    flex: 1;
    min-width: 0;
    height: 100%;
    background: transparent;
    border: 0;
    outline: 0;
    font-size: 15px;
    color: #0f1115;
  }
  .hm-reset-input-wrap input::placeholder {
    color: #9ca0a8;
  }
  .hm-reset-reveal {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 8px;
    background: transparent;
    border: 0;
    cursor: pointer;
    color: #5f636a;
    transition: color 0.15s ease;
  }
  .hm-reset-reveal:hover {
    color: #0f1115;
  }
  .hm-reset-helper {
    margin: 2px 0 0;
    font-size: 12px;
    color: #5f636a;
  }
  .hm-reset-error,
  .hm-reset-form-error {
    margin: 0;
    font-size: 13px;
    color: #b04a3a;
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .hm-reset-cta {
    margin-top: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 52px;
    width: 100%;
    border: 0;
    border-radius: 999px;
    font-size: 15px;
    font-weight: 600;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform 0.15s ease,
      box-shadow 0.15s ease,
      background-color 0.15s ease;
  }
  .hm-reset-cta--primary {
    background: #0e7c8c;
    color: #fff;
    box-shadow:
      0 1px 2px rgba(14, 124, 140, 0.2),
      0 8px 20px rgba(14, 124, 140, 0.2);
  }
  .hm-reset-cta--primary:hover:not(:disabled) {
    background: #0a6573;
    transform: translateY(-1px);
    box-shadow:
      0 2px 4px rgba(14, 124, 140, 0.25),
      0 12px 28px rgba(14, 124, 140, 0.28);
  }
  .hm-reset-cta--primary:active:not(:disabled) {
    transform: scale(0.985);
  }
  .hm-reset-cta:disabled {
    background: #9ca0a8;
    cursor: not-allowed;
    box-shadow: none;
  }
</style>

<script>
  type Pane = "verifying" | "form" | "success" | "expired" | "error" | "no-token";

  const card = document.querySelector<HTMLElement>(".hm-reset-card");
  if (card) {
    const apiUrl = card.dataset.apiUrl ?? "http://localhost:3000";
    const panes = card.querySelectorAll<HTMLElement>("[data-pane]");
    const form = card.querySelector<HTMLFormElement>('[data-el="form"]');
    const passwordInput = card.querySelector<HTMLInputElement>('[data-el="password"]');
    const confirmInput = card.querySelector<HTMLInputElement>('[data-el="confirm"]');
    const passwordError = card.querySelector<HTMLParagraphElement>('[data-el="password-error"]');
    const passwordHelper = card.querySelector<HTMLParagraphElement>('[data-el="password-helper"]');
    const confirmError = card.querySelector<HTMLParagraphElement>('[data-el="confirm-error"]');
    const formError = card.querySelector<HTMLParagraphElement>('[data-el="form-error"]');
    const submit = card.querySelector<HTMLButtonElement>('[data-el="submit"]');

    function showPane(name: Pane): void {
      panes.forEach((p) => {
        p.hidden = p.dataset.pane !== name;
      });
      if (card) card.dataset.state = name;
    }

    function setFieldError(
      input: HTMLInputElement | null,
      errorEl: HTMLParagraphElement | null,
      message: string,
    ): void {
      if (!input || !errorEl) return;
      const wrap = input.closest<HTMLElement>("[data-input-wrap]");
      if (wrap) wrap.dataset.invalid = "true";
      errorEl.textContent = message;
      errorEl.hidden = false;
    }

    function clearFieldError(
      input: HTMLInputElement | null,
      errorEl: HTMLParagraphElement | null,
    ): void {
      if (!input || !errorEl) return;
      const wrap = input.closest<HTMLElement>("[data-input-wrap]");
      if (wrap) delete wrap.dataset.invalid;
      errorEl.textContent = "";
      errorEl.hidden = true;
    }

    function setFormError(message: string | null): void {
      if (!formError) return;
      if (message) {
        formError.textContent = message;
        formError.hidden = false;
      } else {
        formError.textContent = "";
        formError.hidden = true;
      }
    }

    function validatePassword(value: string): string | null {
      if (!value) return "Введите пароль";
      if (value.length < 8) return "Минимум 8 символов";
      if (!/[A-Z]/.test(value)) return "Нужна заглавная латинская буква";
      if (!/[0-9]/.test(value)) return "Нужна цифра";
      return null;
    }

    // Locale persistence — mirrors verify-email.astro contract.
    const params = new URLSearchParams(location.search);
    const token = params.get("token");
    const lang = params.get("lang");
    if (lang && /^(ru|en|kg)$/.test(lang)) {
      try {
        window.localStorage.setItem("healthy:locale", lang);
        document.documentElement.lang = lang;
      } catch {
        // ignore
      }
    }

    if (!token) {
      showPane("no-token");
    } else {
      // Pre-flight: check that the reset token is still valid BEFORE
      // showing the form. GET /auth/reset-password is non-destructive —
      // it just reports token validity (200 ok / 410 expired / 4xx
      // invalid). The actual password change happens on POST below.
      // Without this step the user would only learn the link expired
      // AFTER typing and submitting a new password — terrible UX.
      verifyToken();
    }

    async function verifyToken(): Promise<void> {
      try {
        const res = await fetch(
          `${apiUrl}/auth/reset-password?token=${encodeURIComponent(token!)}`,
          { method: "GET", headers: { Accept: "application/json" } },
        );
        if (res.ok) {
          showPane("form");
          wireForm();
          return;
        }
        if (res.status === 410) {
          showPane("expired");
          return;
        }
        showPane("error");
      } catch {
        showPane("error");
      }
    }

    function wireForm(): void {
      // Reveal-password toggles
      // Проверка формальна: wireForm вызывается только внутри ветки `if (card)`,
      // но сужение const не доживает до тела функции — как и в showPane выше.
      card?.querySelectorAll<HTMLButtonElement>('[data-action="hm-reset-reveal"]').forEach((btn) => {
        btn.addEventListener("click", () => {
          const targetId = btn.dataset.target;
          if (!targetId) return;
          const input = document.getElementById(targetId) as HTMLInputElement | null;
          if (!input) return;
          const revealed = input.type === "text";
          input.type = revealed ? "password" : "text";
          btn.setAttribute("aria-pressed", revealed ? "false" : "true");
          btn.setAttribute("aria-label", revealed ? "Показать пароль" : "Скрыть пароль");
        });
      });

      // Clear field errors on input
      passwordInput?.addEventListener("input", () => {
        clearFieldError(passwordInput, passwordError);
        if (passwordHelper) passwordHelper.hidden = false;
        setFormError(null);
      });
      confirmInput?.addEventListener("input", () => {
        clearFieldError(confirmInput, confirmError);
        setFormError(null);
      });

      form?.addEventListener("submit", async (event) => {
        event.preventDefault();
        const password = passwordInput?.value ?? "";
        const confirm = confirmInput?.value ?? "";

        clearFieldError(passwordInput, passwordError);
        clearFieldError(confirmInput, confirmError);
        setFormError(null);

        const passErr = validatePassword(password);
        if (passErr) {
          setFieldError(passwordInput, passwordError, passErr);
          if (passwordHelper) passwordHelper.hidden = true;
          return;
        }
        if (!confirm) {
          setFieldError(confirmInput, confirmError, "Повторите пароль");
          return;
        }
        if (password !== confirm) {
          setFieldError(confirmInput, confirmError, "Пароли не совпадают");
          return;
        }

        if (submit) {
          submit.disabled = true;
          submit.textContent = "Сохраняем…";
        }

        try {
          const res = await fetch(`${apiUrl}/auth/reset-password`, {
            method: "POST",
            headers: { "Content-Type": "application/json", Accept: "application/json" },
            body: JSON.stringify({ token, password }),
          });

          if (res.ok) {
            showPane("success");
            return;
          }
          if (res.status === 410) {
            showPane("expired");
            return;
          }
          if (res.status >= 500) {
            setFormError("На нашей стороне сбой. Попробуйте через минуту.");
          } else {
            setFormError("Не удалось сменить пароль. Попробуйте ещё раз.");
          }
        } catch {
          setFormError("Нет связи. Проверьте интернет.");
        } finally {
          if (submit) {
            submit.disabled = false;
            submit.textContent = "Сохранить пароль";
          }
        }
      });
    }
  }
</script>
