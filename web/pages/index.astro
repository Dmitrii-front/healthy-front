---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import LoginModal from "../components/auth/LoginModal.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import {
  buildSpecialtyOptions,
  loadDoctorCatalog,
  formatPriceKgs,
  specialtyKeyOf,
} from "@/entities/doctor";
import { SPECIALTIES } from "@/shared/config";
import { pluralizeDoctors } from "../lib/search/format";
import { doctorProfileSlug } from "../lib/slug";

// ── Design tokens ──────────────────────────────────────────
const N = {
  cream: "#FCFBF8",
  ink: "#0F1115",
  muted: "#5F636A",
  line: "#E2E2DF",
  borderSoft: "#EDEBE6",
};

// Весь каталог верифицированных врачей, вшивается в HTML на сборке.
// Одна лента вместо двух: признака «онлайн / в клинике» в данных нет —
// consultation_formats у всех прод-врачей null, а у сидов приходит
// offline/online, чего фронтовая схема не понимает.
// Тот же кэшированный каталог, что и у страниц врачей: раньше главная
// тянула его вторым независимым обходом.
const doctors = await loadDoctorCatalog();

const HERO_AVATARS = 6;

// ── Hero banners (from design) ─────────────────────────────
const BANNERS = [
  {
    tag: "Запись к врачу",
    title: "Доктор рядом, когда нужен",
    desc: "Найдите специалиста, выберите слот и подтвердите визит — без звонков и ожидания на линии.",
    cta: "Найти врача",
    bg: "linear-gradient(135deg, #DCEEF1 0%, #EEF6F8 60%, #F1E8E0 100%)",
    dark: false,
    art: "booking",
  },
  {
    tag: "Каталог специалистов",
    title: `${doctors.length} ${pluralizeDoctors(doctors.length)} в одном приложении`,
    desc: "Специальность, стаж, языки приёма и цена видны до записи.",
    cta: "Смотреть всех",
    bg: "linear-gradient(135deg, #F6EFE2 0%, #EFE4D0 60%, #DCEEF1 100%)",
    dark: false,
    art: "catalog",
  },
  {
    tag: "В одном месте",
    title: "История визитов и медкарта",
    desc: "Прошлые приёмы, назначения и анализы всегда под рукой — для вас и всей семьи.",
    cta: "Открыть медкарту",
    bg: "linear-gradient(135deg, #EEF6F8 0%, #DCEEF1 100%)",
    dark: false,
    art: "record",
  },
] as const;

// Палитра десктопных карточек специальностей: восемь тонов по кругу.
const SPEC_CARD_PALETTE = [
  { bg: "#B9DCE2", icon: "#0E7C8C" },
  { bg: "#EBDBBE", icon: "#A07842" },
  { bg: "#C5E2D2", icon: "#3A8E64" },
  { bg: "#E8D2BC", icon: "#8E5A2E" },
  { bg: "#C5E0E5", icon: "#2A9DAE" },
  { bg: "#EFC8C8", icon: "#A93A35" },
  { bg: "#D2CFE3", icon: "#473D87" },
  { bg: "#F2D2A8", icon: "#A85518" },
];

// Tile tints for specialty grid (cycling)
const TILE_TINTS = [
  "#DCEEF1",
  "#F1E8E0",
  "#EFE4D0",
  "#E8EFE2",
  "#F1E2E2",
  "#EAE4F0",
  "#F2EAD7",
  "#E2EBEF",
];

// Specialty SVG glyphs (from design, mapped to project specialty labels)
const SPECIALTY_GLYPHS: Record<string, string[]> = {
  Семейный: [
    "M6 3v8a4 4 0 0 0 8 0V3",
    "M10 15v3a4 4 0 0 0 8 0v-3",
    "M18 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z",
  ],
  Скорая: [
    "M14.5 3.5 3.5 14.5a3 3 0 0 0 4.2 4.2L18.7 7.7a3 3 0 0 0-4.2-4.2z",
    "M9 12.5l5.5-5.5",
    "M11 14.5l-5.5 5.5",
  ],
  Кардиология: [
    "M12 21s-7-4-9-9c-1-3 1-7 4-7 2 0 4 2 5 3 1-1 3-3 5-3 3 0 5 4 4 7-2 5-9 9-9 9z",
    "M3 12h4l2-3 3 5 2-2",
  ],
  Неврология: [
    "M9.5 4.5a2.5 2.5 0 0 0-2.5 2.5 2.5 2.5 0 0 0-3 4 2.5 2.5 0 0 0 0 4 2.5 2.5 0 0 0 3 4 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 3-4 2.5 2.5 0 0 0 0-4 2.5 2.5 0 0 0-3-4 2.5 2.5 0 0 0-2.5-2.5 2.5 2.5 0 0 0-2.5 1.5 2.5 2.5 0 0 0-2.5-1.5z",
    "M12 6v14",
  ],
  Окулист: [
    "M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z",
    "M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z",
  ],
  ЖКТ: [
    "M8 4v3c0 4-2 5-2 8a4 4 0 0 0 7-2 4 4 0 0 0 7-1c0-3-2-4-2-7V4",
    "M8 4h10",
    "M12 8h6",
  ],
  Ортопедия: [
    "M5 4a2 2 0 1 0 4 0v0a1 1 0 0 0 1 1l8 8a1 1 0 0 0 1 1v0a2 2 0 1 0 0 4v0a2 2 0 1 0-4 0v0a1 1 0 0 0-1-1l-8-8a1 1 0 0 0-1-1v0a2 2 0 1 0-4 0z",
  ],
  Стоматология: [
    "M8 3c-2 0-4 1.6-4 4.5 0 2.8.7 5 1.5 9 .3 1.5 1 2 1.7 2 .8 0 1.3-.7 1.5-2l1.3-3.5L10.3 13l1.5 0 1.5 0 -1.7-3.4 1.3 3.5c.2 1.3.7 2 1.5 2s1.4-.5 1.7-2c.8-4 1.5-6.2 1.5-9 0-2.9-2-4.5-4-4.5-1 0-2 .5-3 .5s-2-.5-3-.5z",
  ],
};

const specialtyOptions = buildSpecialtyOptions(doctors);
const doctorsBySpecialty = new Map(specialtyOptions.map((o) => [o.key, o.count]));

// Ссылка на выдачу и счётчик врачей считаются здесь один раз на обе сетки
// плиток — мобильную и десктопную. Специальность, которой нет в каталоге,
// остаётся без счётчика: плитка ведёт в поиск, но врачей не обещает.
const specialtyTiles = SPECIALTIES.map((specialty) => {
  const searchKey = specialtyKeyOf(specialty.doctorSpecialty);
  return {
    key: specialty.key,
    label: specialty.label,
    searchKey,
    href: `/search?specialty=${encodeURIComponent(searchKey)}`,
    count: doctorsBySpecialty.get(searchKey),
  };
});

// Десктопная сетка — ровно две крупные карточки в ряд, и «популярные» здесь
// значит «с наибольшим числом врачей»: specialtyOptions уже отсортирован по
// счётчику, поэтому берём первые совпавшие плитки. Раньше тут стояли два
// зашитых ключа, и на реальном каталоге обе карточки вели в пустую выдачу.
const DESKTOP_SPECIALTY_CARDS = 2;
const tilesBySearchKey = new Map(specialtyTiles.map((tile) => [tile.searchKey, tile]));
const featuredSpecialties = specialtyOptions
  .flatMap((option) => tilesBySearchKey.get(option.key) ?? [])
  .slice(0, DESKTOP_SPECIALTY_CARDS);

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  name: "Healthy",
  url: "https://sdoctorom.health",
  // Специальности не перечисляем словами: рядом лежит medicalSpecialty из
  // фактического каталога, и список из макета противоречил бы ему в одном блоке.
  description: "Сервис записи к врачам: специальность, стаж, языки приёма и цена видны до записи.",
  areaServed: [
    { "@type": "City", name: "Бишкек" },
  ],
  medicalSpecialty: specialtyOptions.map((option) => option.label),
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Healthy",
  url: "https://sdoctorom.health",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://sdoctorom.health/search?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
  inLanguage: "ru-RU",
};
---

<BaseLayout
  title="Healthy — запись к врачу в Бишкеке"
  description="Запись к врачу онлайн в Бишкеке. Специальность, стаж, языки приёма и цена видны до записи."
>
  <div class="mw-shell">
    {/* ── TOP BAR ─────────────────────────── */}
    <SiteHeader variant="mobile" />

    {/* ── HERO CAROUSEL (pure CSS auto-rotate) ─ */}
    <section class="mw-hero-wrap">
      <div class="mw-hero">
        <div class="mw-hero-track">
          {BANNERS.map((b) => (
            <article
              class={`mw-banner${b.dark ? " mw-banner-dark" : ""}`}
              style={`background:${b.bg}`}
            >
              <div class="mw-banner-art">
                <img
                  src={`/illustrations/banner-${b.art}.svg`}
                  alt=""
                  width="170"
                  height="170"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <span class="mw-banner-tag">{b.tag}</span>
              <h2 class="mw-banner-title">{b.title}</h2>
              <p class="mw-banner-desc">{b.desc}</p>
              <a href="/search" class="mw-banner-cta tap">
                {b.cta}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
              </a>
            </article>
          ))}
        </div>
        <div class="mw-banner-dots" aria-hidden="true">
          {BANNERS.map(() => <span class="mw-banner-dot" />)}
        </div>
      </div>
    </section>

    {/* ── SEARCH + CHIPS ───────────────────── */}
    <div class="mw-sticky-search" id="mw-sticky-search">
      <form class="mw-search-row" action="/search" method="get" role="search">
        <label class="mw-search-input">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4a7 7 0 1 1 0 14 7 7 0 0 1 0-14z"/><path d="m21 21-4.3-4.3"/></svg>
          <input name="q" type="search" placeholder="Имя или специальность" autocomplete="off" />
        </label>
      </form>
    </div>

    {/* ── SPECIALTY GRID ──────────────────── */}
    <section class="mw-section">
      <div class="mw-section-head">
        <h2>Популярные специальности</h2>
      </div>
      <div class="mw-tile-grid">
        {specialtyTiles.map((s, k) => {
          const paths = SPECIALTY_GLYPHS[s.label] ?? SPECIALTY_GLYPHS["Семейный"]!;
          return (
            <a
              href={s.href}
              class="mw-tile tap"
              style={`background:${TILE_TINTS[k % TILE_TINTS.length]}`}
            >
              <span class="mw-tile-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={N.ink} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  {paths.map((d) => <path d={d} />)}
                </svg>
              </span>
              <span class="mw-tile-name">{s.label}</span>
              {s.count !== undefined && (
                <span class="mw-tile-count">{s.count} {pluralizeDoctors(s.count)}</span>
              )}
            </a>
          );
        })}
      </div>
    </section>

    {/* ── DOCTORS RAIL ────────────────────── */}
    <section class="mw-section">
      <div class="mw-section-head">
        <h2>Врачи</h2>
        <a href="/search" class="mw-section-link">
          Все врачи
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
        </a>
      </div>
      <div class="mw-rail hide-sb">
        {doctors.map((d) => (
          <a href={`/doctor/${doctorProfileSlug(d)}`} class="mw-doctor-card tap">
            <div class="mw-doctor-head">
              <div class="mw-avatar-wrap">
                {d.avatarUrl ? (
                  <img
                    class="mw-avatar mw-avatar-img"
                    src={d.avatarUrl}
                    alt={d.shortName}
                    loading="lazy"
                    decoding="async"
                    width="44"
                    height="44"
                  />
                ) : (
                  <span class="mw-avatar" style={`background-color:${d.avatarColor}`}>
                    {d.initials}
                  </span>
                )}
              </div>
              <div class="mw-doctor-titles">
                <span class="mw-doctor-name">{d.shortName}</span>
                <span class="mw-doctor-spec">{d.specialization}</span>
              </div>
            </div>
            {d.city && (
              <div class="mw-doctor-slot">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-7-7.6-7-13a7 7 0 1 1 14 0c0 5.4-7 13-7 13z"/><path d="M12 11.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/></svg>
                {d.city}
              </div>
            )}
            <div class="mw-doctor-cta-row">
              {formatPriceKgs(d.priceFrom)
                ? <span class="mw-doctor-price">от <strong>{formatPriceKgs(d.priceFrom)}</strong></span>
                : <span />}
              <span class="mw-book-btn">Записаться</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* ── FOOTER ──────────────────────────── */}
    <SiteFooter variant="mobile" />
  </div>

  {/* ════════════════════════════════════════════════════════════ */}
  {/*  DESKTOP LAYOUT (visible at >= 1024px)                       */}
  {/* ════════════════════════════════════════════════════════════ */}
  <div class="dw-page">
    {/* ── HEADER ─────────────────────────────────── */}
    <SiteHeader variant="desktop" />

    {/* ── HERO CAROUSEL (pure CSS auto-rotate) ─── */}
    <section class="dw-hero-section">
      <div class="dw-hero">
        <div class="dw-hero-track">
          {BANNERS.map((b) => (
            <article
              class={`dw-banner${b.dark ? " dw-banner-dark" : ""}`}
              style={`background:${b.bg}`}
            >
              <div class="dw-banner-text">
                <span class="dw-banner-tag">{b.tag}</span>
                <h2 class="dw-banner-title">{b.title}</h2>
                <p class="dw-banner-desc">{b.desc}</p>
                <a href="/search" class="dw-banner-cta">
                  {b.cta}
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
                </a>
              </div>
              <div class="dw-banner-art">
                <img
                  src={`/illustrations/banner-${b.art}.svg`}
                  alt=""
                  width="320"
                  height="320"
                  loading="lazy"
                  decoding="async"
                />
              </div>
            </article>
          ))}
        </div>
        <div class="dw-hero-dots" aria-hidden="true">
          {BANNERS.map(() => <span class="dw-hero-dot" />)}
        </div>
      </div>
    </section>

    {/* ── HERO SEARCH PILL ───────────────────────── */}
    <section class="dw-search-hero">
      <div class="dw-search-hero-inner">
        {/* LEFT — promise + live availability */}
        <div class="dw-search-promise">
          <h2>Найдите своего врача</h2>
          <p>Выбирайте по специальности, языку приёма и цене — всё это видно до записи.</p>
          <div class="dw-live-stack">
            <div class="dw-avatars">
              {doctors.slice(0, HERO_AVATARS).map((d) => (
                <span
                  class="dw-stack-avatar"
                  style={`background-color:${d.avatarColor}`}
                  title={d.fullName}
                >
                  {d.initials}
                </span>
              ))}
              {doctors.length > HERO_AVATARS && (
                <span class="dw-stack-avatar dw-stack-avatar-more">
                  +{doctors.length - HERO_AVATARS}
                </span>
              )}
            </div>
            <div class="dw-live-row">
              <span class="dw-live-pulse" aria-hidden="true" />
              <span>
                <strong>
                  {doctors.length} {pluralizeDoctors(doctors.length)}
                </strong>{" "}
                в каталоге
              </span>
            </div>
          </div>
        </div>

        {/* RIGHT — stacked search card */}
        <div class="dw-search-card-wrap">
          <form class="dw-search-card" action="/search" method="get" role="search">
            <label class="dw-search-row">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4a7 7 0 1 1 0 14 7 7 0 0 1 0-14z"/><path d="m21 21-4.3-4.3"/></svg>
              <span class="dw-row-body">
                <span class="dw-row-label">Имя или фамилия</span>
                <input name="q" type="search" placeholder="Имя или специальность" autocomplete="off" />
              </span>
            </label>
            <label class="dw-search-row dw-search-row-div">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/></svg>
              <span class="dw-row-body">
                <span class="dw-row-label">Специальность</span>
                <select name="specialty">
                  <option value="">Все специальности</option>
                  {SPECIALTIES.map((s) => (
                    <option value={specialtyKeyOf(s.doctorSpecialty)}>{s.label}</option>
                  ))}
                </select>
              </span>
            </label>
            <button type="submit" class="dw-search-submit-wide">
              Найти {doctors.length} {pluralizeDoctors(doctors.length)}
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
            </button>
          </form>
        </div>
      </div>
    </section>

    {/* ── SPECIALTIES (6-col bold pastel) ─────── */}
    {featuredSpecialties.length > 0 && (
      <section class="dw-section dw-specs-section">
        <div class="dw-section-head">
          <div>
            <h2>Популярные специальности</h2>
            <p>Найдите врача по нужному направлению</p>
          </div>
          <a href="/search" class="dw-section-link">
            Все специальности
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </a>
        </div>
        <div class="dw-specs-grid">
          {featuredSpecialties.map((s, i) => {
            const c = SPEC_CARD_PALETTE[i % SPEC_CARD_PALETTE.length]!;
            const paths = SPECIALTY_GLYPHS[s.label] ?? SPECIALTY_GLYPHS["Семейный"]!;
            return (
              <a
                href={s.href}
                class="dw-spec-card is-large"
                style={`background:${c.bg}`}
              >
                <span class="dw-spec-icon" style={`color:${c.icon}`}>
                  <svg width="44" height="44" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                    {paths.map((d) => <path d={d} />)}
                  </svg>
                </span>
                <span class="dw-spec-name">{s.label}</span>
                {s.count !== undefined && (
                  <span class="dw-spec-count">{s.count} {pluralizeDoctors(s.count)}</span>
                )}
              </a>
            );
          })}
        </div>
      </section>
    )}

    {/* ── OFFLINE DOCTORS (plain grid) ─────────── */}
    <section class="dw-section dw-offline-section">
      <div class="dw-section-head">
        <div>
          <span class="dw-tag dw-tag-offline">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h18"/><path d="M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/><path d="M8 3v4"/><path d="M16 3v4"/></svg>
            В клинике
          </span>
          <h2>Врачи</h2>
          <p>Запись с подтверждением, ближайшие даты приёма · {doctors.length} {pluralizeDoctors(doctors.length)}</p>
        </div>
        <a href="/search" class="dw-text-link">Все врачи →</a>
      </div>
      <div class="dw-carousel">
        <div class="dw-carousel-track">
          {doctors.map((d) => (
            <a href={`/doctor/${doctorProfileSlug(d)}`} class="dw-doctor dw-doctor-slide">
              <div class="dw-doctor-head">
                {d.avatarUrl ? (
                  <img
                    class="dw-doctor-avatar dw-doctor-avatar-img"
                    src={d.avatarUrl}
                    alt={d.shortName}
                    loading="lazy"
                    decoding="async"
                    width="56"
                    height="56"
                  />
                ) : (
                  <span class="dw-doctor-avatar" style={`background-color:${d.avatarColor}`}>
                    {d.initials}
                  </span>
                )}
                <div class="dw-doctor-head-body">
                  <span class="dw-doctor-name">{d.shortName}</span>
                  <span class="dw-doctor-spec">{d.specialization}</span>
                </div>
              </div>
            {d.city && (
