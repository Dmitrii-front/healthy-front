---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import LoginButton from "../components/auth/LoginButton.astro";
import LoginModal from "../components/auth/LoginModal.astro";
import { DOCTOR_MOCKS } from "@/entities/doctor/mock/doctors.mock";
import { SPECIALTIES } from "@/entities/specialty";
import { doctorSlug } from "../lib/slug";

// ── Design tokens (TEAL + N) ───────────────────────────────
const TEAL = {
  brand: "#0E7C8C",
  brandHover: "#0A6573",
  brandSoft: "#DCEEF1",
  brandSofter: "#EEF6F8",
};
const N = {
  cream: "#FCFBF8",
  ink: "#0F1115",
  muted: "#5F636A",
  line: "#E2E2DF",
  borderSoft: "#EDEBE6",
};

// ── Hero banners (from design) ─────────────────────────────
const BANNERS = [
  {
    tag: "Запись к врачу",
    title: "Доктор рядом, когда нужен",
    desc: "Найдите специалиста, выберите слот и подтвердите визит — без звонков и ожидания на линии.",
    cta: "Найти врача",
    bg: "linear-gradient(135deg, #DCEEF1 0%, #EEF6F8 60%, #F1E8E0 100%)",
    dark: false,
    art: "family",
  },
  {
    tag: "Видеоконсультация",
    title: "Онлайн-приём за 5 минут",
    desc: "Терапевт, педиатр, психолог по видео. Подключение из приложения, без очередей.",
    cta: "Подключить врача",
    bg: "linear-gradient(135deg, #0A1F25 0%, #0E7C8C 100%)",
    dark: true,
    art: "video",
  },
  {
    tag: "Каталог специалистов",
    title: "2 800+ врачей в одном приложении",
    desc: "Все клиники Бишкека: проверенные специалисты, прозрачные отзывы, реальные слоты.",
    cta: "Смотреть всех",
    bg: "linear-gradient(135deg, #F6EFE2 0%, #EFE4D0 60%, #DCEEF1 100%)",
    dark: false,
    art: "family",
  },
  {
    tag: "В одном месте",
    title: "История визитов и медкарта",
    desc: "Прошлые приёмы, назначения и анализы всегда под рукой — для вас и всей семьи.",
    cta: "Открыть медкарту",
    bg: "linear-gradient(135deg, #EEF6F8 0%, #DCEEF1 100%)",
    dark: false,
    art: "tooth",
  },
] as const;

const SERVICES = [
  {
    name: "Анализы",
    desc: "1 200+ анализов · скидка до 30%",
    count: "52 лаборатории",
    icon: "lab",
    bg: "linear-gradient(135deg, #DCEEF1, #EEF6F8)",
  },
  {
    name: "Диагностика",
    desc: "УЗИ, МРТ, КТ, рентген, ЭКГ",
    count: "180+ центров",
    icon: "scan",
    bg: "linear-gradient(135deg, #F6EFE2, #EFE4D0)",
  },
  {
    name: "Медицинские процедуры",
    desc: "Капельницы, инъекции, физиотерапия",
    count: "320+ кабинетов",
    icon: "syringe",
    bg: "linear-gradient(135deg, #EEF6F8, #F1E8E0)",
  },
];

// Tile tints for specialty grid (cycling)
const TILE_TINTS = [
  "#DCEEF1",
  "#F1E8E0",
  "#EFE4D0",
  "#E8EFE2",
  "#F1E2E2",
  "#EAE4F0",
  "#F2EAD7",
  "#E2EBEF",
];

// Specialty SVG glyphs (from design, mapped to project specialty labels)
const SPECIALTY_GLYPHS: Record<string, string[]> = {
  Семейный: [
    "M6 3v8a4 4 0 0 0 8 0V3",
    "M10 15v3a4 4 0 0 0 8 0v-3",
    "M18 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z",
  ],
  Скорая: [
    "M14.5 3.5 3.5 14.5a3 3 0 0 0 4.2 4.2L18.7 7.7a3 3 0 0 0-4.2-4.2z",
    "M9 12.5l5.5-5.5",
    "M11 14.5l-5.5 5.5",
  ],
  Кардиология: [
    "M12 21s-7-4-9-9c-1-3 1-7 4-7 2 0 4 2 5 3 1-1 3-3 5-3 3 0 5 4 4 7-2 5-9 9-9 9z",
    "M3 12h4l2-3 3 5 2-2",
  ],
  Неврология: [
    "M9.5 4.5a2.5 2.5 0 0 0-2.5 2.5 2.5 2.5 0 0 0-3 4 2.5 2.5 0 0 0 0 4 2.5 2.5 0 0 0 3 4 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 3-4 2.5 2.5 0 0 0 0-4 2.5 2.5 0 0 0-3-4 2.5 2.5 0 0 0-2.5-2.5 2.5 2.5 0 0 0-2.5 1.5 2.5 2.5 0 0 0-2.5-1.5z",
    "M12 6v14",
  ],
  Окулист: [
    "M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z",
    "M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z",
  ],
  ЖКТ: [
    "M8 4v3c0 4-2 5-2 8a4 4 0 0 0 7-2 4 4 0 0 0 7-1c0-3-2-4-2-7V4",
    "M8 4h10",
    "M12 8h6",
  ],
  Ортопедия: [
    "M5 4a2 2 0 1 0 4 0v0a1 1 0 0 0 1 1l8 8a1 1 0 0 0 1 1v0a2 2 0 1 0 0 4v0a2 2 0 1 0-4 0v0a1 1 0 0 0-1-1l-8-8a1 1 0 0 0-1-1v0a2 2 0 1 0-4 0z",
  ],
  Стоматология: [
    "M8 3c-2 0-4 1.6-4 4.5 0 2.8.7 5 1.5 9 .3 1.5 1 2 1.7 2 .8 0 1.3-.7 1.5-2l1.3-3.5L10.3 13l1.5 0 1.5 0 -1.7-3.4 1.3 3.5c.2 1.3.7 2 1.5 2s1.4-.5 1.7-2c.8-4 1.5-6.2 1.5-9 0-2.9-2-4.5-4-4.5-1 0-2 .5-3 .5s-2-.5-3-.5z",
  ],
};

// Service icon paths
const SERVICE_GLYPHS: Record<string, string[]> = {
  lab: [
    "M9 3v6l-5 9a2 2 0 0 0 2 3h12a2 2 0 0 0 2-3l-5-9V3",
    "M9 3h6",
  ],
  scan: [
    "M3 8V5a2 2 0 0 1 2-2h3",
    "M21 8V5a2 2 0 0 0-2-2h-3",
    "M3 16v3a2 2 0 0 0 2 2h3",
    "M21 16v3a2 2 0 0 1-2 2h-3",
    "M7 12h10",
  ],
  syringe: [
    "m18 2 4 4",
    "m17 7 3-3",
    "m19 9-8.5 8.5a2 2 0 0 1-2.8 0L6 16l8-8z",
    "m9 11 4 4",
    "m6 16-3 3 2 2 3-3",
  ],
};

// Top-10 doctors by review count for the online carousel; first 10 for the
// in-clinic carousel (mocks only have 12 entries, so both pools overlap).
const onlineDoctors = [...DOCTOR_MOCKS]
  .sort((a, b) => (b.ratingCount ?? 0) - (a.ratingCount ?? 0))
  .slice(0, 10);
const nearbyDoctors = DOCTOR_MOCKS.slice(0, 10);

// Fake portraits keyed by doctor id, gender-matched to first name.
// Sourced from randomuser.me (stable mirrored stock photos).
// Russian plural for the noun "врач" — 1 врач, 2–4 врача, 5+ врачей.
function pluralizeDoctor(n: number): string {
  const mod100 = n % 100;
  const mod10 = n % 10;
  if (mod100 >= 11 && mod100 <= 14) return "врачей";
  if (mod10 === 1) return "врач";
  if (mod10 >= 2 && mod10 <= 4) return "врача";
  return "врачей";
}

const DOCTOR_PHOTOS: Record<string, string> = {
  d1: "https://randomuser.me/api/portraits/men/22.jpg",
  d2: "https://randomuser.me/api/portraits/men/41.jpg",
  d3: "https://randomuser.me/api/portraits/women/45.jpg",
  d4: "https://randomuser.me/api/portraits/men/67.jpg",
  d5: "https://randomuser.me/api/portraits/women/68.jpg",
  d6: "https://randomuser.me/api/portraits/men/55.jpg",
  d7: "https://randomuser.me/api/portraits/women/52.jpg",
  d8: "https://randomuser.me/api/portraits/men/85.jpg",
  d9: "https://randomuser.me/api/portraits/men/14.jpg",
  d10: "https://randomuser.me/api/portraits/men/36.jpg",
  d11: "https://randomuser.me/api/portraits/women/65.jpg",
  d12: "https://randomuser.me/api/portraits/men/72.jpg",
};

// Fake female doctor portraits for the live availability avatar stack.
// Sourced from randomuser.me (stable mirrored stock photos).
const nearbyAvatars = [
  "https://randomuser.me/api/portraits/women/44.jpg",
  "https://randomuser.me/api/portraits/women/68.jpg",
  "https://randomuser.me/api/portraits/women/12.jpg",
  "https://randomuser.me/api/portraits/women/79.jpg",
  "https://randomuser.me/api/portraits/women/33.jpg",
  "https://randomuser.me/api/portraits/women/90.jpg",
];

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  name: "Healthy",
  url: "https://sdoctorom.health",
  description:
    "Сервис записи к проверенным врачам в Бишкеке и Алматы. Кардиологи, терапевты, педиатры и другие специалисты.",
  areaServed: [
    { "@type": "City", name: "Бишкек" },
    { "@type": "City", name: "Алматы" },
  ],
  medicalSpecialty: SPECIALTIES.map((s) => s.doctorSpecialty),
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Healthy",
  url: "https://sdoctorom.health",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://sdoctorom.health/search?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
  inLanguage: "ru-RU",
};
---

<BaseLayout
  title="Healthy — запись к врачу в Бишкеке и Алматы"
  description="Запись к проверенным врачам онлайн. Кардиологи, терапевты, педиатры, дерматологи, неврологи и другие специалисты в Бишкеке и Алматы."
>
  <div class="mw-shell">
    {/* ── TOP BAR ─────────────────────────── */}
    <header class="mw-topbar" id="mw-topbar">
      <div class="mw-logo">
        <span class="mw-logo-mark">H</span>
        <span class="mw-logo-text">Healthy</span>
      </div>
      <div class="mw-spacer" />
      <div class="mw-cta-slot"><LoginButton /></div>
    </header>

    {/* ── HERO CAROUSEL (pure CSS auto-rotate) ─ */}
    <section class="mw-hero-wrap">
      <div class="mw-hero">
        <div class="mw-hero-track">
          {BANNERS.map((b) => (
            <article
              class={`mw-banner${b.dark ? " mw-banner-dark" : ""}`}
              style={`background:${b.bg}`}
            >
              <div class="mw-banner-art" set:html={
                b.art === "video"
                  ? '<svg viewBox="0 0 200 200" width="170" height="170" fill="none" stroke="rgba(255,255,255,0.85)" stroke-width="0.7" opacity="0.5"><rect x="40" y="60" width="100" height="70" rx="8"/><path d="M140 80l30-15v60l-30-15z"/><circle cx="90" cy="95" r="12"/><path d="M70 130c0-11 9-20 20-20s20 9 20 20"/></svg>'
                  : b.art === "family"
                  ? '<svg viewBox="0 0 200 200" width="170" height="170" fill="none" stroke="#0E7C8C" stroke-width="0.7" opacity="0.5"><circle cx="70" cy="80" r="14"/><path d="M50 130c0-11 9-20 20-20s20 9 20 20"/><circle cx="130" cy="80" r="14"/><path d="M110 130c0-11 9-20 20-20s20 9 20 20"/><circle cx="100" cy="140" r="9"/><path d="M88 165c0-7 5-12 12-12s12 5 12 12"/></svg>'
                  : b.art === "tooth"
                  ? '<svg viewBox="0 0 200 200" width="170" height="170" fill="none" stroke="#0E7C8C" stroke-width="0.7" opacity="0.5"><path d="M70 60c-10 0-18 9-18 22 0 18 8 28 12 50 2 14 6 28 12 28s8-14 12-22 6-12 12-12 8 4 12 12 6 22 12 22 10-14 12-28c4-22 12-32 12-50 0-13-8-22-18-22-12 0-16 8-30 8s-18-8-30-8z"/></svg>'
                  : '<svg viewBox="0 0 200 200" width="170" height="170" fill="none" stroke="#0E7C8C" stroke-width="0.7" opacity="0.5"><path d="M80 50v40l-25 50c-3 7 2 14 9 14h72c7 0 12-7 9-14l-25-50V50"/><path d="M80 50h40"/><circle cx="100" cy="140" r="5"/><circle cx="85" cy="125" r="3"/><circle cx="115" cy="130" r="4"/></svg>'
              } />
              <span class="mw-banner-tag">{b.tag}</span>
              <h2 class="mw-banner-title">{b.title}</h2>
              <p class="mw-banner-desc">{b.desc}</p>
              <a href="/search" class="mw-banner-cta tap">
                {b.cta}
                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
              </a>
            </article>
          ))}
        </div>
        <div class="mw-banner-dots" aria-hidden="true">
          {BANNERS.map(() => <span class="mw-banner-dot" />)}
        </div>
      </div>
    </section>

    {/* ── SEARCH + CHIPS ───────────────────── */}
    <div class="mw-sticky-search" id="mw-sticky-search">
      <input type="checkbox" id="mw-filters-toggle" class="mw-sr-only" />
      <form class="mw-search-row" action="/search" method="get" role="search">
        <label class="mw-search-input">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4a7 7 0 1 1 0 14 7 7 0 0 1 0-14z"/><path d="m21 21-4.3-4.3"/></svg>
          <input name="q" type="search" placeholder="Врач, специальность, клиника" autocomplete="off" />
        </label>
        <label class="mw-search-filter tap" for="mw-filters-toggle" aria-label="Фильтры">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M6 12h12"/><path d="M10 18h4"/></svg>
        </label>
      </form>
      <div class="mw-filters hide-sb">
        <div class="mw-format-toggle" role="tablist">
          <input type="radio" name="mw-fmt" id="mw-fmt-all" class="mw-sr-only" checked />
          <label for="mw-fmt-all" class="mw-fmt-pill">Все</label>
          <input type="radio" name="mw-fmt" id="mw-fmt-online" class="mw-sr-only" />
          <label for="mw-fmt-online" class="mw-fmt-pill">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h13a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H3z"/><path d="m22 8-4 4 4 4z"/></svg>
            Онлайн
          </label>
          <input type="radio" name="mw-fmt" id="mw-fmt-offline" class="mw-sr-only" />
          <label for="mw-fmt-offline" class="mw-fmt-pill">
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9h18"/><path d="M5 5h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7a2 2 0 0 1 2-2z"/><path d="M8 3v4"/><path d="M16 3v4"/></svg>
            В клинике
          </label>
        </div>
        <label class="mw-filter-chip">
          <select name="district">
            <option>Все районы</option>
            <option>Свердловский</option>
            <option>Ленинский</option>
            <option>Первомайский</option>
            <option>Октябрьский</option>
          </select>
        </label>
        <label class="mw-filter-chip">
          <select name="clinic">
            <option>Все клиники</option>
            <option>Медцентр «На Набережной»</option>
            <option>Семейный центр «Северный»</option>
            <option>Клиника «Дерматолог Плюс»</option>
            <option>Травмцентр «Опора»</option>
            <option>Кардиоцентр «Пульс»</option>
            <option>Нейроцентр «Аксон»</option>
            <option>Клиника «ЖКТ-Центр»</option>
            <option>Клиника «Окулюс»</option>
            <option>Стоматология «Жемчуг»</option>
          </select>
        </label>
      </div>
    </div>

    {/* ── SPECIALTY GRID ──────────────────── */}
    <section class="mw-section">
      <div class="mw-section-head">
        <h2>Популярные специальности</h2>
        <a href="/search" class="mw-section-link">
          Все
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
        </a>
      </div>
      <div class="mw-tile-grid">
        {SPECIALTIES.map((s, k) => {
          const paths = SPECIALTY_GLYPHS[s.label] ?? SPECIALTY_GLYPHS["Семейный"]!;
          return (
            <a
              href={`/specialty/${s.key}`}
              class="mw-tile tap"
              style={`background:${TILE_TINTS[k % TILE_TINTS.length]}`}
            >
              <span class="mw-tile-icon">
                <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke={N.ink} stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  {paths.map((d) => <path d={d} />)}
                </svg>
              </span>
              <span class="mw-tile-name">{s.label}</span>
              <span class="mw-tile-count">{s.count} врачей</span>
            </a>
          );
        })}
      </div>
    </section>

    {/* ── ONLINE DOCTORS RAIL ─────────────── */}
    <section class="mw-section">
      <div class="mw-section-head">
        <h2>Онлайн-консультации</h2>
        <a href="/search" class="mw-section-link">
          Все врачи
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
        </a>
      </div>
      <div class="mw-rail hide-sb">
        {onlineDoctors.map((d) => (
          <a href={`/doctor/${doctorSlug(d)}`} class="mw-doctor-card tap">
            <div class="mw-doctor-head">
              <div class="mw-avatar-wrap">
                <img
                  class="mw-avatar mw-avatar-img"
                  src={DOCTOR_PHOTOS[d.id]}
                  alt={d.name}
                  loading="lazy"
                  decoding="async"
                  width="44"
                  height="44"
                />
                <span class="mw-avatar-online" />
              </div>
              <div class="mw-doctor-titles">
                <span class="mw-doctor-name">{d.name.split(" ").slice(0, 2).join(" ")}</span>
                <span class="mw-doctor-spec">{d.specialty}</span>
              </div>
            </div>
            <div class="mw-doctor-meta">
              <span class="mw-rating">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="#E8B96A"><path d="M12 2.5l3 6.4 7 1-5 4.9 1.2 7L12 18.4 5.8 21.8 7 14.8 2 9.9l7-1z"/></svg>
                {d.rating?.toFixed(1) ?? "—"}
              </span>
              <span class="mw-doctor-muted">{d.ratingCount ?? 0} отзывов</span>
              {d.yearsExperience && <span class="mw-doctor-muted">· {d.yearsExperience} лет</span>}
            </div>
            <div class="mw-doctor-slot mw-doctor-slot-online">
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h13a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H3z"/><path d="m22 8-4 4 4 4z"/></svg>
              Видео — через 15 мин
            </div>
            <div class="mw-doctor-cta-row">
              <span class="mw-doctor-price">от <strong>2 200 ₽</strong></span>
              <span class="mw-book-btn">Записаться</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    {/* ── NEARBY DOCTORS RAIL ─────────────── */}
    <section class="mw-section">
      <div class="mw-section-head">
        <h2>По записи в клинику</h2>
        <a href="/search" class="mw-section-link">
          На карте
          <svg width="11" height="11" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
        </a>
      </div>
      <div class="mw-rail hide-sb">
        {nearbyDoctors.map((d) => (
          <a href={`/doctor/${doctorSlug(d)}`} class="mw-doctor-card tap">
            <div class="mw-doctor-head">
              <img
                class="mw-avatar mw-avatar-img"
                src={DOCTOR_PHOTOS[d.id]}
                alt={d.name}
                loading="lazy"
                decoding="async"
                width="44"
                height="44"
              />
              <div class="mw-doctor-titles">
                <span class="mw-doctor-name">{d.name.split(" ").slice(0, 2).join(" ")}</span>
                <span class="mw-doctor-spec">{d.specialty}</span>
              </div>
            </div>
            <div class="mw-doctor-meta">
              <span class="mw-rating">
                <svg width="11" height="11" viewBox="0 0 24 24" fill="#E8B96A"><path d="M12 2.5l3 6.4 7 1-5 4.9 1.2 7L12 18.4 5.8 21.8 7 14.8 2 9.9l7-1z"/></svg>
                {d.rating?.toFixed(1) ?? "—"}
              </span>
              <span class="mw-doctor-muted">{d.ratingCount ?? 0} отзывов</span>
