      /* ── Section heads ─────────────────────── */
      .dw-section { max-width: 1440px; margin: 0 auto; padding: 48px 64px; }
      .dw-section + .dw-section { padding-top: 0; }
      .dw-search-hero + .dw-section { padding-top: 0; }
      .dw-specs-section { border-top: 1px solid var(--borderSoft, #EDEBE6); }
      .dw-section-head {
        display: flex; justify-content: space-between; align-items: flex-end;
        gap: 24px; margin-bottom: 32px;
      }
      .dw-section-head h2 {
