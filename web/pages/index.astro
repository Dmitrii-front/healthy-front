---
import BaseLayout from "../layouts/BaseLayout.astro";
import JsonLd from "../components/seo/JsonLd.astro";
import LoginModal from "../components/auth/LoginModal.astro";
import SiteHeader from "../components/layout/SiteHeader.astro";
import SiteFooter from "../components/layout/SiteFooter.astro";
import {
  buildSpecialtyOptions,
  loadDoctorCatalog,
  formatPriceKgs,
  specialtyKeyOf,
} from "@/entities/doctor";
import { SPECIALTIES } from "@/shared/config";
import { pluralizeDoctors } from "../lib/search/format";
import { doctorProfileSlug } from "../lib/slug";

// Весь каталог верифицированных врачей, вшивается в HTML на сборке.
// Одна лента вместо двух: признака «онлайн / в клинике» в данных нет —
// consultation_formats у всех прод-врачей null, а у сидов приходит
// offline/online, чего фронтовая схема не понимает.
// Тот же кэшированный каталог, что и у страниц врачей: раньше главная
// тянула его вторым независимым обходом.
const doctors = await loadDoctorCatalog();

const HERO_AVATARS = 6;

const BANNERS = [
  {
    tag: "Запись к врачу",
    title: "Доктор рядом, когда нужен",
    desc: "Найдите специалиста, выберите слот и подтвердите визит — без звонков и ожидания на линии.",
    cta: "Найти врача",
    bg: "linear-gradient(135deg, #DCEEF1 0%, #EEF6F8 60%, #F1E8E0 100%)",
    art: "booking",
  },
  {
    tag: "Каталог специалистов",
    title: `${doctors.length} ${pluralizeDoctors(doctors.length)} в одном приложении`,
    desc: "Специальность, стаж, языки приёма и цена видны до записи.",
    cta: "Смотреть всех",
    bg: "linear-gradient(135deg, #F6EFE2 0%, #EFE4D0 60%, #DCEEF1 100%)",
    art: "catalog",
  },
  {
    tag: "В одном месте",
    title: "История визитов и медкарта",
    desc: "Прошлые приёмы, назначения и анализы всегда под рукой — для вас и всей семьи.",
    cta: "Открыть медкарту",
    bg: "linear-gradient(135deg, #EEF6F8 0%, #DCEEF1 100%)",
    art: "record",
  },
] as const;

// Два тона на плитку: пастельный — фон в общей сетке, насыщенный — фон крупной
// карточки на широком экране. Цвет значка один на оба.
const TILE_TINTS = [
  "#DCEEF1",
  "#F1E8E0",
  "#EFE4D0",
  "#E8EFE2",
  "#F1E2E2",
  "#EAE4F0",
  "#F2EAD7",
  "#E2EBEF",
];

const SPEC_CARD_PALETTE = [
  { bg: "#B9DCE2", icon: "#0E7C8C" },
  { bg: "#EBDBBE", icon: "#A07842" },
  { bg: "#C5E2D2", icon: "#3A8E64" },
  { bg: "#E8D2BC", icon: "#8E5A2E" },
  { bg: "#C5E0E5", icon: "#2A9DAE" },
  { bg: "#EFC8C8", icon: "#A93A35" },
  { bg: "#D2CFE3", icon: "#473D87" },
  { bg: "#F2D2A8", icon: "#A85518" },
];

const SPECIALTY_GLYPHS: Record<string, string[]> = {
  Семейный: [
    "M6 3v8a4 4 0 0 0 8 0V3",
    "M10 15v3a4 4 0 0 0 8 0v-3",
    "M18 14a2 2 0 1 0 0-4 2 2 0 0 0 0 4z",
  ],
  Скорая: [
    "M14.5 3.5 3.5 14.5a3 3 0 0 0 4.2 4.2L18.7 7.7a3 3 0 0 0-4.2-4.2z",
    "M9 12.5l5.5-5.5",
    "M11 14.5l-5.5 5.5",
  ],
  Кардиология: [
    "M12 21s-7-4-9-9c-1-3 1-7 4-7 2 0 4 2 5 3 1-1 3-3 5-3 3 0 5 4 4 7-2 5-9 9-9 9z",
    "M3 12h4l2-3 3 5 2-2",
  ],
  Неврология: [
    "M9.5 4.5a2.5 2.5 0 0 0-2.5 2.5 2.5 2.5 0 0 0-3 4 2.5 2.5 0 0 0 0 4 2.5 2.5 0 0 0 3 4 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 5 0 2.5 2.5 0 0 0 3-4 2.5 2.5 0 0 0 0-4 2.5 2.5 0 0 0-3-4 2.5 2.5 0 0 0-2.5-2.5 2.5 2.5 0 0 0-2.5 1.5 2.5 2.5 0 0 0-2.5-1.5z",
    "M12 6v14",
  ],
  Окулист: [
    "M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7z",
    "M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6z",
  ],
  ЖКТ: [
    "M8 4v3c0 4-2 5-2 8a4 4 0 0 0 7-2 4 4 0 0 0 7-1c0-3-2-4-2-7V4",
    "M8 4h10",
    "M12 8h6",
  ],
  Ортопедия: [
    "M5 4a2 2 0 1 0 4 0v0a1 1 0 0 0 1 1l8 8a1 1 0 0 0 1 1v0a2 2 0 1 0 0 4v0a2 2 0 1 0-4 0v0a1 1 0 0 0-1-1l-8-8a1 1 0 0 0-1-1v0a2 2 0 1 0-4 0z",
  ],
  Стоматология: [
    "M8 3c-2 0-4 1.6-4 4.5 0 2.8.7 5 1.5 9 .3 1.5 1 2 1.7 2 .8 0 1.3-.7 1.5-2l1.3-3.5L10.3 13l1.5 0 1.5 0 -1.7-3.4 1.3 3.5c.2 1.3.7 2 1.5 2s1.4-.5 1.7-2c.8-4 1.5-6.2 1.5-9 0-2.9-2-4.5-4-4.5-1 0-2 .5-3 .5s-2-.5-3-.5z",
  ],
};

const specialtyOptions = buildSpecialtyOptions(doctors);
const doctorsBySpecialty = new Map(specialtyOptions.map((o) => [o.key, o.count]));

// Ссылка на выдачу, счётчик врачей и оба тона считаются здесь: разметка сетки
// одна на все размеры экрана. Специальность, которой нет в каталоге, остаётся
// без счётчика: плитка ведёт в поиск, но врачей не обещает.
const specialtyTiles = SPECIALTIES.map((specialty, index) => {
  const searchKey = specialtyKeyOf(specialty.doctorSpecialty);
  const palette = SPEC_CARD_PALETTE[index % SPEC_CARD_PALETTE.length]!;
  return {
    key: specialty.key,
    label: specialty.label,
    searchKey,
    href: `/search?specialty=${encodeURIComponent(searchKey)}`,
    count: doctorsBySpecialty.get(searchKey),
    tint: TILE_TINTS[index % TILE_TINTS.length]!,
    tintStrong: palette.bg,
    glyphColor: palette.icon,
    paths: SPECIALTY_GLYPHS[specialty.label] ?? SPECIALTY_GLYPHS["Семейный"]!,
  };
});

// «Популярные» здесь значит «с наибольшим числом врачей»: specialtyOptions уже
// отсортирован по счётчику, поэтому берём первые совпавшие плитки. Раньше тут
// стояли два зашитых ключа, и на реальном каталоге обе карточки вели в пустую
// выдачу. Крупными эти две становятся только на широком экране — в общей сетке
// на телефоне все плитки одного размера.
const FEATURED_SPECIALTY_CARDS = 2;
const tilesBySearchKey = new Map(specialtyTiles.map((tile) => [tile.searchKey, tile]));
const featuredKeys = new Set(
  specialtyOptions
    .flatMap((option) => tilesBySearchKey.get(option.key) ?? [])
    .slice(0, FEATURED_SPECIALTY_CARDS)
    .map((tile) => tile.searchKey),
);

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "MedicalBusiness",
  name: "Healthy",
  url: "https://sdoctorom.health",
  // Специальности не перечисляем словами: рядом лежит medicalSpecialty из
  // фактического каталога, и список из макета противоречил бы ему в одном блоке.
  description: "Сервис записи к врачам: специальность, стаж, языки приёма и цена видны до записи.",
  areaServed: [
    { "@type": "City", name: "Бишкек" },
  ],
  medicalSpecialty: specialtyOptions.map((option) => option.label),
};

const websiteJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Healthy",
  url: "https://sdoctorom.health",
  potentialAction: {
    "@type": "SearchAction",
    target: "https://sdoctorom.health/search?q={search_term_string}",
    "query-input": "required name=search_term_string",
  },
  inLanguage: "ru-RU",
};
---

<BaseLayout
  title="Healthy — запись к врачу в Бишкеке"
  description="Запись к врачу онлайн в Бишкеке. Специальность, стаж, языки приёма и цена видны до записи."
>
  {/* Одно адаптивное дерево, как на странице врача.
      Обе версии обвязки стоят подряд, лишнюю прячет site-chrome.css. Разница
      между размерами экрана выражена только стилями: разметка баннера, плитки
      и карточки врача — в единственном экземпляре. */}
  <div class="min-h-dvh bg-[#faf8f5]">
    <SiteHeader variant="mobile" />
    <SiteHeader variant="desktop" />

    <main>
      <section class="hm-home-hero hm-home-shell">
        <div class="hm-home-hero-frame">
          <div class="hm-home-hero-track">
            {BANNERS.map((b) => (
              <article class="hm-home-banner" style={`background:${b.bg}`}>
                <div class="hm-home-banner-text">
                  <span class="hm-home-banner-tag">{b.tag}</span>
                  <h2 class="hm-home-banner-title">{b.title}</h2>
                  <p class="hm-home-banner-desc">{b.desc}</p>
                  <a href="/search" class="hm-home-banner-cta tap">
                    {b.cta}
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
                  </a>
                </div>
                <div class="hm-home-banner-art">
                  <img
                    src={`/illustrations/banner-${b.art}.svg`}
                    alt=""
                    width="320"
                    height="320"
                    loading="lazy"
                    decoding="async"
                  />
                </div>
              </article>
            ))}
          </div>
          <div class="hm-home-hero-dots" aria-hidden="true">
            {BANNERS.map(() => <span class="hm-home-hero-dot" />)}
          </div>
        </div>
      </section>

      <section class="hm-home-find hm-home-shell">
        <div>
          <h2 class="hm-home-find-title">Найдите своего врача</h2>
          <p class="hm-home-find-desc">
            Выбирайте по специальности, языку приёма и цене — всё это видно до записи.
          </p>
          <div class="hm-home-live">
            <div class="hm-home-avatars" aria-hidden="true">
              {doctors.slice(0, HERO_AVATARS).map((d) => (
                <Fragment>
                  {d.avatarUrl && (
                    <img
                      class="hm-home-avatar hm-home-avatar-img"
                      data-avatar-img
                      src={d.avatarUrl}
                      alt=""
                      title={d.fullName}
                      loading="lazy"
                      decoding="async"
                      width="40"
                      height="40"
                    />
                  )}
                  <span
                    class="hm-home-avatar"
                    style={`background-color:${d.avatarColor}`}
                    title={d.fullName}
                    hidden={d.avatarUrl !== null}
                  >
                    {d.initials}
                  </span>
                </Fragment>
              ))}
              {doctors.length > HERO_AVATARS && (
                <span class="hm-home-avatar hm-home-avatar-more">
                  +{doctors.length - HERO_AVATARS}
                </span>
              )}
            </div>
            <p class="hm-home-live-row">
              <span class="hm-home-pulse" aria-hidden="true" />
              <span>
                <strong>{doctors.length} {pluralizeDoctors(doctors.length)}</strong> в каталоге
              </span>
            </p>
          </div>
        </div>

        <form class="hm-home-find-card" action="/search" method="get" role="search">
          <label class="hm-home-find-row">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4a7 7 0 1 1 0 14 7 7 0 0 1 0-14z"/><path d="m21 21-4.3-4.3"/></svg>
            <span class="hm-home-find-body">
              <span class="hm-home-find-label">Имя или фамилия</span>
              <input name="q" type="search" placeholder="Имя или специальность" autocomplete="off" class="hm-home-find-control" />
            </span>
          </label>
          <label class="hm-home-find-row hm-home-find-row-div">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4M16 2v4M3 10h18M5 6h14a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2z"/></svg>
            <span class="hm-home-find-body">
              <span class="hm-home-find-label">Специальность</span>
              <select name="specialty" class="hm-home-find-control">
                <option value="">Все специальности</option>
                {SPECIALTIES.map((s) => (
                  <option value={specialtyKeyOf(s.doctorSpecialty)}>{s.label}</option>
                ))}
              </select>
            </span>
          </label>
          <button type="submit" class="hm-home-find-submit">
            Найти {doctors.length} {pluralizeDoctors(doctors.length)}
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m13 5 7 7-7 7"/></svg>
          </button>
        </form>
      </section>

      <section class="hm-home-section hm-home-specs hm-home-shell">
        <div class="hm-home-section-head">
          <div>
            <h2>Популярные специальности</h2>
            <p>Найдите врача по нужному направлению</p>
          </div>
          <a href="/search" class="hm-home-section-link">
            Все специальности
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
          </a>
        </div>
        <div class="hm-home-spec-grid">
          {specialtyTiles.map((tile) => (
            <a
              href={tile.href}
              class:list={["hm-home-spec", "tap", featuredKeys.has(tile.searchKey) && "is-featured"]}
              style={`--tint:${tile.tint};--tint-strong:${tile.tintStrong};--glyph:${tile.glyphColor}`}
            >
              <span class="hm-home-spec-glyph">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  {tile.paths.map((d) => <path d={d} />)}
                </svg>
              </span>
              <span class="hm-home-spec-name">{tile.label}</span>
              {tile.count !== undefined && (
                <span class="hm-home-spec-count">{tile.count} {pluralizeDoctors(tile.count)}</span>
              )}
            </a>
          ))}
        </div>
      </section>

      <section class="hm-home-section hm-home-shell">
        <div class="hm-home-section-head">
          <div>
            <h2>Врачи</h2>
            <p>Запись с подтверждением · {doctors.length} {pluralizeDoctors(doctors.length)}</p>
          </div>
          <a href="/search" class="hm-home-section-link">
            Все врачи
            <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 6 6 6-6 6"/></svg>
          </a>
        </div>
        <div class="hm-home-rail hide-sb">
          {doctors.map((d) => (
            <a href={`/doctor/${doctorProfileSlug(d)}`} class="hm-home-doc tap">
              <div class="hm-home-doc-head">
                {d.avatarUrl && (
                  <img
                    class="hm-home-doc-avatar hm-home-doc-avatar-img"
                    data-avatar-img
                    src={d.avatarUrl}
                    alt=""
                    loading="lazy"
                    decoding="async"
                    width="56"
                    height="56"
                  />
                )}
                {/* aria-hidden: инициалы — это отсутствующее фото, а не
                    содержание. Имя стоит следующим элементом, и без этого
                    скринридер читает «П А Петров А.И.».
                    Подложка стоит в разметке и под снимком: на битой ссылке её
                    показывает watchAvatars, и ищет она её соседом снимка. */}
                <span
                  class="hm-home-doc-avatar"
                  style={`background-color:${d.avatarColor}`}
                  aria-hidden="true"
                  hidden={d.avatarUrl !== null}
                >
                  {d.initials}
                </span>
                <div class="hm-home-doc-titles">
                  <span class="hm-home-doc-name">{d.shortName}</span>
                  <span class="hm-home-doc-spec">{d.specialization}</span>
                </div>
              </div>
              {d.city && (
                <div class="hm-home-doc-place">
                  <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s-7-7.6-7-13a7 7 0 1 1 14 0c0 5.4-7 13-7 13z"/><path d="M12 11.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z"/></svg>
                  {d.city}
                </div>
              )}
              <div class="hm-home-doc-foot">
                {formatPriceKgs(d.priceFrom) && (
                  <span class="hm-home-doc-price">от <strong>{formatPriceKgs(d.priceFrom)}</strong></span>
                )}
                <span class="hm-home-doc-book">Записаться</span>
              </div>
            </a>
          ))}
        </div>
      </section>
    </main>

    <SiteFooter variant="mobile" />
    <SiteFooter variant="desktop" />
  </div>

  <JsonLd data={orgJsonLd} />
  <JsonLd data={websiteJsonLd} />

  <style is:global>
    :root {
      --teal: #0e7c8c;
      --teal-hover: #0a6573;
      --teal-soft: #dceef1;
      --teal-softer: #eef6f8;
      --n-cream: #fcfbf8;
      --n-ink: #0f1115;
      --n-ink2: #2a2d33;
      --n-muted: #5f636a;
      --n-line: #e2e2df;
      --n-line-soft: #edebe6;
    }
    body {
      background: var(--n-cream);
      color: var(--n-ink);
      overscroll-behavior-y: none;
    }
    .hide-sb::-webkit-scrollbar { display: none; }
    .hide-sb { scrollbar-width: none; -ms-overflow-style: none; }
    .tap { -webkit-tap-highlight-color: transparent; transition: transform .14s ease, opacity .14s ease; }
    .tap:active { transform: scale(0.98); opacity: 0.9; }

    /* Колонка та же, что у шапки и подвала: главная остаётся широкой
       страницей — .hm-page с его 960px здесь намеренно не стоит. */
    .hm-home-shell {
      max-width: var(--site-max);
      margin-inline: auto;
      padding-inline: 16px;
    }

    /* ── Герой ──────────────────────────────── */
    /* Только padding-block: сокращённый padding обнулил бы боковое поле,
       которое секции задаёт .hm-home-shell. */
    .hm-home-hero { padding-block: 8px 16px; }
    .hm-home-hero-frame {
      position: relative;
      border-radius: 22px;
      overflow: hidden;
      box-shadow: 0 1px 0 rgba(15,17,21,0.04), 0 18px 40px -28px rgba(15,17,21,0.25);
    }
    .hm-home-hero-track {
      display: grid;
      grid-auto-flow: column;
      grid-auto-columns: 100%;
      animation: hm-home-hero-cycle 18s infinite;
    }
    .hm-home-hero-frame:hover .hm-home-hero-track,
    .hm-home-hero-frame:hover .hm-home-hero-dot { animation-play-state: paused; }
    /* Слайд держится 5с и уезжает за 1с; проценты считаны от цикла 18с на три
       баннера. Добавится баннер — цикл и все проценты пересчитывать заново. */
    @keyframes hm-home-hero-cycle {
      0%, 27.78% { transform: translateX(0%); }
      33.33%, 61.11% { transform: translateX(-100%); }
      66.67%, 100% { transform: translateX(-200%); }
    }

    .hm-home-banner {
      position: relative;
      overflow: hidden;
      min-height: 220px;
      padding: 20px 22px 22px;
      color: var(--n-ink);
    }
    .hm-home-banner-text {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 10px;
    }
    .hm-home-banner-tag {
      padding: 5px 10px;
      border-radius: 999px;
      background: rgba(15,17,21,0.06);
      color: var(--n-ink);
      font-size: 11px;
      font-weight: 700;
      letter-spacing: 0.3px;
      text-transform: uppercase;
    }
    .hm-home-banner-title {
      margin: 0;
      max-width: 175px;
      font-size: 22px;
      line-height: 1.18;
      font-weight: 800;
      letter-spacing: -0.2px;
    }
    .hm-home-banner-desc {
      margin: 0;
      max-width: 200px;
      font-size: 13.5px;
      line-height: 1.45;
      color: var(--n-muted);
    }
    .hm-home-banner-cta {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      margin-top: 4px;
      padding: 11px 16px;
      border-radius: 999px;
      background: var(--teal);
      color: #fff;
      font-size: 14px;
      font-weight: 700;
      box-shadow: 0 6px 14px -6px rgba(14,124,140,0.55);
    }
    .hm-home-banner-art {
      position: absolute;
      right: -14px;
      top: 8px;
      width: 160px;
      height: 160px;
      pointer-events: none;
    }
    .hm-home-banner-art img { width: 100%; height: 100%; display: block; }

    .hm-home-hero-dots {
      position: absolute;
      bottom: 12px;
      right: 14px;
      z-index: 2;
      display: flex;
      gap: 6px;
    }
    /* Размер точки вынесен в переменные: кадры анимации одни на оба размера
       экрана, а меняется в них только ширина. */
    .hm-home-hero-dot {
      --dot: 6px;
      --dot-on: 18px;
      width: var(--dot);
      height: var(--dot);
      border-radius: 999px;
      background: rgba(15,17,21,0.18);
      animation: hm-home-dot 18s infinite;
    }
    .hm-home-hero-dot:nth-child(1) { animation-delay: 0s; }
    .hm-home-hero-dot:nth-child(2) { animation-delay: -12s; }
    .hm-home-hero-dot:nth-child(3) { animation-delay: -6s; }
    @keyframes hm-home-dot {
      0%, 27.78% { width: var(--dot-on); background: var(--teal); }
      33.33%, 100% { width: var(--dot); background: rgba(15,17,21,0.18); }
    }
    @media (prefers-reduced-motion: reduce) {
      .hm-home-hero-track,
      .hm-home-hero-dot,
      .hm-home-pulse { animation: none; }
    }

    /* ── Поиск ──────────────────────────────── */
    .hm-home-find { display: grid; gap: 24px; padding-bottom: 28px; }
    .hm-home-find-title {
      margin: 0;
      font-size: 26px;
      font-weight: 700;
      line-height: 1.1;
      letter-spacing: -0.02em;
    }
    .hm-home-find-desc {
      margin: 10px 0 0;
      max-width: 380px;
      font-size: 14px;
      line-height: 1.5;
      color: var(--n-muted);
    }
    .hm-home-live { margin-top: 18px; }
    .hm-home-avatars { display: flex; align-items: center; }
    .hm-home-avatar {
      width: 34px;
      height: 34px;
      margin-left: -10px;
      border: 2px solid var(--n-cream);
      border-radius: 50%;
      background-color: var(--teal-softer);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      color: var(--n-ink);
      box-shadow: 0 1px 2px rgba(0,0,0,0.06);
    }
    /* min-width: 0 — чтобы снимок ужимался наравне с инициалами: у картинки
       минимальный размер берётся из неё самой, и на тесной раскладке она одна
       осталась бы круглой среди сплющенных кружков. */
    .hm-home-avatar-img { object-fit: cover; min-width: 0; }
    .hm-home-avatar[hidden] { display: none; }
    /* Первый в стопке не заезжает на соседа. Второй строкой — тот же первый,
       когда его снимок не открылся: инициалы встают на место снимка, а не
       с нахлёстом на край блока. */
    .hm-home-avatar:first-child,
    .hm-home-avatar-img:first-child[hidden] + .hm-home-avatar { margin-left: 0; }
    .hm-home-avatar-more { background: var(--teal-softer); color: var(--teal); font-size: 11px; letter-spacing: -0.02em; }
    .hm-home-live-row {
      margin-top: 12px;
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 13.5px;
      color: var(--n-ink2);
    }
    .hm-home-live-row strong { color: var(--n-ink); font-weight: 700; }
    .hm-home-pulse {
      width: 8px;
      height: 8px;
      flex-shrink: 0;
      border-radius: 50%;
      background: #22c55e;
      animation: hm-home-pulse 1.6s ease-out infinite;
    }
    @keyframes hm-home-pulse {
      0% { box-shadow: 0 0 0 0 rgba(34,197,94,0.6); }
      70% { box-shadow: 0 0 0 8px rgba(34,197,94,0); }
      100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); }
    }

    .hm-home-find-card {
      background: #fff;
      border: 1px solid var(--n-line);
      border-radius: 18px;
      box-shadow: 0 2px 8px rgba(10,31,37,0.05);
      overflow: hidden;
    }
    .hm-home-find-row {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 14px 16px;
      color: var(--n-muted);
    }
    .hm-home-find-row-div { border-top: 1px solid var(--n-line-soft); }
    .hm-home-find-body { display: flex; flex-direction: column; flex: 1; min-width: 0; }
    .hm-home-find-label {
      font-size: 10.5px;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--n-muted);
    }
    .hm-home-find-control {
      margin-top: 1px;
      padding: 0;
      border: none;
      outline: none;
      width: 100%;
      appearance: none;
      background: transparent;
      font-family: inherit;
      font-size: 15px;
      font-weight: 600;
      color: var(--n-ink);
      cursor: pointer;
    }
    .hm-home-find-submit {
      margin: 14px;
      width: calc(100% - 28px);
      height: 50px;
      padding: 0 24px;
      border: none;
      border-radius: 14px;
      background: var(--teal);
      color: #fff;
      font-family: inherit;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      box-shadow: 0 2px 8px rgba(14,124,140,0.22);
      transition: background 0.15s;
    }
    .hm-home-find-submit:hover { background: var(--teal-hover); }

    /* ── Секции ─────────────────────────────── */
    .hm-home-section { padding-bottom: 32px; }
    .hm-home-section-head {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 12px;
    }
    .hm-home-section-head h2 { margin: 0; font-size: 18px; font-weight: 800; letter-spacing: -0.2px; }
    .hm-home-section-head p { margin: 6px 0 0; font-size: 12.5px; color: var(--n-muted); }
    .hm-home-section-link {
      flex-shrink: 0;
      display: inline-flex;
      align-items: center;
      gap: 4px;
      color: var(--teal);
      font-size: 13px;
      font-weight: 700;
      white-space: nowrap;
    }

    /* ── Специальности ──────────────────────── */
    .hm-home-spec-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; }
    .hm-home-spec {
      min-width: 0;
      min-height: 110px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 8px;
      padding: 14px;
      border-radius: 16px;
      background: var(--tint);
      color: var(--n-ink);
    }
    .hm-home-spec-glyph {
      width: 36px;
      height: 36px;
      border-radius: 10px;
      background: rgba(255,255,255,0.6);
      color: var(--glyph);
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
    .hm-home-spec-glyph svg { width: 22px; height: 22px; }
    /* Подпись растянута на всю плитку и переносится по слогам: в три колонки
       на телефоне «Стоматология» и «Кардиология» шире плитки, а колонка
       выровнена по левому краю — без обоих свойств длинное слово вылезает за
       край. */
    .hm-home-spec-name {
      align-self: stretch;
      -webkit-hyphens: auto;
      hyphens: auto;
      font-size: 13px;
      font-weight: 700;
      line-height: 1.2;
    }
    .hm-home-spec-count { margin-top: auto; font-size: 11.5px; color: var(--n-muted); }

    /* ── Лента врачей ───────────────────────── */
    /* Отрицательное поле гасит боковой отступ колонки, padding возвращает его
       первой и последней карточке: лента доезжает до края экрана, а заголовок
       секции остаётся в полях. */
    .hm-home-rail {
      display: flex;
      gap: 12px;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      scroll-snap-type: x mandatory;
      scroll-padding: 0 16px;
      margin-inline: -16px;
      padding: 0 16px 4px;
    }
    .hm-home-doc {
      flex: 0 0 268px;
      scroll-snap-align: start;
      display: flex;
      flex-direction: column;
      gap: 12px;
      padding: 14px;
      background: #fff;
      border: 1px solid var(--n-line);
      border-radius: 18px;
      color: var(--n-ink);
    }
    .hm-home-doc-head { display: flex; align-items: center; gap: 12px; }
    .hm-home-doc-avatar {
      width: 48px;
      height: 48px;
      flex: 0 0 auto;
      border-radius: 999px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      font-size: 14px;
      font-weight: 700;
      color: var(--n-ink);
    }
    .hm-home-doc-avatar-img { object-fit: cover; background-color: var(--n-line); }
    /* display у класса перебивает display:none из [hidden] в стилях браузера,
       и без этой строки снимок с инициалами стоят в карточке разом. */
    .hm-home-doc-avatar[hidden] { display: none; }
    .hm-home-doc-titles { min-width: 0; flex: 1; display: flex; flex-direction: column; gap: 2px; }
    .hm-home-doc-name {
      font-size: 14px;
      font-weight: 700;
      line-height: 1.2;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .hm-home-doc-spec {
      font-size: 12px;
      color: var(--n-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .hm-home-doc-place {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 12px;
      font-weight: 600;
      color: var(--n-muted);
    }
    .hm-home-doc-foot { display: flex; align-items: center; gap: 10px; margin-top: auto; }
    .hm-home-doc-price { font-size: 11px; color: var(--n-muted); }
    .hm-home-doc-price strong { margin-left: 2px; font-size: 14px; font-weight: 800; color: var(--n-ink); }
    .hm-home-doc-book {
      margin-left: auto;
      padding: 8px 14px;
      border-radius: 999px;
      background: var(--teal);
      color: #fff;
      font-size: 12.5px;
      font-weight: 700;
    }

    /* ════════════════════════════════════════════════════════════ */
    /*  ≥768px — тот же DOM, другая подача                          */
    /* ════════════════════════════════════════════════════════════ */
    @media (min-width: 768px) {
      .hm-home-shell { padding-inline: var(--site-gutter-md); }

      .hm-home-hero { padding-block: 24px 0; }
      .hm-home-hero-frame { border-radius: 28px; box-shadow: none; }
      .hm-home-banner {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        align-items: center;
        gap: 24px;
        min-height: 360px;
        padding: 32px;
      }
      .hm-home-banner-text { gap: 14px; }
      .hm-home-banner-tag {
        padding: 6px 14px;
        background: rgba(255,255,255,0.85);
        color: var(--teal);
        font-size: 12px;
        letter-spacing: 0.02em;
      }
      .hm-home-banner-title { max-width: none; font-size: 36px; line-height: 1.05; letter-spacing: -0.03em; font-weight: 700; }
      .hm-home-banner-desc { max-width: 480px; font-size: 15px; color: var(--n-ink2); }
      .hm-home-banner-cta {
        height: 52px;
        margin-top: 14px;
        padding: 0 26px;
        font-size: 15px;
        font-weight: 600;
        transition: background 0.15s, transform 0.08s;
      }
      .hm-home-banner-cta:hover { background: var(--teal-hover); transform: translateY(-1px); }
      .hm-home-banner-art {
        position: static;
        width: auto;
        height: 100%;
        min-height: 240px;
        display: grid;
        place-items: center;
      }
      .hm-home-banner-art img { width: 100%; max-width: 360px; height: auto; }

      .hm-home-hero-dots { bottom: 20px; right: auto; left: 50%; transform: translateX(-50%); gap: 8px; }
      .hm-home-hero-dot { --dot: 8px; --dot-on: 28px; background: rgba(10,31,37,0.22); }

      .hm-home-find { padding-block: 40px; gap: 32px; }
      .hm-home-find-title { font-size: 32px; letter-spacing: -0.025em; }
      .hm-home-find-desc { margin-top: 16px; font-size: 16px; }
      .hm-home-live { margin-top: 30px; }
      .hm-home-avatar { width: 40px; height: 40px; margin-left: -12px; font-size: 13px; }
      .hm-home-avatar-more { font-size: 12px; }
      .hm-home-live-row { margin-top: 14px; font-size: 14px; }
      .hm-home-find-card { border-radius: 24px; }
      .hm-home-find-row { gap: 14px; padding: 16px 20px; }
      .hm-home-find-submit { margin: 16px; width: calc(100% - 32px); height: 56px; border-radius: 16px; font-size: 16px; }

      .hm-home-section { padding-bottom: 48px; }
      .hm-home-specs { margin-top: 40px; padding-top: 40px; border-top: 1px solid var(--n-line-soft); }
      .hm-home-section-head { align-items: flex-end; gap: 24px; margin-bottom: 32px; }
      .hm-home-section-head h2 { font-size: 26px; font-weight: 700; letter-spacing: -0.02em; }
      .hm-home-section-head p { margin-top: 8px; font-size: 15px; }
      .hm-home-section-link { font-size: 14px; font-weight: 600; }
      .hm-home-section-link:hover { color: var(--teal-hover); }

      .hm-home-spec-grid { grid-template-columns: repeat(4, 1fr); gap: 12px; }
      .hm-home-spec {
        min-height: 130px;
        padding: 18px;
        border-radius: 18px;
        gap: 12px;
        transition: transform 0.15s, box-shadow 0.2s;
      }
      .hm-home-spec-glyph { width: 56px; height: 56px; border-radius: 14px; }
      .hm-home-spec-glyph svg { width: 30px; height: 30px; }
      .hm-home-spec-name { font-size: 16px; }
      .hm-home-spec-count { font-size: 12.5px; }
      /* Две самые населённые специальности идут первыми и крупными. Порядок
         задан здесь, а не в разметке: в общей сетке на телефоне плитки стоят
         в порядке каталога. */
      .hm-home-spec.is-featured {
        order: -1;
        grid-column: span 2;
        min-height: 170px;
        background: var(--tint-strong);
      }
      .hm-home-spec.is-featured .hm-home-spec-glyph { width: 64px; height: 64px; }
      .hm-home-spec.is-featured .hm-home-spec-glyph svg { width: 36px; height: 36px; }
      .hm-home-spec.is-featured .hm-home-spec-name { font-size: 22px; letter-spacing: -0.01em; }

      /* Отрицательное поле здесь — под подъём карточки при наведении, чтобы
         тень не срезалась краем ленты. */
      .hm-home-rail { gap: 16px; scroll-padding: 0; margin-inline: -4px; padding: 4px 4px 8px; }
      .hm-home-doc {
        flex-basis: 280px;
        gap: 14px;
        padding: 20px;
        transition: transform 0.15s, box-shadow 0.2s, border-color 0.15s;
      }
      .hm-home-doc-avatar { width: 56px; height: 56px; font-size: 16px; }
      .hm-home-doc-name { font-size: 15px; }
      .hm-home-doc-spec { font-size: 13px; }
      .hm-home-doc-place { font-size: 13px; }
      .hm-home-doc-price { font-size: 12px; }
      .hm-home-doc-price strong { margin-left: 4px; font-size: 15px; }
      .hm-home-doc-book { padding: 9px 16px; font-size: 13px; }
    }

    /* Подъём при наведении — только там, где есть курсор: на тач-экране его
       нечем отменить, и он остаётся висеть после касания, конфликтуя с .tap. */
    @media (min-width: 768px) and (hover: hover) {
      .hm-home-spec:hover { transform: translateY(-2px); box-shadow: 0 12px 28px rgba(10,31,37,0.08); }
      .hm-home-doc:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(10,31,37,0.08);
        border-color: var(--teal);
      }
    }

    @media (min-width: 1024px) {
      .hm-home-shell { padding-inline: var(--site-gutter); }

      .hm-home-banner { grid-template-columns: 1.4fr 1fr; gap: 40px; min-height: 444px; padding: 44px 56px; }
      .hm-home-banner-title { font-size: 48px; }
      .hm-home-banner-desc { font-size: 16px; }

      .hm-home-find {
        grid-template-columns: 5fr 7fr;
        align-items: center;
        gap: 56px;
        padding-block: 56px;
      }
      .hm-home-find-title { font-size: 44px; }
      .hm-home-find-desc { margin-top: 18px; font-size: 17px; }

      .hm-home-section-head h2 { font-size: 32px; }
      .hm-home-spec-grid { grid-template-columns: repeat(6, 1fr); }
      .hm-home-spec { min-height: 140px; padding: 24px; }
      .hm-home-spec.is-featured { grid-column: span 3; min-height: 200px; }
    }
  </style>

  <LoginModal />

  <script>
    import { watchAvatars } from "../lib/avatar";

    watchAvatars();
  </script>
</BaseLayout>
