        padding: 7px 14px; border-radius: 999px;
        background: #fff; border: 1px solid var(--n-line);
        font-size: 13px; color: var(--n-ink); font-weight: 600;
        cursor: pointer;
      }
      .dw-search-submit-wide {
        margin: 16px; width: calc(100% - 32px); height: 56px; padding: 0 24px;
        background: var(--teal); color: #fff; border: none;
        border-radius: 16px;
        font-family: inherit; font-weight: 600; font-size: 16px;
        cursor: pointer;
        display: inline-flex; align-items: center; justify-content: center; gap: 10px;
