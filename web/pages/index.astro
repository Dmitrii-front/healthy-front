      .dw-spec-count { font-size: 12.5px; color: var(--n-muted); }

      /* ── Services bento ────────────────────── */
      .dw-services-bento {
        display: grid;
        grid-template-columns: 1.6fr 1fr;
        grid-template-rows: 1fr 1fr;
        gap: 16px;
        min-height: 380px;
      }
      .dw-service-card {
        display: flex; flex-direction: column; justify-content: space-between;
        padding: 24px 26px; gap: 16px;
        border-radius: 24px;
        text-decoration: none; color: var(--n-ink);
        position: relative; overflow: hidden;
        transition: transform .15s, box-shadow .2s;
      }
      .dw-service-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(10,31,37,0.08);
      }
      .dw-service-hero {
        grid-column: 1; grid-row: 1 / 3;
        padding: 36px 36px 32px; gap: 32px;
      }
      .dw-service-icon { color: #0A1F25; }
      .dw-service-body h3 {
        margin: 0; font-size: 20px; font-weight: 700;
        letter-spacing: -0.02em; line-height: 1.05;
      }
      .dw-service-hero .dw-service-body h3 { font-size: 32px; }
      .dw-service-body p {
        margin: 10px 0 18px;
        font-size: 13px; color: #2A2D33; line-height: 1.5;
      }
      .dw-service-hero .dw-service-body p { font-size: 15px; max-width: 320px; }
      .dw-service-meta {
        display: flex; justify-content: space-between; align-items: center; gap: 12px;
      }
      .dw-service-count {
        font-size: 12px; color: var(--n-muted); font-weight: 500;
      }
      .dw-service-hero .dw-service-count { font-size: 13px; }
      .dw-service-more {
        display: inline-flex; align-items: center; gap: 6px;
        font-size: 13px; font-weight: 600; color: var(--teal);
      }
      .dw-service-hero .dw-service-more { font-size: 14px; }

      /* ── Tags (online / offline) ───────────── */
      .dw-tag {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 6px 12px; border-radius: 999px;
        font-size: 12px; font-weight: 700;
        letter-spacing: 0.02em; text-transform: uppercase;
        margin-bottom: 12px;
      }
      .dw-tag-online {
        background: var(--teal-softer); color: var(--teal);
        border: 1px solid rgba(14,124,140,0.13);
      }
      .dw-tag-offline {
        background: #F6EFE2; color: #7A5A2E;
      }
      .dw-live-dot {
        width: 8px; height: 8px; border-radius: 50%;
        background: #FF4D4F; display: inline-block;
        animation: dwLiveDotPulse 1.6s ease-out infinite;
      }
      @keyframes dwLiveDotPulse {
        0% { box-shadow: 0 0 0 0 rgba(255,77,79,0.6); }
        70% { box-shadow: 0 0 0 10px rgba(255,77,79,0); }
        100% { box-shadow: 0 0 0 0 rgba(255,77,79,0); }
      }
      .dw-text-link {
        font-size: 14px; color: var(--n-ink);
        text-decoration: underline; text-underline-offset: 4px;
        font-weight: 500; white-space: nowrap;
      }

      /* ── Online doctors (cream card + aurora) ─ */
      .dw-online-section { max-width: 1440px; margin: 0 auto; padding: 32px 64px 16px; }
      .dw-online-card {
        position: relative; overflow: hidden;
        background: #FAF6EE;
        border-radius: 24px; padding: 40px 40px 44px;
      }
      .dw-aurora {
        position: absolute; inset: 0; pointer-events: none;
        border-radius: 24px; overflow: hidden;
      }
      .dw-aurora::before, .dw-aurora::after, .dw-aurora > span {
        content: ""; position: absolute; border-radius: 50%;
        filter: blur(60px); will-change: transform;
      }
      .dw-aurora::before {
        width: 540px; height: 540px; background: #5FB4C3; opacity: 0.45;
        top: -120px; left: -80px;
        animation: dwDrift1 22s ease-in-out infinite alternate;
      }
      .dw-aurora::after {
        width: 460px; height: 460px; background: #E8B96A; opacity: 0.45;
        bottom: -160px; right: -60px;
        animation: dwDrift2 26s ease-in-out infinite alternate;
      }
      .dw-aurora > span {
        width: 380px; height: 380px; background: #B5DDC7; opacity: 0.35;
        top: 30%; left: 40%;
        animation: dwDrift3 30s ease-in-out infinite alternate;
      }
      @keyframes dwDrift1 { from { transform: translate(0,0) scale(1); } to { transform: translate(140px,80px) scale(1.10); } }
      @keyframes dwDrift2 { from { transform: translate(0,0) scale(1); } to { transform: translate(-180px,-60px) scale(0.95); } }
      @keyframes dwDrift3 { from { transform: translate(0,0) scale(1); } to { transform: translate(-120px,100px) scale(1.15); } }

      .dw-online-head {
        position: relative;
        display: flex; justify-content: space-between; align-items: flex-end;
        gap: 24px; margin-bottom: 28px;
      }
      .dw-online-head h2 {
        margin: 0; font-size: 32px; font-weight: 700;
        letter-spacing: -0.02em; color: var(--n-ink);
      }
      .dw-online-head p {
        margin: 8px 0 0; font-size: 15px; color: var(--n-muted);
      }
      .dw-online-grid {
        position: relative;
        display: grid; grid-template-columns: 1.5fr 1fr 1fr 1fr; gap: 16px;
      }

      /* ── Offline doctors ────────────────────── */
      .dw-offline-section { max-width: 1440px; margin: 0 auto; padding: 32px 64px; }
      .dw-offline-grid {
        display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px;
      }

      /* ── Carousel (horizontal scroll snap) ───── */
      .dw-carousel { position: relative; }
      .dw-carousel-track {
        display: grid; grid-auto-flow: column; grid-auto-columns: 280px;
        gap: 16px; overflow-x: auto; overflow-y: visible;
        scroll-snap-type: x mandatory;
        scroll-behavior: smooth;
        scrollbar-width: none;
        padding: 4px 4px 8px;
        margin: -4px -4px -8px;
      }
      .dw-carousel-track::-webkit-scrollbar { display: none; }
      .dw-doctor-slide { scroll-snap-align: start; min-width: 0; }

      /* ── Doctor card (shared) ───────────────── */
      .dw-doctor {
        background: #fff;
        border: 1px solid var(--n-line);
        border-radius: 18px;
        padding: 20px;
        display: flex; flex-direction: column; gap: 14px;
        text-decoration: none; color: var(--n-ink);
        transition: transform .15s, box-shadow .2s, border-color .15s;
      }
      .dw-doctor:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 28px rgba(10,31,37,0.08);
        border-color: var(--teal);
      }
      .dw-doctor-head { display: flex; align-items: center; gap: 12px; }
      .dw-doctor-avatar-wrap { position: relative; }
      .dw-doctor-avatar {
        width: 56px; height: 56px; border-radius: 28px;
        display: inline-flex; align-items: center; justify-content: center;
        font-size: 16px; font-weight: 700; color: var(--n-ink);
        flex-shrink: 0;
      }
      .dw-doctor-avatar-img {
        object-fit: cover; background-color: var(--n-line);
      }
      .dw-doctor-head-body { min-width: 0; flex: 1; }
      .dw-doctor-online-dot {
        position: absolute; right: -1px; bottom: -1px;
        width: 14px; height: 14px; border-radius: 8px;
        background: #22C55E; border: 2px solid #fff;
      }
      .dw-doctor-name {
        display: block;
        font-size: 15px; font-weight: 700; line-height: 1.2;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }
      .dw-doctor-spec {
        display: block;
        font-size: 13px; color: var(--n-muted); margin-top: 4px;
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }
      .dw-doctor-meta {
        display: flex; align-items: center; gap: 8px; font-size: 13px; flex-wrap: wrap;
      }
      .dw-doctor-rating {
        display: inline-flex; align-items: center; gap: 4px; font-weight: 600;
      }
      .dw-doctor-muted { color: var(--n-muted); }
      .dw-doctor-clinic {
        font-size: 13px; color: var(--n-muted);
        white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      }
      .dw-doctor-cta-row {
        display: flex; justify-content: space-between; align-items: center;
        margin-top: auto;
      }
      .dw-doctor-price { font-size: 12px; color: var(--n-muted); }
      .dw-doctor-price strong { color: var(--n-ink); font-size: 15px; font-weight: 800; margin-left: 4px; }
      .dw-doctor-book {
        padding: 9px 16px; border-radius: 999px;
        background: var(--teal); color: #fff;
        font-size: 13px; font-weight: 700;
      }

      /* ── App banner ─────────────────────────── */
      .dw-app-section { max-width: 1440px; margin: 0 auto; padding: 32px 64px 56px; }
      .dw-app-banner {
        background: linear-gradient(120deg, #0A1F25 0%, var(--teal) 100%);
        border-radius: 24px; padding: 56px 64px;
        position: relative; overflow: hidden;
        color: #fff;
        display: grid; grid-template-columns: 1.4fr 1fr;
        gap: 56px; align-items: center;
        min-height: 320px;
      }
      .dw-app-glow {
        position: absolute; inset: 0; pointer-events: none;
        background: radial-gradient(60% 80% at 90% 50%, rgba(255,255,255,0.18), transparent 60%);
      }
      .dw-app-content { position: relative; z-index: 1; }
      .dw-app-tag {
        display: inline-block; padding: 6px 14px; border-radius: 999px;
        background: rgba(255,255,255,0.18); color: #fff;
        font-size: 12px; font-weight: 700;
        letter-spacing: 0.02em; text-transform: uppercase;
      }
      .dw-app-title {
        margin: 20px 0 14px;
        font-size: 44px; line-height: 1.05; letter-spacing: -0.03em;
        font-weight: 700; color: #fff;
      }
      .dw-app-desc {
        margin: 0; font-size: 16px; line-height: 1.5;
        color: rgba(255,255,255,0.8); max-width: 460px;
      }
      .dw-app-buttons { margin-top: 28px; display: flex; gap: 12px; flex-wrap: wrap; }
      .dw-store-btn {
        display: inline-flex; align-items: center; gap: 12px;
        padding: 12px 20px;
        background: #000; color: #fff;
        border-radius: 16px; text-decoration: none;
        min-width: 180px;
        transition: transform .12s;
      }
      .dw-store-btn:hover { transform: translateY(-1px); }
      .dw-store-btn span { display: flex; flex-direction: column; line-height: 1.1; }
      .dw-store-small { font-size: 11px; opacity: 0.8; }
      .dw-store-big { font-size: 17px; font-weight: 600; }
      .dw-app-art { position: relative; z-index: 1; }

      /* ── Desktop footer ─────────────────────── */
      .dw-footer {
        background: #0A1F25; color: rgba(255,255,255,0.7);
        padding: 64px 0 32px;
      }
      .dw-footer-inner { max-width: 1440px; margin: 0 auto; padding: 0 64px; }
      .dw-footer-grid {
        display: grid; grid-template-columns: 1.5fr repeat(4, 1fr);
        gap: 48px;
      }
      .dw-footer-brand p {
        font-size: 13px; line-height: 1.6; margin: 16px 0 0; max-width: 280px;
      }
      .dw-footer-col { display: flex; flex-direction: column; gap: 10px; }
      .dw-footer-title {
        color: #fff; font-size: 13px; font-weight: 600; margin-bottom: 6px;
      }
      .dw-footer-col a {
        font-size: 13px; color: rgba(255,255,255,0.7);
        text-decoration: none; transition: color .15s;
      }
      .dw-footer-col a:hover { color: #fff; }
      .dw-footer-bottom {
        border-top: 1px solid rgba(255,255,255,0.1);
        margin-top: 48px; padding-top: 24px;
        display: flex; justify-content: space-between;
        font-size: 12px;
      }
    }

    @media (max-width: 767.98px) {
      .dw-page { display: none !important; }
    }

    /* ── Tablet & narrow desktop (768–1023) ─────────────────── */
    @media (min-width: 768px) and (max-width: 1023.98px) {
      .dw-header-inner,
      .dw-hero-section,
      .dw-search-hero,
      .dw-section,
      .dw-online-section,
      .dw-offline-section,
      .dw-footer-inner {
        padding-left: clamp(20px, 4vw, 40px);
        padding-right: clamp(20px, 4vw, 40px);
      }
      .dw-section { padding-top: 32px; padding-bottom: 32px; }
      .dw-search-hero { padding-top: 36px; padding-bottom: 36px; }
      .dw-online-section,
      .dw-offline-section { padding-top: 24px; padding-bottom: 24px; }
      .dw-footer { padding: 48px 0 24px; }

      /* Header — tighter nav, hide some links to avoid overflow */
      .dw-header-left { gap: 24px; }
      .dw-nav { gap: 20px; }
      .dw-nav a:nth-child(n+3) { display: none; }

      /* Hero — shorter min-height, smaller title, art is decorative */
      .dw-banner {
        padding: 32px 32px;
        min-height: 360px;
        grid-template-columns: 1.5fr 1fr;
        gap: 24px;
      }
      .dw-banner-title { font-size: 36px; }
      .dw-banner-desc { font-size: 15px; }
      .dw-banner-art > svg { width: 220px; height: 220px; }

      /* Search hero — stack promise + form vertically; card grows full width */
      .dw-search-hero-inner {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .dw-search-promise h2 { font-size: 32px; }
      .dw-search-card-wrap { width: 100%; }

      /* Specialty grid — 3 cols, large takes a full row */
      .dw-specs-grid { grid-template-columns: repeat(3, 1fr); gap: 12px; }
      .dw-spec-card.is-large { grid-column: span 3; min-height: 140px; }
      .dw-spec-card { min-height: 130px; padding: 18px; }
      .dw-section-head h2 { font-size: 26px; }

      /* Online doctors card — tighter inset, smaller heading */
      .dw-online-card { padding: 28px 24px 32px; }
      .dw-online-head { flex-wrap: wrap; gap: 16px; }
      .dw-online-head h2 { font-size: 26px; }

      /* Services bento — fall to 1 column at the narrower end */
      .dw-services-bento { grid-template-columns: 1fr; }
      .dw-service-hero { min-height: 220px; }

      /* Footer — collapse to 2 columns; brand spans full row */
      .dw-footer-grid {
        grid-template-columns: repeat(2, 1fr);
        gap: 32px 24px;
      }
      .dw-footer-brand { grid-column: 1 / -1; }
      .dw-footer-bottom { flex-direction: column; gap: 6px; }
    }
  </style>

  <script>
    // ── Sticky bg blur on scroll ─────────────────────────
    (() => {
      const topbar = document.getElementById("mw-topbar");
      const stickySearch = document.getElementById("mw-sticky-search");
      const onScroll = () => {
        const y = window.scrollY;
        topbar?.classList.toggle("is-scrolled", y > 8);
        stickySearch?.classList.toggle("is-scrolled", y > 240);
      };
      window.addEventListener("scroll", onScroll, { passive: true });
      onScroll();
    })();
  </script>

  <LoginModal />
</BaseLayout>
