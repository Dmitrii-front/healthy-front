---
import "@/styles/globals.css";

interface Props {
  title?: string;
}

const { title = "Healthy" } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#faf7f0" />
    <meta name="view-transition" content="same-origin" />
    <title>{title}</title>
    <meta name="robots" content="noindex,nofollow" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />

    {/* Prefetch popular SEO entry points so clicks from SPA → catalog
        feel instant. Browser caches the HTML in the background after the
        SPA shell hydrates. */}
    <link rel="prefetch" href="/search" />
    <link rel="prefetch" href="/specialty/cardiology" />
    <link rel="prefetch" href="/specialty/family-medicine" />
    <link rel="prefetch" href="/specialty/dentistry" />
  </head>
  <body class="bg-warm-paper text-graphite">
    <slot />
  </body>
</html>
