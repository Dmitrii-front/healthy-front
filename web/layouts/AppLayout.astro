---
import SiteFont from "../components/layout/SiteFont.astro";
import "@/styles/globals.css";

interface Props {
  title?: string;
}

const { title = "Healthy" } = Astro.props;
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#faf7f0" />
    <meta name="view-transition" content="same-origin" />
    <title>{title}</title>
    <meta name="robots" content="noindex,nofollow" />

    <SiteFont />

    {/* Prefetch the catalog so clicks from SPA → search feel instant.
        Specialty filtering is now a search-param on /search, so a single
        prefetch covers every category tile on the home page. */}
    <link rel="prefetch" href="/search" />
  </head>
  <body class="bg-warm-paper text-graphite">
    <slot />
  </body>
</html>
